#ifndef _MPLAPACK_CONFIG_H_
#define _MPLAPACK_CONFIG_H_

/* Public, MPLAPACK-specific configuration header.
 * Generated by configure from mplapack_config.h.in.
 * Do not put HAVE_* / PACKAGE_* macros here.
 */

#define MPLAPACK_VERSION "@PACKAGE_VERSION@"

/* Keep historical default: ILP64-ish integer type. */
#define USE64BITINT 1

#include <inttypes.h>
#include <stdlib.h>

#ifdef USE64BITINT
#if defined _WIN32
typedef long int mplapackint;
#elif defined __APPLE__
typedef long mplapackint;
#else
typedef int64_t mplapackint;
#endif
#endif

typedef mplapackint mplapacklogical;

#ifdef __cplusplus
typedef mplapacklogical (*LFP)(...);
#else
typedef mplapacklogical (*LFP)();
#endif

/* Floating-point ABI selection (generated by configure). */
@MPLAPACK_PUBLIC_DEFINE_WANT_LIBQUADMATH@
@MPLAPACK_PUBLIC_DEFINE_FLOAT128_IS_LONGDOUBLE@
@MPLAPACK_PUBLIC_DEFINE_FLOAT128_ONLY@
@MPLAPACK_PUBLIC_DEFINE_LONGDOUBLE_IS_BINARY128@

@MPLAPACK_PUBLIC_DEFINE_USE___FLOAT80@
@MPLAPACK_PUBLIC_DEFINE_FLOAT64X_IS_LONGDOUBLE@
@MPLAPACK_PUBLIC_DEFINE_HAVE_NATIVE_FLOAT64X@

#endif /* _MPLAPACK_CONFIG_H_ */
