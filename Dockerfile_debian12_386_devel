# * How to build (for public users - read-only access)
#  IMPORTANT: i386 userspace requires --platform=linux/386
#  docker buildx build --platform=linux/386 -f Dockerfile_debian12_devel -t mplapack:debian12-i386 .
#
# * How to build (for maintainers with SSH key - read-write access)
# IMPORTANT: i386 userspace requires --platform=linux/386
# DOCKER_BUILDKIT=1 docker buildx build --platform=linux/386 -f Dockerfile_debian12_devel --build-arg DOCKER_UID="$(id -u)" --build-arg DOCKER_GID="$(id -g)" --build-arg USE_SSH=true --build-arg SSH_KEY_NAME="${SSH_KEY_NAME:-id_ed25519}" --secret id=ssh_key,src="$HOME/.ssh/${SSH_KEY_NAME:-id_ed25519}" -t mplapack:debian12-i386 .
#
# * How to build with custom repository (for users with forks)
# IMPORTANT: i386 userspace requires --platform=linux/386
# DOCKER_BUILDKIT=1 docker buildx build --platform=linux/386 -f Dockerfile_debian12_devel --build-arg DOCKER_UID=$(id -u) --build-arg DOCKER_GID=$(id -g) --build-arg MPLAPACK_REPO=https://github.com/username/mplapack.git -t mplapack:debian12-i386 .
#
# * How to build with custom repository using SSH
# IMPORTANT: i386 userspace requires --platform=linux/386
# SSH_KEY_NAME=id_ed25519 DOCKER_BUILDKIT=1 docker buildx build --platform=linux/386 -f Dockerfile_debian12_devel --build-arg DOCKER_UID=$(id -u) --build-arg DOCKER_GID=$(id -g) --build-arg USE_SSH=true --build-arg SSH_KEY_NAME=${SSH_KEY_NAME} --build-arg MPLAPACK_REPO=https://github.com/<username>/mplapack.git --secret id=ssh_key,src=$HOME/.ssh/${SSH_KEY_NAME} -t mplapack:debian12-i386 .
#
# * How to run
# IMPORTANT: i386 userspace requires --platform=linux/386
#  docker run --platform=linux/386 -it --rm -v "$PWD":/work mplapack:debian12-i386 /bin/bash
#
# * How to run with SSH key for git operations (maintainers only)
#  eval $(ssh-agent); ssh-add ~/.ssh/id_ed25519; docker run --platform=linux/386 -v $SSH_AUTH_SOCK:/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent -it --rm mplapack:debian12-i386 /bin/bash
#
# Debian official image
FROM debian:12

#git setting
ARG GIT_EMAIL="maho.nakata@gmail.com"
ARG GIT_NAME="NAKATA Maho"
LABEL maintainer="maho.nakata@gmail.com"

# Build argument to choose between HTTPS (public) and SSH (maintainer)
ARG DOCKER_UID
ARG DOCKER_GID
ARG USE_SSH=false
ARG SSH_KEY_NAME

# Repository URLs - can be overridden to use forks
ARG MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git

# Validate required arguments for SSH mode
RUN if [ "$USE_SSH" = "true" ] && [ -z "$SSH_KEY_NAME" ]; then \
      echo "========================================"; \
      echo "ERROR: Maintainer mode requires SSH_KEY_NAME"; \
      echo "Usage: --build-arg SSH_KEY_NAME=id_ed25519"; \
      echo "========================================"; \
      exit 1; \
    fi

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get -y upgrade 
RUN apt-get install -y --no-install-recommends
RUN apt-get install -y build-essential python3 python3-pip gcc g++ gfortran
RUN apt-get install -y autotools-dev automake libtool libtool-bin universal-ctags gnuplot
RUN apt-get install -y gdb valgrind sudo
RUN apt-get install -y git wget gpg ccache time parallel bc
RUN apt-get install -y pkg-config clangd python3-autopep8 unifdef octave
RUN apt-get install -y ng-common ng-cjk emacs-nox
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

###################################################################################################
# Workaround: i386 userland on x86_64 kernel -> uname -m lies (x86_64).
# Avoid setarch/personality (often blocked by seccomp). Fake only "uname -m".
RUN set -eux; \
    if command -v dpkg >/dev/null 2>&1; then \
      if [ "$(dpkg --print-architecture)" = "i386" ] && [ "$(uname -m)" = "x86_64" ]; then \
        { \
          printf '%s\n' '#!/bin/sh'; \
          printf '%s\n' 'if [ "${1:-}" = "-m" ]; then'; \
          printf '%s\n' '  echo i686'; \
          printf '%s\n' '  exit 0'; \
          printf '%s\n' 'fi'; \
          printf '%s\n' 'exec /usr/bin/uname "$@"'; \
        } > /usr/local/bin/uname; \
        chmod +x /usr/local/bin/uname; \
      fi; \
    fi
###################################################################################################
# set your timezone
ENV TZ=Asia/Tokyo
RUN echo "${TZ}" > /etc/timezone \
  && rm -f /etc/localtime \
  && ln -s /usr/share/zoneinfo/Asia/Tokyo /etc/localtime \
  && dpkg-reconfigure -f noninteractive tzdata

# create non-root user without password and allow passwordless sudo
ARG DOCKER_UID=2000
ARG DOCKER_GID=2000
ARG DOCKER_USER=docker

RUN mkdir -p /etc/sudoers.d;

RUN set -eux; \
    existing="$(getent passwd ${DOCKER_UID} | cut -d: -f1 || true)"; \
    if [ -n "$existing" ]; then \
        usermod -l "${DOCKER_USER}" -d "/home/${DOCKER_USER}" -m "$existing"; \
        groupmod -n "${DOCKER_USER}" "$(id -gn ${DOCKER_UID})" 2>/dev/null || true; \
    else \
        groupadd -g "${DOCKER_GID}" "${DOCKER_USER}" 2>/dev/null || true; \
        useradd -u "${DOCKER_UID}" -g "${DOCKER_GID}" -m -s /bin/bash "${DOCKER_USER}"; \
    fi; \
    usermod -aG sudo "${DOCKER_USER}"; \
    echo "${DOCKER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/"${DOCKER_USER}"; \
    chmod 440 /etc/sudoers.d/"${DOCKER_USER}"

ARG WORK=/home/${DOCKER_USER}

USER ${DOCKER_USER}
WORKDIR ${WORK}

RUN printf "\n[user]\n        email = %s\n        name = %s\n" "${GIT_EMAIL}" "${GIT_NAME}" > /home/${DOCKER_USER}/.gitconfig

RUN printf "\nPROGRAM HELLO\nPRINT *, 'HELLO, WORLD!'\nEND PROGRAM\n" >> ${WORK}/sample.f
RUN echo "cd /home/${DOCKER_USER}" >> ${WORK}/.bashrc

### Git clone strategy: HTTPS (default) or SSH (with --build-arg USE_SSH=true) ###

# Prepare SSH environment if using SSH mode
RUN if [ "$USE_SSH" = "true" ]; then \
        mkdir -p /home/${DOCKER_USER}/.ssh && \
        chmod 0700 /home/${DOCKER_USER}/.ssh && \
        ssh-keyscan github.com > /home/${DOCKER_USER}/.ssh/known_hosts; \
    fi

# Clone repositories - HTTPS mode (default, public access)
RUN if [ "$USE_SSH" != "true" ]; then \
        echo "=== Cloning via HTTPS (public read-only mode) ===" && \
        echo "Repository: ${MPLAPACK_REPO}" && \
        cd ${WORK} && git clone ${MPLAPACK_REPO} && \
        cd ${WORK}/mplapack && git checkout release/2.1 && \
        cd ${WORK}/mplapack && git log -1; \
    fi

# Clone repositories - SSH mode (maintainer access, requires --secret)
RUN --mount=type=secret,id=ssh_key,uid=${DOCKER_UID} \
    if [ "$USE_SSH" = "true" ]; then \
        echo "=== Cloning via SSH (maintainer mode) ===" && \
        SSH_REPO=$(echo "${MPLAPACK_REPO}" | sed 's|https://github.com/|git@github.com:|') && \
        echo "Repository: ${SSH_REPO}" && \
        mkdir -p /home/${DOCKER_USER}/.ssh && \
        cp /run/secrets/ssh_key /home/${DOCKER_USER}/.ssh/${SSH_KEY_NAME} && \
        chmod 600 /home/${DOCKER_USER}/.ssh/${SSH_KEY_NAME} && \
        eval "$(ssh-agent -s)" && \
        ssh-add /home/${DOCKER_USER}/.ssh/${SSH_KEY_NAME} && \
        cd ${WORK} && git clone ${SSH_REPO} && \
        cd ${WORK}/mplapack && git checkout release/2.1 && \
        cd ${WORK}/mplapack && git log -1 && \
        rm -f /home/${DOCKER_USER}/.ssh/${SSH_KEY_NAME}; \
    fi

RUN cd ${WORK}/mplapack && bash -x misc/reconfig.ubuntu22.04.sh
