# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Rlamch_dump_mpfr.exe Rlamch_dump_gmp.exe Rlamch_dump_qd.exe Rlamch_dump_dd.exe Rlamch_dump_binary80.exe Rlamch_dump_binary128.exe Rlamch_dump_double.exe Frank_eigenvalues_mpfr.exe Frank_eigenvalues_gmp.exe Frank_eigenvalues_qd.exe Frank_eigenvalues_dd.exe Frank_eigenvalues_binary80.exe Frank_eigenvalues_binary128.exe Frank_eigenvalues_double.exe Gejsv_vs_gesvd_mpfr.exe Gejsv_vs_gesvd_gmp.exe Gejsv_vs_gesvd_qd.exe Gejsv_vs_gesvd_dd.exe Gejsv_vs_gesvd_binary80.exe Gejsv_vs_gesvd_binary128.exe Gejsv_vs_gesvd_double.exe Hilbert_inverse_mpfr.exe Hilbert_inverse_gmp.exe Hilbert_inverse_qd.exe Hilbert_inverse_dd.exe Hilbert_inverse_binary80.exe Hilbert_inverse_binary128.exe Hilbert_inverse_double.exe Hilbert_linear_solve_mpfr.exe Hilbert_linear_solve_gmp.exe Hilbert_linear_solve_qd.exe Hilbert_linear_solve_dd.exe Hilbert_linear_solve_binary80.exe Hilbert_linear_solve_binary128.exe Hilbert_linear_solve_double.exe Kahan_rank_reveal_mpfr.exe Kahan_rank_reveal_gmp.exe Kahan_rank_reveal_qd.exe Kahan_rank_reveal_dd.exe Kahan_rank_reveal_binary80.exe Kahan_rank_reveal_binary128.exe Kahan_rank_reveal_double.exe Pascal_inverse_mpfr.exe Pascal_inverse_gmp.exe Pascal_inverse_qd.exe Pascal_inverse_dd.exe Pascal_inverse_binary80.exe Pascal_inverse_binary128.exe Pascal_inverse_double.exe Vandermonde_solve_mpfr.exe Vandermonde_solve_gmp.exe Vandermonde_solve_qd.exe Vandermonde_solve_dd.exe Vandermonde_solve_binary80.exe Vandermonde_solve_binary128.exe Vandermonde_solve_double.exe Wilkinson_roots_mpfr.exe Wilkinson_roots_gmp.exe Wilkinson_roots_qd.exe Wilkinson_roots_dd.exe Wilkinson_roots_binary80.exe Wilkinson_roots_binary128.exe Wilkinson_roots_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rlamch_dump_mpfr.exe: Rlamch_dump_mpfr.o
	$(CXX) -o Rlamch_dump_mpfr.exe Rlamch_dump_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rlamch_dump_gmp.exe: Rlamch_dump_gmp.o
	$(CXX) -o Rlamch_dump_gmp.exe Rlamch_dump_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rlamch_dump_qd.exe: Rlamch_dump_qd.o
	$(CXX) -o Rlamch_dump_qd.exe Rlamch_dump_qd.o $(LIBFLAGS) $(QDLIBS)

Rlamch_dump_dd.exe: Rlamch_dump_dd.o
	$(CXX) -o Rlamch_dump_dd.exe Rlamch_dump_dd.o $(LIBFLAGS) $(DDLIBS)

Rlamch_dump_binary80.exe: Rlamch_dump_binary80.o
	$(CXX) -o Rlamch_dump_binary80 Rlamch_dump_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rlamch_dump_binary128.exe: Rlamch_dump_binary128.o
	$(CXX) -o Rlamch_dump_binary128 Rlamch_dump_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rlamch_dump_double.exe: Rlamch_dump_double.o
	$(CXX) -o Rlamch_dump_double Rlamch_dump_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

