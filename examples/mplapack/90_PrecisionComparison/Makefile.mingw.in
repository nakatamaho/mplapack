# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Hilbert_inverse_mpfr.exe Hilbert_inverse_gmp.exe Hilbert_inverse_qd.exe Hilbert_inverse_dd.exe Hilbert_inverse_binary80.exe Hilbert_inverse_binary128.exe Hilbert_inverse_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Hilbert_inverse_mpfr.exe: Hilbert_inverse_mpfr.o
	$(CXX) -o Hilbert_inverse_mpfr.exe Hilbert_inverse_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Hilbert_inverse_gmp.exe: Hilbert_inverse_gmp.o
	$(CXX) -o Hilbert_inverse_gmp.exe Hilbert_inverse_gmp.o $(LIBFLAGS) $(GMPLIBS)

Hilbert_inverse_qd.exe: Hilbert_inverse_qd.o
	$(CXX) -o Hilbert_inverse_qd.exe Hilbert_inverse_qd.o $(LIBFLAGS) $(QDLIBS)

Hilbert_inverse_dd.exe: Hilbert_inverse_dd.o
	$(CXX) -o Hilbert_inverse_dd.exe Hilbert_inverse_dd.o $(LIBFLAGS) $(DDLIBS)

Hilbert_inverse_binary80.exe: Hilbert_inverse_binary80.o
	$(CXX) -o Hilbert_inverse_binary80 Hilbert_inverse_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Hilbert_inverse_binary128.exe: Hilbert_inverse_binary128.o
	$(CXX) -o Hilbert_inverse_binary128 Hilbert_inverse_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Hilbert_inverse_double.exe: Hilbert_inverse_double.o
	$(CXX) -o Hilbert_inverse_double Hilbert_inverse_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
