# public domain

CXX=g++-mp-14
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=-framework vecLib

programs=Rlamch_dump_mpfr Rlamch_dump_gmp Rlamch_dump_qd Rlamch_dump_dd Rlamch_dump_binary80 Rlamch_dump_binary128 Rlamch_dump_double Frank_eigenvalues_mpfr Frank_eigenvalues_gmp Frank_eigenvalues_qd Frank_eigenvalues_dd Frank_eigenvalues_binary80 Frank_eigenvalues_binary128 Frank_eigenvalues_double Gejsv_vs_gesvd_mpfr Gejsv_vs_gesvd_gmp Gejsv_vs_gesvd_qd Gejsv_vs_gesvd_dd Gejsv_vs_gesvd_binary80 Gejsv_vs_gesvd_binary128 Gejsv_vs_gesvd_double Hilbert_inverse_mpfr Hilbert_inverse_gmp Hilbert_inverse_qd Hilbert_inverse_dd Hilbert_inverse_binary80 Hilbert_inverse_binary128 Hilbert_inverse_double Hilbert_linear_solve_mpfr Hilbert_linear_solve_gmp Hilbert_linear_solve_qd Hilbert_linear_solve_dd Hilbert_linear_solve_binary80 Hilbert_linear_solve_binary128 Hilbert_linear_solve_double Kahan_rank_reveal_mpfr Kahan_rank_reveal_gmp Kahan_rank_reveal_qd Kahan_rank_reveal_dd Kahan_rank_reveal_binary80 Kahan_rank_reveal_binary128 Kahan_rank_reveal_double Pascal_inverse_mpfr Pascal_inverse_gmp Pascal_inverse_qd Pascal_inverse_dd Pascal_inverse_binary80 Pascal_inverse_binary128 Pascal_inverse_double Vandermonde_solve_mpfr Vandermonde_solve_gmp Vandermonde_solve_qd Vandermonde_solve_dd Vandermonde_solve_binary80 Vandermonde_solve_binary128 Vandermonde_solve_double Wilkinson_roots_mpfr Wilkinson_roots_gmp Wilkinson_roots_qd Wilkinson_roots_dd Wilkinson_roots_binary80 Wilkinson_roots_binary128 Wilkinson_roots_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rlamch_dump_mpfr: Rlamch_dump_mpfr.o
	$(CXX) -o Rlamch_dump_mpfr Rlamch_dump_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rlamch_dump_gmp: Rlamch_dump_gmp.o
	$(CXX) -o Rlamch_dump_gmp Rlamch_dump_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rlamch_dump_qd: Rlamch_dump_qd.o
	$(CXX) -o Rlamch_dump_qd Rlamch_dump_qd.o $(LIBFLAGS) $(QDLIBS)

Rlamch_dump_dd: Rlamch_dump_dd.o
	$(CXX) -o Rlamch_dump_dd Rlamch_dump_dd.o $(LIBFLAGS) $(DDLIBS)

Rlamch_dump_binary80: Rlamch_dump_binary80.o
	$(CXX) -o Rlamch_dump_binary80 Rlamch_dump_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rlamch_dump_binary128: Rlamch_dump_binary128.o
	$(CXX) -o Rlamch_dump_binary128 Rlamch_dump_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rlamch_dump_double: Rlamch_dump_double.o
	$(CXX) -o Rlamch_dump_double Rlamch_dump_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

