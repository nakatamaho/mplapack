# public domain

CXX=g++-mp-14
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=-framework vecLib

programs=Frank_eigenvalues_mpfr Frank_eigenvalues_gmp Frank_eigenvalues_qd Frank_eigenvalues_dd Frank_eigenvalues_binary80 Frank_eigenvalues_binary128 Frank_eigenvalues_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Frank_eigenvalues_mpfr: Frank_eigenvalues_mpfr.o
	$(CXX) -o Frank_eigenvalues_mpfr Frank_eigenvalues_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Frank_eigenvalues_gmp: Frank_eigenvalues_gmp.o
	$(CXX) -o Frank_eigenvalues_gmp Frank_eigenvalues_gmp.o $(LIBFLAGS) $(GMPLIBS)

Frank_eigenvalues_qd: Frank_eigenvalues_qd.o
	$(CXX) -o Frank_eigenvalues_qd Frank_eigenvalues_qd.o $(LIBFLAGS) $(QDLIBS)

Frank_eigenvalues_dd: Frank_eigenvalues_dd.o
	$(CXX) -o Frank_eigenvalues_dd Frank_eigenvalues_dd.o $(LIBFLAGS) $(DDLIBS)

Frank_eigenvalues_binary80: Frank_eigenvalues_binary80.o
	$(CXX) -o Frank_eigenvalues_binary80 Frank_eigenvalues_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Frank_eigenvalues_binary128: Frank_eigenvalues_binary128.o
	$(CXX) -o Frank_eigenvalues_binary128 Frank_eigenvalues_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Frank_eigenvalues_double: Frank_eigenvalues_double.o
	$(CXX) -o Frank_eigenvalues_double Frank_eigenvalues_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
