# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=icpx
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd %%QUADMATH_CPPFLAGS%%
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -qopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib %%QUADMATH_LDFLAGS%% -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Chegv_example_mpfr Chegv_example_gmp Chegv_example_qd Chegv_example_dd Chegv_example_binary80 Chegv_example_binary128 Chegv_example_double Rsygv_example_mpfr Rsygv_example_gmp Rsygv_example_qd Rsygv_example_dd Rsygv_example_binary80 Rsygv_example_binary128 Rsygv_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rsygv_example_mpfr: Rsygv_example_mpfr.o
	$(CXX) -o Rsygv_example_mpfr Rsygv_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rsygv_example_gmp: Rsygv_example_gmp.o
	$(CXX) -o Rsygv_example_gmp Rsygv_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rsygv_example_qd: Rsygv_example_qd.o
	$(CXX) -o Rsygv_example_qd Rsygv_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rsygv_example_dd: Rsygv_example_dd.o
	$(CXX) -o Rsygv_example_dd Rsygv_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rsygv_example_binary80: Rsygv_example_binary80.o
	$(CXX) -o Rsygv_example_binary80 Rsygv_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rsygv_example_binary128: Rsygv_example_binary128.o
	$(CXX) -o Rsygv_example_binary128 Rsygv_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rsygv_example_double: Rsygv_example_double.o
	$(CXX) -o Rsygv_example_double Rsygv_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Chegv_example_mpfr: Chegv_example_mpfr.o
	$(CXX) -o Chegv_example_mpfr Chegv_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Chegv_example_gmp: Chegv_example_gmp.o
	$(CXX) -o Chegv_example_gmp Chegv_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Chegv_example_qd: Chegv_example_qd.o
	$(CXX) -o Chegv_example_qd Chegv_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Chegv_example_dd: Chegv_example_dd.o
	$(CXX) -o Chegv_example_dd Chegv_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Chegv_example_binary80: Chegv_example_binary80.o
	$(CXX) -o Chegv_example_binary80 Chegv_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Chegv_example_binary128: Chegv_example_binary128.o
	$(CXX) -o Chegv_example_binary128 Chegv_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Chegv_example_double: Chegv_example_double.o
	$(CXX) -o Chegv_example_double Chegv_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)
