# public domain

CXX=g++-mp-14
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=-framework vecLib

programs=%%ROUTINE%%_mpfr %%ROUTINE%%_gmp %%ROUTINE%%_qd %%ROUTINE%%_dd %%ROUTINE%%_binary80 %%ROUTINE%%_binary128 %%ROUTINE%%_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

%%ROUTINE%%_mpfr: %%ROUTINE%%_mpfr.o
	$(CXX) -o %%ROUTINE%%_mpfr %%ROUTINE%%_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

%%ROUTINE%%_gmp: %%ROUTINE%%_gmp.o
	$(CXX) -o %%ROUTINE%%_gmp %%ROUTINE%%_gmp.o $(LIBFLAGS) $(GMPLIBS)

%%ROUTINE%%_qd: %%ROUTINE%%_qd.o
	$(CXX) -o %%ROUTINE%%_qd %%ROUTINE%%_qd.o $(LIBFLAGS) $(QDLIBS)

%%ROUTINE%%_dd: %%ROUTINE%%_dd.o
	$(CXX) -o %%ROUTINE%%_dd %%ROUTINE%%_dd.o $(LIBFLAGS) $(DDLIBS)

%%ROUTINE%%_binary80: %%ROUTINE%%_binary80.o
	$(CXX) -o %%ROUTINE%%_binary80 %%ROUTINE%%_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

%%ROUTINE%%_binary128: %%ROUTINE%%_binary128.o
	$(CXX) -o %%ROUTINE%%_binary128 %%ROUTINE%%_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

%%ROUTINE%%_double: %%ROUTINE%%_double.o
	$(CXX) -o %%ROUTINE%%_double %%ROUTINE%%_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
