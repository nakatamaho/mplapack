# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpblas_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lmpblas_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lmpblas_qd -lqd
DDLIBS=-lmplapack_dd -lmpblas_dd -lqd
BINARY80LIBS=-lmplapack_binary80 -lmpblas_binary80
BINARY128LIBS=-lmplapack_binary128 -lmpblas_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double -lmpblas_double
BLAS=
LAPACK=
FLIBS=

programs=%%ROUTINE%%_mpfr %%ROUTINE%%_gmp %%ROUTINE%%_qd %%ROUTINE%%_dd %%ROUTINE%%_binary80 %%ROUTINE%%_binary128 %%ROUTINE%%_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

%%ROUTINE%%_mpfr: %%ROUTINE%%_mpfr.o
	$(CXX) -o %%ROUTINE%%_mpfr %%ROUTINE%%_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

%%ROUTINE%%_gmp: %%ROUTINE%%_gmp.o
	$(CXX) -o %%ROUTINE%%_gmp %%ROUTINE%%_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

%%ROUTINE%%_qd: %%ROUTINE%%_qd.o
	$(CXX) -o %%ROUTINE%%_qd %%ROUTINE%%_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

%%ROUTINE%%_dd: %%ROUTINE%%_dd.o
	$(CXX) -o %%ROUTINE%%_dd %%ROUTINE%%_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

%%ROUTINE%%_binary80: %%ROUTINE%%_binary80.o
	$(CXX) -o %%ROUTINE%%_binary80 %%ROUTINE%%_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

%%ROUTINE%%_binary128: %%ROUTINE%%_binary128.o
	$(CXX) -o %%ROUTINE%%_binary128 %%ROUTINE%%_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

%%ROUTINE%%_double: %%ROUTINE%%_double.o
	$(CXX) -o %%ROUTINE%%_double %%ROUTINE%%_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
