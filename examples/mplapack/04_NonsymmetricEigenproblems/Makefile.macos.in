# public domain

CXX=g++-mp-14
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=-framework vecLib

programs=Cgees_test_mpfr Cgees_test_gmp Cgees_test_qd Cgees_test_dd Cgees_test_binary80 Cgees_test_binary128 Cgees_test_double Cgeev_NPR_mpfr Cgeev_NPR_qd Cgeev_NPR_dd Cgeev_NPR_binary80 Cgeev_NPR_binary128 Cgeev_NPR_double Cgeev_test2_mpfr Cgeev_test2_gmp Cgeev_test2_qd Cgeev_test2_dd Cgeev_test2_binary80 Cgeev_test2_binary128 Cgeev_test2_double Cgeev_test_mpfr Cgeev_test_gmp Cgeev_test_qd Cgeev_test_dd Cgeev_test_binary80 Cgeev_test_binary128 Cgeev_test_double Rgees_Grcar_mpfr Rgees_Grcar_gmp Rgees_Grcar_qd Rgees_Grcar_dd Rgees_Grcar_binary80 Rgees_Grcar_binary128 Rgees_Grcar_double Rgees_readfromfile_mpfr Rgees_readfromfile_gmp Rgees_readfromfile_qd Rgees_readfromfile_dd Rgees_readfromfile_binary80 Rgees_readfromfile_binary128 Rgees_readfromfile_double Rgees_test_mpfr Rgees_test_gmp Rgees_test_qd Rgees_test_dd Rgees_test_binary80 Rgees_test_binary128 Rgees_test_double Rgeev_Frank_mpfr Rgeev_Frank_gmp Rgeev_Frank_qd Rgeev_Frank_dd Rgeev_Frank_binary80 Rgeev_Frank_binary128 Rgeev_Frank_double Rgeev_random_highcond_mpfr Rgeev_random_highcond_gmp Rgeev_random_highcond_qd Rgeev_random_highcond_dd Rgeev_random_highcond_binary80 Rgeev_random_highcond_binary128 Rgeev_random_highcond_double Rgeev_readfromfile_mpfr Rgeev_readfromfile_gmp Rgeev_readfromfile_qd Rgeev_readfromfile_dd Rgeev_readfromfile_binary80 Rgeev_readfromfile_binary128 Rgeev_readfromfile_double Rgeev_test_mpfr Rgeev_test_gmp Rgeev_test_qd Rgeev_test_dd Rgeev_test_binary80 Rgeev_test_binary128 Rgeev_test_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rgees_Grcar_mpfr: Rgees_Grcar_mpfr.o
	$(CXX) -o Rgees_Grcar_mpfr Rgees_Grcar_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rgees_Grcar_gmp: Rgees_Grcar_gmp.o
	$(CXX) -o Rgees_Grcar_gmp Rgees_Grcar_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rgees_Grcar_qd: Rgees_Grcar_qd.o
	$(CXX) -o Rgees_Grcar_qd Rgees_Grcar_qd.o $(LIBFLAGS) $(QDLIBS)

Rgees_Grcar_dd: Rgees_Grcar_dd.o
	$(CXX) -o Rgees_Grcar_dd Rgees_Grcar_dd.o $(LIBFLAGS) $(DDLIBS)

Rgees_Grcar_binary80: Rgees_Grcar_binary80.o
	$(CXX) -o Rgees_Grcar_binary80 Rgees_Grcar_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rgees_Grcar_binary128: Rgees_Grcar_binary128.o
	$(CXX) -o Rgees_Grcar_binary128 Rgees_Grcar_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rgees_Grcar_double: Rgees_Grcar_double.o
	$(CXX) -o Rgees_Grcar_double Rgees_Grcar_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

