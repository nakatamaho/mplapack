# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgees_test_mpfr.exe Cgees_test_gmp.exe Cgees_test_qd.exe Cgees_test_dd.exe Cgees_test_binary80.exe Cgees_test_binary128.exe Cgees_test_double.exe Cgeev_NPR_mpfr.exe Cgeev_NPR_qd.exe Cgeev_NPR_dd.exe Cgeev_NPR_binary80.exe Cgeev_NPR_binary128.exe Cgeev_NPR_double.exe Cgeev_test2_mpfr.exe Cgeev_test2_gmp.exe Cgeev_test2_qd.exe Cgeev_test2_dd.exe Cgeev_test2_binary80.exe Cgeev_test2_binary128.exe Cgeev_test2_double.exe Cgeev_test_mpfr.exe Cgeev_test_gmp.exe Cgeev_test_qd.exe Cgeev_test_dd.exe Cgeev_test_binary80.exe Cgeev_test_binary128.exe Cgeev_test_double.exe Rgees_Grcar_mpfr.exe Rgees_Grcar_gmp.exe Rgees_Grcar_qd.exe Rgees_Grcar_dd.exe Rgees_Grcar_binary80.exe Rgees_Grcar_binary128.exe Rgees_Grcar_double.exe Rgees_readfromfile_mpfr.exe Rgees_readfromfile_gmp.exe Rgees_readfromfile_qd.exe Rgees_readfromfile_dd.exe Rgees_readfromfile_binary80.exe Rgees_readfromfile_binary128.exe Rgees_readfromfile_double.exe Rgees_test_mpfr.exe Rgees_test_gmp.exe Rgees_test_qd.exe Rgees_test_dd.exe Rgees_test_binary80.exe Rgees_test_binary128.exe Rgees_test_double.exe Rgeev_Frank_mpfr.exe Rgeev_Frank_gmp.exe Rgeev_Frank_qd.exe Rgeev_Frank_dd.exe Rgeev_Frank_binary80.exe Rgeev_Frank_binary128.exe Rgeev_Frank_double.exe Rgeev_random_highcond_mpfr.exe Rgeev_random_highcond_gmp.exe Rgeev_random_highcond_qd.exe Rgeev_random_highcond_dd.exe Rgeev_random_highcond_binary80.exe Rgeev_random_highcond_binary128.exe Rgeev_random_highcond_double.exe Rgeev_readfromfile_mpfr.exe Rgeev_readfromfile_gmp.exe Rgeev_readfromfile_qd.exe Rgeev_readfromfile_dd.exe Rgeev_readfromfile_binary80.exe Rgeev_readfromfile_binary128.exe Rgeev_readfromfile_double.exe Rgeev_test_mpfr.exe Rgeev_test_gmp.exe Rgeev_test_qd.exe Rgeev_test_dd.exe Rgeev_test_binary80.exe Rgeev_test_binary128.exe Rgeev_test_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rgees_Grcar_mpfr.exe: Rgees_Grcar_mpfr.o
	$(CXX) -o Rgees_Grcar_mpfr.exe Rgees_Grcar_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rgees_Grcar_gmp.exe: Rgees_Grcar_gmp.o
	$(CXX) -o Rgees_Grcar_gmp.exe Rgees_Grcar_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rgees_Grcar_qd.exe: Rgees_Grcar_qd.o
	$(CXX) -o Rgees_Grcar_qd.exe Rgees_Grcar_qd.o $(LIBFLAGS) $(QDLIBS)

Rgees_Grcar_dd.exe: Rgees_Grcar_dd.o
	$(CXX) -o Rgees_Grcar_dd.exe Rgees_Grcar_dd.o $(LIBFLAGS) $(DDLIBS)

Rgees_Grcar_binary80.exe: Rgees_Grcar_binary80.o
	$(CXX) -o Rgees_Grcar_binary80 Rgees_Grcar_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rgees_Grcar_binary128.exe: Rgees_Grcar_binary128.o
	$(CXX) -o Rgees_Grcar_binary128 Rgees_Grcar_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rgees_Grcar_double.exe: Rgees_Grcar_double.o
	$(CXX) -o Rgees_Grcar_double Rgees_Grcar_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

