# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgesvd_test_mpfr Cgesvd_test_gmp Cgesvd_test_qd Cgesvd_test_dd Cgesvd_test_binary80 Cgesvd_test_binary128 Cgesvd_test_double Rgesvd_random_highcond_mpfr Rgesvd_random_highcond_gmp Rgesvd_random_highcond_qd Rgesvd_random_highcond_dd Rgesvd_random_highcond_binary80 Rgesvd_random_highcond_binary128 Rgesvd_random_highcond_double Rgesvd_readfromfile_mpfr Rgesvd_readfromfile_gmp Rgesvd_readfromfile_qd Rgesvd_readfromfile_dd Rgesvd_readfromfile_binary80 Rgesvd_readfromfile_binary128 Rgesvd_readfromfile_double Rgesvd_test2_mpfr Rgesvd_test2_gmp Rgesvd_test2_qd Rgesvd_test2_dd Rgesvd_test2_binary80 Rgesvd_test2_binary128 Rgesvd_test2_double Rgesvd_test_mpfr Rgesvd_test_gmp Rgesvd_test_qd Rgesvd_test_dd Rgesvd_test_binary80 Rgesvd_test_binary128 Rgesvd_test_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rgesvd_random_highcond_mpfr: Rgesvd_random_highcond_mpfr.o
	$(CXX) -o Rgesvd_random_highcond_mpfr Rgesvd_random_highcond_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rgesvd_random_highcond_gmp: Rgesvd_random_highcond_gmp.o
	$(CXX) -o Rgesvd_random_highcond_gmp Rgesvd_random_highcond_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rgesvd_random_highcond_qd: Rgesvd_random_highcond_qd.o
	$(CXX) -o Rgesvd_random_highcond_qd Rgesvd_random_highcond_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rgesvd_random_highcond_dd: Rgesvd_random_highcond_dd.o
	$(CXX) -o Rgesvd_random_highcond_dd Rgesvd_random_highcond_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rgesvd_random_highcond_binary80: Rgesvd_random_highcond_binary80.o
	$(CXX) -o Rgesvd_random_highcond_binary80 Rgesvd_random_highcond_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rgesvd_random_highcond_binary128: Rgesvd_random_highcond_binary128.o
	$(CXX) -o Rgesvd_random_highcond_binary128 Rgesvd_random_highcond_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rgesvd_random_highcond_double: Rgesvd_random_highcond_double.o
	$(CXX) -o Rgesvd_random_highcond_double Rgesvd_random_highcond_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

