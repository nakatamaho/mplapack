# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgesvd_test_mpfr.exe Cgesvd_test_gmp.exe Cgesvd_test_qd.exe Cgesvd_test_dd.exe Cgesvd_test_binary80.exe Cgesvd_test_binary128.exe Cgesvd_test_double.exe Rgesvd_random_highcond_mpfr.exe Rgesvd_random_highcond_gmp.exe Rgesvd_random_highcond_qd.exe Rgesvd_random_highcond_dd.exe Rgesvd_random_highcond_binary80.exe Rgesvd_random_highcond_binary128.exe Rgesvd_random_highcond_double.exe Rgesvd_readfromfile_mpfr.exe Rgesvd_readfromfile_gmp.exe Rgesvd_readfromfile_qd.exe Rgesvd_readfromfile_dd.exe Rgesvd_readfromfile_binary80.exe Rgesvd_readfromfile_binary128.exe Rgesvd_readfromfile_double.exe Rgesvd_test2_mpfr.exe Rgesvd_test2_gmp.exe Rgesvd_test2_qd.exe Rgesvd_test2_dd.exe Rgesvd_test2_binary80.exe Rgesvd_test2_binary128.exe Rgesvd_test2_double.exe Rgesvd_test_mpfr.exe Rgesvd_test_gmp.exe Rgesvd_test_qd.exe Rgesvd_test_dd.exe Rgesvd_test_binary80.exe Rgesvd_test_binary128.exe Rgesvd_test_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rgesvd_random_highcond_mpfr.exe: Rgesvd_random_highcond_mpfr.o
	$(CXX) -o Rgesvd_random_highcond_mpfr.exe Rgesvd_random_highcond_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rgesvd_random_highcond_gmp.exe: Rgesvd_random_highcond_gmp.o
	$(CXX) -o Rgesvd_random_highcond_gmp.exe Rgesvd_random_highcond_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rgesvd_random_highcond_qd.exe: Rgesvd_random_highcond_qd.o
	$(CXX) -o Rgesvd_random_highcond_qd.exe Rgesvd_random_highcond_qd.o $(LIBFLAGS) $(QDLIBS)

Rgesvd_random_highcond_dd.exe: Rgesvd_random_highcond_dd.o
	$(CXX) -o Rgesvd_random_highcond_dd.exe Rgesvd_random_highcond_dd.o $(LIBFLAGS) $(DDLIBS)

Rgesvd_random_highcond_binary80.exe: Rgesvd_random_highcond_binary80.o
	$(CXX) -o Rgesvd_random_highcond_binary80 Rgesvd_random_highcond_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rgesvd_random_highcond_binary128.exe: Rgesvd_random_highcond_binary128.o
	$(CXX) -o Rgesvd_random_highcond_binary128 Rgesvd_random_highcond_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rgesvd_random_highcond_double.exe: Rgesvd_random_highcond_double.o
	$(CXX) -o Rgesvd_random_highcond_double Rgesvd_random_highcond_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Cgesvd_test_mpfr.exe: Cgesvd_test_mpfr.o
	$(CXX) -o Cgesvd_test_mpfr.exe Cgesvd_test_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Cgesvd_test_gmp.exe: Cgesvd_test_gmp.o
	$(CXX) -o Cgesvd_test_gmp.exe Cgesvd_test_gmp.o $(LIBFLAGS) $(GMPLIBS)

Cgesvd_test_qd.exe: Cgesvd_test_qd.o
	$(CXX) -o Cgesvd_test_qd.exe Cgesvd_test_qd.o $(LIBFLAGS) $(QDLIBS)

Cgesvd_test_dd.exe: Cgesvd_test_dd.o
	$(CXX) -o Cgesvd_test_dd.exe Cgesvd_test_dd.o $(LIBFLAGS) $(DDLIBS)

Cgesvd_test_binary80.exe: Cgesvd_test_binary80.o
