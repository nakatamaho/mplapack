# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Chesv_example_mpfr.exe Chesv_example_gmp.exe Chesv_example_qd.exe Chesv_example_dd.exe Chesv_example_binary80.exe Chesv_example_binary128.exe Chesv_example_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Chesv_example_mpfr.exe: Chesv_example_mpfr.o
	$(CXX) -o Chesv_example_mpfr.exe Chesv_example_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Chesv_example_gmp.exe: Chesv_example_gmp.o
	$(CXX) -o Chesv_example_gmp.exe Chesv_example_gmp.o $(LIBFLAGS) $(GMPLIBS)

Chesv_example_qd.exe: Chesv_example_qd.o
	$(CXX) -o Chesv_example_qd.exe Chesv_example_qd.o $(LIBFLAGS) $(QDLIBS)

Chesv_example_dd.exe: Chesv_example_dd.o
	$(CXX) -o Chesv_example_dd.exe Chesv_example_dd.o $(LIBFLAGS) $(DDLIBS)

Chesv_example_binary80.exe: Chesv_example_binary80.o
	$(CXX) -o Chesv_example_binary80 Chesv_example_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Chesv_example_binary128.exe: Chesv_example_binary128.o
	$(CXX) -o Chesv_example_binary128 Chesv_example_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Chesv_example_double.exe: Chesv_example_double.o
	$(CXX) -o Chesv_example_double Chesv_example_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
