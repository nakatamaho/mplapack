# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cposv_example_mpfr.exe Cposv_example_gmp.exe Cposv_example_qd.exe Cposv_example_dd.exe Cposv_example_binary80.exe Cposv_example_binary128.exe Cposv_example_double.exe Cpotrf_potrs_example_mpfr.exe Cpotrf_potrs_example_gmp.exe Cpotrf_potrs_example_qd.exe Cpotrf_potrs_example_dd.exe Cpotrf_potrs_example_binary80.exe Cpotrf_potrs_example_binary128.exe Cpotrf_potrs_example_double.exe Rpocon_example_mpfr.exe Rpocon_example_gmp.exe Rpocon_example_qd.exe Rpocon_example_dd.exe Rpocon_example_binary80.exe Rpocon_example_binary128.exe Rpocon_example_double.exe Rposv_example_mpfr.exe Rposv_example_gmp.exe Rposv_example_qd.exe Rposv_example_dd.exe Rposv_example_binary80.exe Rposv_example_binary128.exe Rposv_example_double.exe Rpotrf_potrs_example_mpfr.exe Rpotrf_potrs_example_gmp.exe Rpotrf_potrs_example_qd.exe Rpotrf_potrs_example_dd.exe Rpotrf_potrs_example_binary80.exe Rpotrf_potrs_example_binary128.exe Rpotrf_potrs_example_double.exe Rptsv_example_mpfr.exe Rptsv_example_gmp.exe Rptsv_example_qd.exe Rptsv_example_dd.exe Rptsv_example_binary80.exe Rptsv_example_binary128.exe Rptsv_example_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rpocon_example_mpfr.exe: Rpocon_example_mpfr.o
	$(CXX) -o Rpocon_example_mpfr.exe Rpocon_example_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rpocon_example_gmp.exe: Rpocon_example_gmp.o
	$(CXX) -o Rpocon_example_gmp.exe Rpocon_example_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rpocon_example_qd.exe: Rpocon_example_qd.o
	$(CXX) -o Rpocon_example_qd.exe Rpocon_example_qd.o $(LIBFLAGS) $(QDLIBS)

Rpocon_example_dd.exe: Rpocon_example_dd.o
	$(CXX) -o Rpocon_example_dd.exe Rpocon_example_dd.o $(LIBFLAGS) $(DDLIBS)

Rpocon_example_binary80.exe: Rpocon_example_binary80.o
	$(CXX) -o Rpocon_example_binary80 Rpocon_example_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rpocon_example_binary128.exe: Rpocon_example_binary128.o
	$(CXX) -o Rpocon_example_binary128 Rpocon_example_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rpocon_example_double.exe: Rpocon_example_double.o
	$(CXX) -o Rpocon_example_double Rpocon_example_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

