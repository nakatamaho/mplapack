# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=icpx
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd %%QUADMATH_CPPFLAGS%%
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -qopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib %%QUADMATH_LDFLAGS%% -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cposv_example_mpfr Cposv_example_gmp Cposv_example_qd Cposv_example_dd Cposv_example_binary80 Cposv_example_binary128 Cposv_example_double Cpotrf_potrs_example_mpfr Cpotrf_potrs_example_gmp Cpotrf_potrs_example_qd Cpotrf_potrs_example_dd Cpotrf_potrs_example_binary80 Cpotrf_potrs_example_binary128 Cpotrf_potrs_example_double Rpocon_example_mpfr Rpocon_example_gmp Rpocon_example_qd Rpocon_example_dd Rpocon_example_binary80 Rpocon_example_binary128 Rpocon_example_double Rposv_example_mpfr Rposv_example_gmp Rposv_example_qd Rposv_example_dd Rposv_example_binary80 Rposv_example_binary128 Rposv_example_double Rpotrf_potrs_example_mpfr Rpotrf_potrs_example_gmp Rpotrf_potrs_example_qd Rpotrf_potrs_example_dd Rpotrf_potrs_example_binary80 Rpotrf_potrs_example_binary128 Rpotrf_potrs_example_double Rptsv_example_mpfr Rptsv_example_gmp Rptsv_example_qd Rptsv_example_dd Rptsv_example_binary80 Rptsv_example_binary128 Rptsv_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rpocon_example_mpfr: Rpocon_example_mpfr.o
	$(CXX) -o Rpocon_example_mpfr Rpocon_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rpocon_example_gmp: Rpocon_example_gmp.o
	$(CXX) -o Rpocon_example_gmp Rpocon_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rpocon_example_qd: Rpocon_example_qd.o
	$(CXX) -o Rpocon_example_qd Rpocon_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rpocon_example_dd: Rpocon_example_dd.o
	$(CXX) -o Rpocon_example_dd Rpocon_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rpocon_example_binary80: Rpocon_example_binary80.o
	$(CXX) -o Rpocon_example_binary80 Rpocon_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rpocon_example_binary128: Rpocon_example_binary128.o
	$(CXX) -o Rpocon_example_binary128 Rpocon_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rpocon_example_double: Rpocon_example_double.o
	$(CXX) -o Rpocon_example_double Rpocon_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Cposv_example_mpfr: Cposv_example_mpfr.o
	$(CXX) -o Cposv_example_mpfr Cposv_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

