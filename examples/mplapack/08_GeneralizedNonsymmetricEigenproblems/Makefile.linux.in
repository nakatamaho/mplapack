# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cggev_example_mpfr Cggev_example_gmp Cggev_example_qd Cggev_example_dd Cggev_example_binary80 Cggev_example_binary128 Cggev_example_double Rgges_example_mpfr Rgges_example_gmp Rgges_example_qd Rgges_example_dd Rgges_example_binary80 Rgges_example_binary128 Rgges_example_double Rggev_example_mpfr Rggev_example_gmp Rggev_example_qd Rggev_example_dd Rggev_example_binary80 Rggev_example_binary128 Rggev_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rgges_example_mpfr: Rgges_example_mpfr.o
	$(CXX) -o Rgges_example_mpfr Rgges_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rgges_example_gmp: Rgges_example_gmp.o
	$(CXX) -o Rgges_example_gmp Rgges_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rgges_example_qd: Rgges_example_qd.o
	$(CXX) -o Rgges_example_qd Rgges_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rgges_example_dd: Rgges_example_dd.o
	$(CXX) -o Rgges_example_dd Rgges_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rgges_example_binary80: Rgges_example_binary80.o
	$(CXX) -o Rgges_example_binary80 Rgges_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rgges_example_binary128: Rgges_example_binary128.o
	$(CXX) -o Rgges_example_binary128 Rgges_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rgges_example_double: Rgges_example_double.o
	$(CXX) -o Rgges_example_double Rgges_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Cggev_example_mpfr: Cggev_example_mpfr.o
	$(CXX) -o Cggev_example_mpfr Cggev_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Cggev_example_gmp: Cggev_example_gmp.o
	$(CXX) -o Cggev_example_gmp Cggev_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

