# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cheev_test_mpfr.exe Cheev_test_gmp.exe Cheev_test_qd.exe Cheev_test_dd.exe Cheev_test_binary80.exe Cheev_test_binary128.exe Cheev_test_double.exe Rsyev_Frank_mpfr.exe Rsyev_Frank_gmp.exe Rsyev_Frank_qd.exe Rsyev_Frank_dd.exe Rsyev_Frank_binary80.exe Rsyev_Frank_binary128.exe Rsyev_Frank_double.exe Rsyev_test_mpfr.exe Rsyev_test_gmp.exe Rsyev_test_qd.exe Rsyev_test_dd.exe Rsyev_test_binary80.exe Rsyev_test_binary128.exe Rsyev_test_double.exe Rsyevd_DingDong_mpfr.exe Rsyevd_DingDong_gmp.exe Rsyevd_DingDong_qd.exe Rsyevd_DingDong_dd.exe Rsyevd_DingDong_binary80.exe Rsyevd_DingDong_binary128.exe Rsyevd_DingDong_double.exe Rsyevd_Frank_mpfr.exe Rsyevd_Frank_gmp.exe Rsyevd_Frank_qd.exe Rsyevd_Frank_dd.exe Rsyevd_Frank_binary80.exe Rsyevd_Frank_binary128.exe Rsyevd_Frank_double.exe Rsyevr_Frank_mpfr.exe Rsyevr_Frank_gmp.exe Rsyevr_Frank_qd.exe Rsyevr_Frank_dd.exe Rsyevr_Frank_binary80.exe Rsyevr_Frank_binary128.exe Rsyevr_Frank_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rsyev_Frank_mpfr.exe: Rsyev_Frank_mpfr.o
	$(CXX) -o Rsyev_Frank_mpfr.exe Rsyev_Frank_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rsyev_Frank_gmp.exe: Rsyev_Frank_gmp.o
	$(CXX) -o Rsyev_Frank_gmp.exe Rsyev_Frank_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rsyev_Frank_qd.exe: Rsyev_Frank_qd.o
	$(CXX) -o Rsyev_Frank_qd.exe Rsyev_Frank_qd.o $(LIBFLAGS) $(QDLIBS)

Rsyev_Frank_dd.exe: Rsyev_Frank_dd.o
	$(CXX) -o Rsyev_Frank_dd.exe Rsyev_Frank_dd.o $(LIBFLAGS) $(DDLIBS)

Rsyev_Frank_binary80.exe: Rsyev_Frank_binary80.o
	$(CXX) -o Rsyev_Frank_binary80 Rsyev_Frank_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rsyev_Frank_binary128.exe: Rsyev_Frank_binary128.o
	$(CXX) -o Rsyev_Frank_binary128 Rsyev_Frank_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rsyev_Frank_double.exe: Rsyev_Frank_double.o
	$(CXX) -o Rsyev_Frank_double Rsyev_Frank_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Cheev_test_mpfr.exe: Cheev_test_mpfr.o
	$(CXX) -o Cheev_test_mpfr.exe Cheev_test_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Cheev_test_gmp.exe: Cheev_test_gmp.o
	$(CXX) -o Cheev_test_gmp.exe Cheev_test_gmp.o $(LIBFLAGS) $(GMPLIBS)

Cheev_test_qd.exe: Cheev_test_qd.o
	$(CXX) -o Cheev_test_qd.exe Cheev_test_qd.o $(LIBFLAGS) $(QDLIBS)

Cheev_test_dd.exe: Cheev_test_dd.o
	$(CXX) -o Cheev_test_dd.exe Cheev_test_dd.o $(LIBFLAGS) $(DDLIBS)

Cheev_test_binary80.exe: Cheev_test_binary80.o
	$(CXX) -o Cheev_test_binary80.exe Cheev_test_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Cheev_test_binary128.exe: Cheev_test_binary128.o
	$(CXX) -o Cheev_test_binary128.exe Cheev_test_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Cheev_test_double.exe: Cheev_test_double.o
	$(CXX) -o Cheev_test_double.exe Cheev_test_double.o $(LIBFLAGS) $(DOUBLELIBS)

