	$(CXX) -o Cheev_test_qd Cheev_test_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Cheev_test_dd: Cheev_test_dd.o
	$(CXX) -o Cheev_test_dd Cheev_test_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Cheev_test_binary80: Cheev_test_binary80.o
	$(CXX) -o Cheev_test_binary80 Cheev_test_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Cheev_test_binary128: Cheev_test_binary128.o
	$(CXX) -o Cheev_test_binary128 Cheev_test_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

