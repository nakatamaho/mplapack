# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=icpx
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd %%QUADMATH_CPPFLAGS%%
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -qopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib %%QUADMATH_LDFLAGS%% -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cheev_test_mpfr Cheev_test_gmp Cheev_test_qd Cheev_test_dd Cheev_test_binary80 Cheev_test_binary128 Cheev_test_double Rsyev_Frank_mpfr Rsyev_Frank_gmp Rsyev_Frank_qd Rsyev_Frank_dd Rsyev_Frank_binary80 Rsyev_Frank_binary128 Rsyev_Frank_double Rsyev_test_mpfr Rsyev_test_gmp Rsyev_test_qd Rsyev_test_dd Rsyev_test_binary80 Rsyev_test_binary128 Rsyev_test_double Rsyevd_DingDong_mpfr Rsyevd_DingDong_gmp Rsyevd_DingDong_qd Rsyevd_DingDong_dd Rsyevd_DingDong_binary80 Rsyevd_DingDong_binary128 Rsyevd_DingDong_double Rsyevd_Frank_mpfr Rsyevd_Frank_gmp Rsyevd_Frank_qd Rsyevd_Frank_dd Rsyevd_Frank_binary80 Rsyevd_Frank_binary128 Rsyevd_Frank_double Rsyevr_Frank_mpfr Rsyevr_Frank_gmp Rsyevr_Frank_qd Rsyevr_Frank_dd Rsyevr_Frank_binary80 Rsyevr_Frank_binary128 Rsyevr_Frank_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rsyev_Frank_mpfr: Rsyev_Frank_mpfr.o
	$(CXX) -o Rsyev_Frank_mpfr Rsyev_Frank_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rsyev_Frank_gmp: Rsyev_Frank_gmp.o
	$(CXX) -o Rsyev_Frank_gmp Rsyev_Frank_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rsyev_Frank_qd: Rsyev_Frank_qd.o
	$(CXX) -o Rsyev_Frank_qd Rsyev_Frank_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rsyev_Frank_dd: Rsyev_Frank_dd.o
	$(CXX) -o Rsyev_Frank_dd Rsyev_Frank_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rsyev_Frank_binary80: Rsyev_Frank_binary80.o
	$(CXX) -o Rsyev_Frank_binary80 Rsyev_Frank_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rsyev_Frank_binary128: Rsyev_Frank_binary128.o
	$(CXX) -o Rsyev_Frank_binary128 Rsyev_Frank_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rsyev_Frank_double: Rsyev_Frank_double.o
	$(CXX) -o Rsyev_Frank_double Rsyev_Frank_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

Cheev_test_mpfr: Cheev_test_mpfr.o
	$(CXX) -o Cheev_test_mpfr Cheev_test_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Cheev_test_gmp: Cheev_test_gmp.o
	$(CXX) -o Cheev_test_gmp Cheev_test_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

