# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgetri_example_mpfr Cgetri_example_gmp Cgetri_example_qd Cgetri_example_dd Cgetri_example_binary80 Cgetri_example_binary128 Cgetri_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Cgetri_example_mpfr: Cgetri_example_mpfr.o
	$(CXX) -o Cgetri_example_mpfr Cgetri_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Cgetri_example_gmp: Cgetri_example_gmp.o
	$(CXX) -o Cgetri_example_gmp Cgetri_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Cgetri_example_qd: Cgetri_example_qd.o
	$(CXX) -o Cgetri_example_qd Cgetri_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Cgetri_example_dd: Cgetri_example_dd.o
	$(CXX) -o Cgetri_example_dd Cgetri_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Cgetri_example_binary80: Cgetri_example_binary80.o
	$(CXX) -o Cgetri_example_binary80 Cgetri_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Cgetri_example_binary128: Cgetri_example_binary128.o
	$(CXX) -o Cgetri_example_binary128 Cgetri_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Cgetri_example_double: Cgetri_example_double.o
	$(CXX) -o Cgetri_example_double Cgetri_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
