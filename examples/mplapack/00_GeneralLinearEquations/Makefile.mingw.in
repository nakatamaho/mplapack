# public domain

CXX=x86_64-w64-mingw32-g++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib -static-libgcc -static-libstdc++
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgetri_example_mpfr.exe Cgetri_example_gmp.exe Cgetri_example_qd.exe Cgetri_example_dd.exe Cgetri_example_binary80.exe Cgetri_example_binary128.exe Cgetri_example_double.exe

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Cgetri_example_mpfr.exe: Cgetri_example_mpfr.o
	$(CXX) -o Cgetri_example_mpfr.exe Cgetri_example_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Cgetri_example_gmp.exe: Cgetri_example_gmp.o
	$(CXX) -o Cgetri_example_gmp.exe Cgetri_example_gmp.o $(LIBFLAGS) $(GMPLIBS)

Cgetri_example_qd.exe: Cgetri_example_qd.o
	$(CXX) -o Cgetri_example_qd.exe Cgetri_example_qd.o $(LIBFLAGS) $(QDLIBS)

Cgetri_example_dd.exe: Cgetri_example_dd.o
	$(CXX) -o Cgetri_example_dd.exe Cgetri_example_dd.o $(LIBFLAGS) $(DDLIBS)

Cgetri_example_binary80.exe: Cgetri_example_binary80.o
	$(CXX) -o Cgetri_example_binary80 Cgetri_example_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Cgetri_example_binary128.exe: Cgetri_example_binary128.o
	$(CXX) -o Cgetri_example_binary128 Cgetri_example_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Cgetri_example_double.exe: Cgetri_example_double.o
	$(CXX) -o Cgetri_example_double Cgetri_example_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
