# public domain

CXX=g++-mp-14
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
LIBFLAGS=-L$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=-framework vecLib

programs=Cgesv_example_mpfr Cgesv_example_gmp Cgesv_example_qd Cgesv_example_dd Cgesv_example_binary80 Cgesv_example_binary128 Cgesv_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Cgesv_example_mpfr: Cgesv_example_mpfr.o
	$(CXX) -o Cgesv_example_mpfr Cgesv_example_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Cgesv_example_gmp: Cgesv_example_gmp.o
	$(CXX) -o Cgesv_example_gmp Cgesv_example_gmp.o $(LIBFLAGS) $(GMPLIBS)

Cgesv_example_qd: Cgesv_example_qd.o
	$(CXX) -o Cgesv_example_qd Cgesv_example_qd.o $(LIBFLAGS) $(QDLIBS)

Cgesv_example_dd: Cgesv_example_dd.o
	$(CXX) -o Cgesv_example_dd Cgesv_example_dd.o $(LIBFLAGS) $(DDLIBS)

Cgesv_example_binary80: Cgesv_example_binary80.o
	$(CXX) -o Cgesv_example_binary80 Cgesv_example_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Cgesv_example_binary128: Cgesv_example_binary128.o
	$(CXX) -o Cgesv_example_binary128 Cgesv_example_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Cgesv_example_double: Cgesv_example_double.o
	$(CXX) -o Cgesv_example_double Cgesv_example_double.o $(LIBFLAGS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
