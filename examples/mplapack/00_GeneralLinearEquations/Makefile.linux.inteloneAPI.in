# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=icpx
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd %%QUADMATH_CPPFLAGS%%
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -qopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib %%QUADMATH_LDFLAGS%% -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgesv_example_mpfr Cgesv_example_gmp Cgesv_example_qd Cgesv_example_dd Cgesv_example_binary80 Cgesv_example_binary128 Cgesv_example_double Cgetrf_getrs_example_mpfr Cgetrf_getrs_example_gmp Cgetrf_getrs_example_qd Cgetrf_getrs_example_dd Cgetrf_getrs_example_binary80 Cgetrf_getrs_example_binary128 Cgetrf_getrs_example_double Cgetri_example_mpfr Cgetri_example_gmp Cgetri_example_qd Cgetri_example_dd Cgetri_example_binary80 Cgetri_example_binary128 Cgetri_example_double Rgbsv_example_mpfr Rgbsv_example_gmp Rgbsv_example_qd Rgbsv_example_dd Rgbsv_example_binary80 Rgbsv_example_binary128 Rgbsv_example_double Rgecon_example_mpfr Rgecon_example_gmp Rgecon_example_qd Rgecon_example_dd Rgecon_example_binary80 Rgecon_example_binary128 Rgecon_example_double Rgesv_example_mpfr Rgesv_example_gmp Rgesv_example_qd Rgesv_example_dd Rgesv_example_binary80 Rgesv_example_binary128 Rgesv_example_double Rgesvx_example_mpfr Rgesvx_example_gmp Rgesvx_example_qd Rgesvx_example_dd Rgesvx_example_binary80 Rgesvx_example_binary128 Rgesvx_example_double Rgetrf_getrs_example_mpfr Rgetrf_getrs_example_gmp Rgetrf_getrs_example_qd Rgetrf_getrs_example_dd Rgetrf_getrs_example_binary80 Rgetrf_getrs_example_binary128 Rgetrf_getrs_example_double Rgetri_example2_mpfr Rgetri_example2_gmp Rgetri_example2_qd Rgetri_example2_dd Rgetri_example2_binary80 Rgetri_example2_binary128 Rgetri_example2_double Rgetri_example3_mpfr Rgetri_example3_gmp Rgetri_example3_qd Rgetri_example3_dd Rgetri_example3_binary80 Rgetri_example3_binary128 Rgetri_example3_double Rgetri_example_mpfr Rgetri_example_gmp Rgetri_example_qd Rgetri_example_dd Rgetri_example_binary80 Rgetri_example_binary128 Rgetri_example_double Rgtsv_example_mpfr Rgtsv_example_gmp Rgtsv_example_qd Rgtsv_example_dd Rgtsv_example_binary80 Rgtsv_example_binary128 Rgtsv_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rgbsv_example_mpfr: Rgbsv_example_mpfr.o
	$(CXX) -o Rgbsv_example_mpfr Rgbsv_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rgbsv_example_gmp: Rgbsv_example_gmp.o
	$(CXX) -o Rgbsv_example_gmp Rgbsv_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rgbsv_example_qd: Rgbsv_example_qd.o
	$(CXX) -o Rgbsv_example_qd Rgbsv_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rgbsv_example_dd: Rgbsv_example_dd.o
	$(CXX) -o Rgbsv_example_dd Rgbsv_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rgbsv_example_binary80: Rgbsv_example_binary80.o
	$(CXX) -o Rgbsv_example_binary80 Rgbsv_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rgbsv_example_binary128: Rgbsv_example_binary128.o
	$(CXX) -o Rgbsv_example_binary128 Rgbsv_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rgbsv_example_double: Rgbsv_example_double.o
	$(CXX) -o Rgbsv_example_double Rgbsv_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

