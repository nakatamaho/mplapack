# public domain
# whether _FLOAT128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS= -lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double
BLAS=
LAPACK=
FLIBS=

programs=Cgels_example_mpfr Cgels_example_gmp Cgels_example_qd Cgels_example_dd Cgels_example_binary80 Cgels_example_binary128 Cgels_example_double Cgelss_example_mpfr Cgelss_example_gmp Cgelss_example_qd Cgelss_example_dd Cgelss_example_binary80 Cgelss_example_binary128 Cgelss_example_double Rgels_example_mpfr Rgels_example_gmp Rgels_example_qd Rgels_example_dd Rgels_example_binary80 Rgels_example_binary128 Rgels_example_double Rgelss_example_mpfr Rgelss_example_gmp Rgelss_example_qd Rgelss_example_dd Rgelss_example_binary80 Rgelss_example_binary128 Rgelss_example_double Rgelsy_example_mpfr Rgelsy_example_gmp Rgelsy_example_qd Rgelsy_example_dd Rgelsy_example_binary80 Rgelsy_example_binary128 Rgelsy_example_double Rggglm_example_mpfr Rggglm_example_gmp Rggglm_example_qd Rggglm_example_dd Rggglm_example_binary80 Rggglm_example_binary128 Rggglm_example_double Rgglse_example_mpfr Rgglse_example_gmp Rgglse_example_qd Rgglse_example_dd Rgglse_example_binary80 Rgglse_example_binary128 Rgglse_example_double

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(CXXFLAGS) $<

Rgels_example_mpfr: Rgels_example_mpfr.o
	$(CXX) -o Rgels_example_mpfr Rgels_example_mpfr.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(MPFRLIBS)

Rgels_example_gmp: Rgels_example_gmp.o
	$(CXX) -o Rgels_example_gmp Rgels_example_gmp.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(GMPLIBS)

Rgels_example_qd: Rgels_example_qd.o
	$(CXX) -o Rgels_example_qd Rgels_example_qd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(QDLIBS)

Rgels_example_dd: Rgels_example_dd.o
	$(CXX) -o Rgels_example_dd Rgels_example_dd.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DDLIBS)

Rgels_example_binary80: Rgels_example_binary80.o
	$(CXX) -o Rgels_example_binary80 Rgels_example_binary80.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY80LIBS)

Rgels_example_binary128: Rgels_example_binary128.o
	$(CXX) -o Rgels_example_binary128 Rgels_example_binary128.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(BINARY128LIBS)

Rgels_example_double: Rgels_example_double.o
	$(CXX) -o Rgels_example_double Rgels_example_double.o $(LIBFLAGS) $(OPENMP_EXAMPLE_OPENMP_LIBS) $(DOUBLELIBS)

clean:
	rm -rf *.o *~ $(programs) *bak

