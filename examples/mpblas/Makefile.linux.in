# public domain
# whether BINARY128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2 -fopenmp
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS=-lmplapack_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmplapack_gmp -lgmpxx -lgmp
QDLIBS=-lmplapack_qd -lqd
DDLIBS=-lmplapack_dd -lqd
BINARY80LIBS=-lmplapack_binary80
BINARY128LIBS=-lmplapack_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmplapack_double

MPFROPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_mpfr_opt -lmpfr -lmpc -lgmp
GMPOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_gmp_opt -lgmpxx -lgmp
QDOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_qd_opt -lqd
DDOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_dd_opt -lqd
BINARY80OPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_binary80_opt
BINARY128OPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_binary128_opt%%LIBQUADMATH%%
DOUBLEOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmplapack_double_opt

BLAS=
LAPACK=
FLIBS=

programs=Rgemm_mpfr Rgemm_gmp Rgemm_qd Rgemm_dd Rgemm_binary80 Rgemm_binary128 Rgemm_double \
Rgemm_mpfr_opt Rgemm_gmp_opt Rgemm_qd_opt Rgemm_dd_opt Rgemm_binary80_opt Rgemm_binary128_opt Rgemm_double_opt

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

Rgemm_mpfr: Rgemm_mpfr.o
	$(CXX) -o Rgemm_mpfr Rgemm_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

Rgemm_mpfr_opt: Rgemm_mpfr.o
	$(CXX) -o Rgemm_mpfr_opt Rgemm_mpfr.o $(LIBFLAGS) $(MPFROPTLIBS)

Rgemm_gmp: Rgemm_gmp.o
	$(CXX) -o Rgemm_gmp Rgemm_gmp.o $(LIBFLAGS) $(GMPLIBS)

Rgemm_gmp_opt: Rgemm_gmp.o
	$(CXX) -o Rgemm_gmp_opt Rgemm_gmp.o $(LIBFLAGS) $(GMPOPTLIBS)

Rgemm_qd: Rgemm_qd.o
	$(CXX) -o Rgemm_qd Rgemm_qd.o $(LIBFLAGS) $(QDLIBS)

Rgemm_qd_opt: Rgemm_qd.o
	$(CXX) -o Rgemm_qd_opt Rgemm_qd.o $(LIBFLAGS) $(QDOPTLIBS)

Rgemm_dd: Rgemm_dd.o
	$(CXX) -o Rgemm_dd Rgemm_dd.o $(LIBFLAGS) $(DDLIBS)

Rgemm_dd_opt: Rgemm_dd.o
	$(CXX) -o Rgemm_dd_opt Rgemm_dd.o $(LIBFLAGS) $(DDOPTLIBS)

Rgemm_binary80: Rgemm_binary80.o
	$(CXX) -o Rgemm_binary80 Rgemm_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

Rgemm_binary80_opt: Rgemm_binary80.o
	$(CXX) -o Rgemm_binary80_opt Rgemm_binary80.o $(LIBFLAGS) $(BINARY80OPTLIBS)

Rgemm_binary128: Rgemm_binary128.o
	$(CXX) -o Rgemm_binary128 Rgemm_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

Rgemm_binary128_opt: Rgemm_binary128.o
	$(CXX) -o Rgemm_binary128_opt Rgemm_binary128.o $(LIBFLAGS) $(BINARY128OPTLIBS)

Rgemm_double: Rgemm_double.o
	$(CXX) -o Rgemm_double Rgemm_double.o $(LIBFLAGS) $(DOUBLELIBS)

Rgemm_double_opt: Rgemm_double.o
	$(CXX) -o Rgemm_double_opt Rgemm_double.o $(LIBFLAGS) $(DOUBLEOPTLIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
