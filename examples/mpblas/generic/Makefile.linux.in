# public domain
# whether BINARY128 libs is requred or not is heavily dependent on your environment.

CXX=c++
MPLAPACKDIR=%%MPLAPACKDIR%%
CXXFLAGS= -I$(MPLAPACKDIR)/include -I$(MPLAPACKDIR)/include/mplapack -I$(MPLAPACKDIR)/include/qd
OPTFLAGS= -O2 -fopenmp
OPENMP_EXAMPLE_OPENMP_LIBS = -fopenmp
LIBFLAGS=-L$(MPLAPACKDIR)/lib -Wl,--rpath=$(MPLAPACKDIR)/lib
MPFRLIBS=-lmpblas_mpfr -lmpfr -lmpc -lgmp
GMPLIBS=-lmpblas_gmp -lgmpxx -lgmp 
QDLIBS=-lmpblas_qd -lqd
DDLIBS=-lmpblas_dd -lqd
BINARY80LIBS=-lmpblas_binary80
BINARY128LIBS=-lmpblas_binary128%%LIBQUADMATH%%
DOUBLELIBS=-lmpblas_double

MPFROPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_mpfr_opt -lmpfr -lmpc -lgmp
GMPOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_gmp_opt -lgmpxx -lgmp
QDOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_qd_opt -lqd
DDOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_dd_opt -lqd
BINARY80OPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_binary80_opt
BINARY128OPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_binary128_opt%%LIBQUADMATH%%
DOUBLEOPTLIBS=$(OPENMP_EXAMPLE_OPENMP_LIBS) -lmpblas_double_opt

BLAS=
LAPACK=
FLIBS=

programs=%%ROUTINE%%_mpfr %%ROUTINE%%_gmp %%ROUTINE%%_qd %%ROUTINE%%_dd %%ROUTINE%%_binary80 %%ROUTINE%%_binary128 %%ROUTINE%%_double \
%%ROUTINE%%_mpfr_opt %%ROUTINE%%_gmp_opt %%ROUTINE%%_qd_opt %%ROUTINE%%_dd_opt %%ROUTINE%%_binary80_opt %%ROUTINE%%_binary128_opt %%ROUTINE%%_double_opt

all: $(programs)

.cpp.o:
	$(CXX) -c $(OPTFLAGS) $(CXXFLAGS) $<

%%ROUTINE%%_mpfr: %%ROUTINE%%_mpfr.o
	$(CXX) -o %%ROUTINE%%_mpfr %%ROUTINE%%_mpfr.o $(LIBFLAGS) $(MPFRLIBS)

%%ROUTINE%%_mpfr_opt: %%ROUTINE%%_mpfr.o
	$(CXX) -o %%ROUTINE%%_mpfr_opt %%ROUTINE%%_mpfr.o $(LIBFLAGS) $(MPFROPTLIBS)

%%ROUTINE%%_gmp: %%ROUTINE%%_gmp.o
	$(CXX) -o %%ROUTINE%%_gmp %%ROUTINE%%_gmp.o $(LIBFLAGS) $(GMPLIBS)

%%ROUTINE%%_gmp_opt: %%ROUTINE%%_gmp.o
	$(CXX) -o %%ROUTINE%%_gmp_opt %%ROUTINE%%_gmp.o $(LIBFLAGS) $(GMPOPTLIBS)

%%ROUTINE%%_qd: %%ROUTINE%%_qd.o
	$(CXX) -o %%ROUTINE%%_qd %%ROUTINE%%_qd.o $(LIBFLAGS) $(QDLIBS)

%%ROUTINE%%_qd_opt: %%ROUTINE%%_qd.o
	$(CXX) -o %%ROUTINE%%_qd_opt %%ROUTINE%%_qd.o $(LIBFLAGS) $(QDOPTLIBS)

%%ROUTINE%%_dd: %%ROUTINE%%_dd.o
	$(CXX) -o %%ROUTINE%%_dd %%ROUTINE%%_dd.o $(LIBFLAGS) $(DDLIBS)

%%ROUTINE%%_dd_opt: %%ROUTINE%%_dd.o
	$(CXX) -o %%ROUTINE%%_dd_opt %%ROUTINE%%_dd.o $(LIBFLAGS) $(DDOPTLIBS)

%%ROUTINE%%_binary80: %%ROUTINE%%_binary80.o
	$(CXX) -o %%ROUTINE%%_binary80 %%ROUTINE%%_binary80.o $(LIBFLAGS) $(BINARY80LIBS)

%%ROUTINE%%_binary80_opt: %%ROUTINE%%_binary80.o
	$(CXX) -o %%ROUTINE%%_binary80_opt %%ROUTINE%%_binary80.o $(LIBFLAGS) $(BINARY80OPTLIBS)

%%ROUTINE%%_binary128: %%ROUTINE%%_binary128.o
	$(CXX) -o %%ROUTINE%%_binary128 %%ROUTINE%%_binary128.o $(LIBFLAGS) $(BINARY128LIBS)

%%ROUTINE%%_binary128_opt: %%ROUTINE%%_binary128.o
	$(CXX) -o %%ROUTINE%%_binary128_opt %%ROUTINE%%_binary128.o $(LIBFLAGS) $(BINARY128OPTLIBS)

%%ROUTINE%%_double: %%ROUTINE%%_double.o
	$(CXX) -o %%ROUTINE%%_double %%ROUTINE%%_double.o $(LIBFLAGS) $(DOUBLELIBS)

%%ROUTINE%%_double_opt: %%ROUTINE%%_double.o
	$(CXX) -o %%ROUTINE%%_double_opt %%ROUTINE%%_double.o $(LIBFLAGS) $(DOUBLEOPTLIBS)

clean:
	rm -rf *.o *~ $(programs) *bak
