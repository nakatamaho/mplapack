# Lane-parallel Level 1/2/3 BLAS (../common/blas): bit-identical to the
# reference routines.
check_PROGRAMS = Rblas_omp_test_dd Rqd_ops_test Rgemm_opt_test Rgemm_gpu_host_test Rblas_gpu_host_test_dd
Rblas_omp_test_dd_SOURCES = ../common/test/Rblas_omp_test.cpp
Rblas_omp_test_dd_CPPFLAGS = $(libmplapack_dd_opt_la_CPPFLAGS)
Rblas_omp_test_dd_LDFLAGS = -static $(QD_RPATH_LDFLAGS)
Rblas_omp_test_dd_LDADD = libmplapack_dd_opt.la $(libmplapack_dd_opt_la_LIBADD)
# The dd/td/qd arithmetic of the SIMD and GPU kernels against libQD3's
# (branch-free) operators, bit for bit.
Rqd_ops_test_SOURCES = ../common/test/Rqd_ops_test.cpp
Rqd_ops_test_CPPFLAGS = $(libmplapack_dd_opt_la_CPPFLAGS)
Rqd_ops_test_CXXFLAGS = $(DD_CXXFLAGS)
Rqd_ops_test_LDFLAGS = -static $(QD_RPATH_LDFLAGS)
Rqd_ops_test_LDADD = $(QD_LIBADD)
# Optimized Rgemm (../common/Rgemm_*_common.h): the blocked engine is
# bit-identical to openmp/Rgemm_*_omp.cpp; Winograd and Ozaki are bounded.
Rgemm_opt_test_SOURCES = test/Rgemm_opt_test.cpp
Rgemm_opt_test_CPPFLAGS = $(libmplapack_dd_opt_la_CPPFLAGS) -DRGEMM_TEST_DD
Rgemm_opt_test_CXXFLAGS = $(DD_CXXFLAGS)
Rgemm_opt_test_LDFLAGS = -static $(QD_RPATH_LDFLAGS)
Rgemm_opt_test_LDADD = libmplapack_dd_opt.la $(libmplapack_dd_opt_la_LIBADD)
# The CUDA Level 1/2/3 BLAS code run on the host (no CUDA needed).
Rblas_gpu_host_test_dd_SOURCES = ../common/test/Rblas_gpu_test.cpp ../common/blas_cuda/Rblas_bridge_cuda.cpp ../common/blas_cuda/Rsyrk.cpp ../common/blas_cuda/Rsyr2k.cpp ../common/blas_cuda/Rsymm.cpp ../common/blas_cuda/Rtrmm.cpp ../common/blas_cuda/Rtrsm.cpp ../common/blas_cuda/Rgemv.cpp ../common/blas_cuda/Rsymv.cpp ../common/blas_cuda/Rtrmv.cpp ../common/blas_cuda/Rger.cpp ../common/blas_cuda/Rsyr.cpp ../common/blas_cuda/Rsyr2.cpp ../common/blas_cuda/Rscal.cpp ../common/blas_cuda/Rswap.cpp ../common/blas_cuda/Rrot.cpp
