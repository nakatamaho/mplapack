Rblas_gpu_host_test_dd_CXXFLAGS = $(DD_CXXFLAGS)
Rblas_gpu_host_test_dd_LDFLAGS = -static $(QD_RPATH_LDFLAGS)
Rblas_gpu_host_test_dd_LDADD = libmplapack_dd_opt.la $(libmplapack_dd_opt_la_LIBADD)
# The CUDA Rgemm code run on the host (no CUDA needed).
