AM_CPPFLAGS = -I$(top_srcdir)/include $(backend_cppflags)
AM_FFLAGS = -x f77-cpp-input -g
AM_LDFLAGS = $(backend_rpath_ldflags)
test_cxxflags = $(OPENMP_CXXFLAGS) $(backend_cxxflags)

refblas = -L$(top_builddir)/external/i/LAPACK/lib -lblas $(FCLIBS)
reflapack = -L$(top_builddir)/external/i/LAPACK/lib -llapack $(FCLIBS)

test_srcdepends = \
    ../../../../mpblas/test/common/xerbla.cpp \
    ../../../../mpblas/test/common/mplapack.test.cpp

if IS_MACOS
AM_LDFLAGS += -Wl,-flat_namespace,-undefined,dynamic_lookup
endif

if IS_MINGW
$(check_PROGRAMS): libmxerbla_override.la
lib_LTLIBRARIES = libmxerbla_override.la
libmxerbla_override_la_CPPFLAGS = -I$(top_srcdir)/include $(backend_define)
libmxerbla_override_la_SOURCES = ../../../../mpblas/test/common/Mxerbla.override.cpp
libmxerbla_override_la_LDFLAGS = -no-undefined

AM_LDFLAGS += -Wl,--allow-multiple-definition -Wl,--whole-archive,.libs/libmxerbla_override.a,$(backend_reference_archives),--no-whole-archive
LDADD = $(backend_whole_archive_libs) $(mplibs) $(reflapack) $(refblas)
else
test_srcdepends += ../../../../mpblas/test/common/Mxerbla.override.cpp
LDADD = -L$(top_builddir)/mplapack/reference $(backend_reference_libs) $(backend_link_libs) $(mplibs) $(reflapack) $(refblas)
endif

install-data-hook:
if IS_MACOS
	bash $(top_srcdir)/misc/fix_dylib_macOS.sh $(backend_testdir) $(prefix)
endif
