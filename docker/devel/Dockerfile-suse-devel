# Build (public / read-only):
#   docker build -f Dockerfile-suse-devel -t mplapack:devel-suse .
#
# Build (maintainer / SSH):
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile-suse-devel --build-arg DOCKER_UID="$(id -u)" --build-arg DOCKER_GID="$(id -g)" --build-arg USE_SSH=true  --build-arg SSH_KEY_NAME="${SSH_KEY_NAME:-id_ed25519}"     --secret id=ssh_key,src="$HOME/.ssh/${SSH_KEY_NAME:-id_ed25519}" -t mplapack:devel-suse .
#
# Build with custom repository (fork, HTTPS):
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile-suse-devel \
#     --build-arg DOCKER_UID="$(id -u)" \
#     --build-arg DOCKER_GID="$(id -g)" \
#     --build-arg MPLAPACK_REPO=https://github.com/<username>/mplapack.git \
#     -t mplapack:devel-suse .
#
# Build with custom repository (fork, SSH):
#   SSH_KEY_NAME=id_ed25519 DOCKER_BUILDKIT=1 docker build -f Dockerfile-suse-devel \
#     --build-arg DOCKER_UID="$(id -u)" \
#     --build-arg DOCKER_GID="$(id -g)" \
#     --build-arg USE_SSH=true \
#     --build-arg SSH_KEY_NAME="${SSH_KEY_NAME}" \
#     --build-arg MPLAPACK_REPO=https://github.com/<username>/mplapack.git \
#     --secret id=ssh_key,src="$HOME/.ssh/${SSH_KEY_NAME}" \
#     -t mplapack:devel-suse .
#
# Run:
#   sudo sysctl -w kernel.perf_event_paranoid=-1   # enable perf
#   docker run --privileged --gpus all -it --rm mplapack:devel-suse /bin/bash
#
# Run with SSH agent (maintainers):
#   eval $(ssh-agent); ssh-add ~/.ssh/id_ed25519
#   docker run --privileged --gpus all \
#     -v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent \
#     -it --rm mplapack:devel-suse /bin/bash
# =============================================================================

ARG BASE=opensuse/leap:16.0
FROM ${BASE}

LABEL maintainer="maho.nakata@gmail.com"

# ---------------------------------------------------------------------------
# Build arguments — all declared once, with defaults
# ---------------------------------------------------------------------------
ARG GIT_EMAIL="maho.nakata@gmail.com"
ARG GIT_NAME="NAKATA Maho"

ARG DOCKER_UID=2000
ARG DOCKER_GID=2000
ARG DOCKER_USER=docker

ARG USE_SSH=false
ARG SSH_KEY_NAME

# MPLAPACK_REPO can be overridden to point at a fork.
# Both ARG (build-time override) and ENV (runtime visibility) are set here.
ARG MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
ENV MPLAPACK_REPO=${MPLAPACK_REPO}

# Branch name or commit SHA (e.g. "release/2.1" or a full SHA).
ENV MPLAPACK_REF="master"

# ---------------------------------------------------------------------------
# System packages
# ---------------------------------------------------------------------------
RUN zypper --non-interactive install \
        gcc-c++ \
        gcc-fortran \
        make \
        autoconf \
        automake \
        libtool \
        ccache \
        python3 \
        git-core \
        sudo \
        openssh-clients \
        gzip \
        gawk \
        xz \
        bsdtar \
        bzip2 \
        patch \
    && zypper clean --all

# ---------------------------------------------------------------------------
# Build-tool environment
# ---------------------------------------------------------------------------
# ccache — directory is expected to be bind-mounted at runtime.
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:/usr/lib64/ccache:${PATH}"
ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"

# Work around tar extraction failures on aarch64 under QEMU/binfmt by
# preferring bsdtar (libarchive) over GNU tar.  /usr/local/bin typically
# precedes /usr/bin, so this shadows tar without touching existing scripts.
RUN test -x /usr/bin/bsdtar && \
    ln -sf /usr/bin/bsdtar /usr/local/bin/tar || true

# ---------------------------------------------------------------------------
# Non-root user
# ---------------------------------------------------------------------------
# Reuse an existing UID if present; otherwise create a fresh account.
RUN set -eux; \
    existing="$(getent passwd "${DOCKER_UID}" | cut -d: -f1 || true)"; \
    if [ -n "$existing" ]; then \
        usermod  -l "${DOCKER_USER}" -d "/home/${DOCKER_USER}" -m "$existing"; \
        groupmod -n "${DOCKER_USER}" "$(id -gn "${DOCKER_UID}")" 2>/dev/null || true; \
    else \
        groupadd -g "${DOCKER_GID}" "${DOCKER_USER}" 2>/dev/null || true; \
        useradd  -u "${DOCKER_UID}" -g "${DOCKER_GID}" -m -s /bin/bash "${DOCKER_USER}"; \
    fi; \
    if getent group wheel >/dev/null; then \
        usermod -aG wheel "${DOCKER_USER}"; \
    fi; \
    mkdir -p /etc/sudoers.d; \
    echo "${DOCKER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/"${DOCKER_USER}"; \
    chmod 0440 /etc/sudoers.d/"${DOCKER_USER}"

# ---------------------------------------------------------------------------
# Validate SSH-mode arguments early
# ---------------------------------------------------------------------------
RUN if [ "$USE_SSH" = "true" ] && [ -z "$SSH_KEY_NAME" ]; then \
        echo "========================================"; \
        echo "ERROR: SSH mode requires --build-arg SSH_KEY_NAME=<key>"; \
        echo "Example: --build-arg SSH_KEY_NAME=id_ed25519"; \
        echo "========================================"; \
        exit 1; \
    fi

# ---------------------------------------------------------------------------
# User-level setup
# ---------------------------------------------------------------------------
ARG WORK=/home/${DOCKER_USER}

USER ${DOCKER_USER}
WORKDIR ${WORK}

RUN printf '[user]\n\temail = %s\n\tname = %s\n' \
        "${GIT_EMAIL}" "${GIT_NAME}" > "${WORK}/.gitconfig"

# Minimal Fortran smoke-test source.
RUN printf '\tPROGRAM HELLO\n\tPRINT *, '"'"'HELLO, WORLD!'"'"'\n\tEND PROGRAM\n' \
        > "${WORK}/sample.f"

RUN echo "cd ${WORK}" >> "${WORK}/.bashrc"

# ---------------------------------------------------------------------------
# Clone — HTTPS (default) or SSH (maintainer, requires BuildKit secret)
# ---------------------------------------------------------------------------
# Prepare known_hosts for SSH mode.
RUN if [ "$USE_SSH" = "true" ]; then \
        mkdir -p "${WORK}/.ssh" && \
        chmod 0700 "${WORK}/.ssh" && \
        ssh-keyscan github.com > "${WORK}/.ssh/known_hosts"; \
    fi

# HTTPS clone (public / read-only).
RUN if [ "$USE_SSH" != "true" ]; then \
        echo "=== Cloning via HTTPS (public read-only mode) ===" && \
        echo "Repository: ${MPLAPACK_REPO}" && \
        git clone "${MPLAPACK_REPO}" "${WORK}/mplapack" && \
        git -C "${WORK}/mplapack" log -1; \
    fi

# SSH clone (maintainer, secret-mounted private key).
RUN --mount=type=secret,id=ssh_key,uid=${DOCKER_UID} \
    if [ "$USE_SSH" = "true" ]; then \
        echo "=== Cloning via SSH (maintainer mode) ===" && \
        SSH_REPO="$(echo "${MPLAPACK_REPO}" | sed 's|https://github.com/|git@github.com:|')" && \
        echo "Repository: ${SSH_REPO}" && \
        cp /run/secrets/ssh_key "${WORK}/.ssh/${SSH_KEY_NAME}" && \
        chmod 600 "${WORK}/.ssh/${SSH_KEY_NAME}" && \
        eval "$(ssh-agent -s)" && \
        ssh-add "${WORK}/.ssh/${SSH_KEY_NAME}" && \
        git clone "${SSH_REPO}" "${WORK}/mplapack" && \
        git -C "${WORK}/mplapack" log -1 && \
        rm -f "${WORK}/.ssh/${SSH_KEY_NAME}"; \
    fi

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
RUN cd "${WORK}/mplapack" && bash -x misc/reconfig.suse.sh
RUN cd "${WORK}/mplapack" && make clean
RUN cd "${WORK}/mplapack" && make -j"$(nproc)"
RUN cd "${WORK}/mplapack" && make install
