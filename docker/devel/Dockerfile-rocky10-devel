# * How to build (for public users - read-only access)
#  docker build -f Dockerfile-rocky10-devel -t mplapack:develrocky10 .
#
# * How to build (for maintainers with SSH key - read-write access)
# DOCKER_BUILDKIT=1 docker build -f Dockerfile-rocky10-devel --build-arg DOCKER_UID="$(id -u)" --build-arg DOCKER_GID="$(id -g)" --build-arg USE_SSH=true --build-arg SSH_KEY_NAME="${SSH_KEY_NAME:-id_ed25519}" --secret id=ssh_key,src="$HOME/.ssh/${SSH_KEY_NAME:-id_ed25519}" -t mplapack:develrocky10 .
#
# * How to build with custom repository (for users with forks)
# DOCKER_BUILDKIT=1 docker build -f Dockerfile-rocky10-devel --build-arg DOCKER_UID=$(id -u) --build-arg DOCKER_GID=$(id -g) --build-arg MPLAPACK_REPO=https://github.com/username/mplapack.git -t mplapack:develrocky10 .
#
# * How to build with custom repository using SSH
# SSH_KEY_NAME=id_ed25519 DOCKER_BUILDKIT=1 docker build -f Dockerfile-rocky10-devel --build-arg DOCKER_UID=$(id -u) --build-arg DOCKER_GID=$(id -g) --build-arg USE_SSH=true --build-arg SSH_KEY_NAME=${SSH_KEY_NAME} --build-arg MPLAPACK_REPO=https://github.com/<username>/mplapack.git --secret id=ssh_key,src=$HOME/.ssh/${SSH_KEY_NAME} -t mplapack:develrocky10 .
#
# * How to run
#  sudo sh -c 'echo -1 >/proc/sys/kernel/perf_event_paranoid' # to run perf
#  or
#  sudo sysctl -w kernel.perf_event_paranoid=-1 # to run perf
#  docker run --privileged --gpus all -it --rm mplapack:develrocky10 /bin/bash
#
# * How to run with SSH key for git operations (maintainers only)
#  eval $(ssh-agent); ssh-add ~/.ssh/id_ed25519; docker run --privileged --gpus all -v $SSH_AUTH_SOCK:/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent -it --rm mplapack:develrocky10 /bin/bash
#

ARG BASE=rockylinux/rockylinux:10
FROM ${BASE}

ARG GIT_EMAIL="maho.nakata@gmail.com"
ARG GIT_NAME="NAKATA Maho"
LABEL maintainer="maho.nakata@gmail.com"

# Build argument to choose between HTTPS (public) and SSH (maintainer)
ARG DOCKER_UID
ARG DOCKER_GID
ARG USE_SSH=false
ARG SSH_KEY_NAME

RUN set -eux; \
    . /etc/os-release; \
    dnf -y install dnf-plugins-core; \
    if [ "${ID}" = "fedora" ]; then \
        dnf -y makecache; \
    else \
        if dnf -q repolist all | grep -qiE '(^|[[:space:]])crb([[:space:]]|$)'; then \
            dnf config-manager --set-enabled crb 2>/dev/null || \
            dnf config-manager --enable crb 2>/dev/null || true; \
        fi; \
        if dnf -q list available epel-release >/dev/null 2>&1; then \
            dnf -y install epel-release; \
        else \
            echo "Warning: epel-release is not available on this image/architecture; continuing without EPEL." >&2; \
        fi; \
        dnf -y makecache; \
    fi
RUN set -eux; \
    dnf -y install \
        bash git python3 \
        libarchive \
        gcc gcc-c++ gfortran make \
        autoconf automake libtool \
        which findutils diffutils tar xz bzip2 patch \
        sudo openssh-clients \
        emacs-nox; \
    if dnf -q list available mg >/dev/null 2>&1; then \
        dnf -y install mg; \
    else \
        echo "Warning: mg is not available on this image/architecture; continuing without mg." >&2; \
    fi; \
    if dnf -q list available ccache >/dev/null 2>&1; then \
        dnf -y install ccache; \
    fi; \
    if dnf -q list available bsdtar >/dev/null 2>&1; then \
        dnf -y install bsdtar; \
    fi; \
    mkdir -p /etc/sudoers.d; \
    chmod 0750 /etc/sudoers.d; \
    dnf clean all

# Repository URLs - can be overridden to use forks
ARG MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git

# Validate required arguments for SSH mode
RUN if [ "$USE_SSH" = "true" ] && [ -z "$SSH_KEY_NAME" ]; then \
      echo "========================================"; \
      echo "ERROR: Maintainer mode requires SSH_KEY_NAME"; \
      echo "Usage: --build-arg SSH_KEY_NAME=id_ed25519"; \
      echo "========================================"; \
      exit 1; \
    fi

# create non-root user without password and allow passwordless sudo
ARG DOCKER_UID=2000
ARG DOCKER_GID=2000
ARG DOCKER_USER=docker

RUN set -eux; \
    existing="$(getent passwd ${DOCKER_UID} | cut -d: -f1 || true)"; \
    if [ -n "$existing" ]; then \
        usermod -l "${DOCKER_USER}" -d "/home/${DOCKER_USER}" -m "$existing"; \
        groupmod -n "${DOCKER_USER}" "$(id -gn ${DOCKER_UID})" 2>/dev/null || true; \
    else \
        groupadd -g "${DOCKER_GID}" "${DOCKER_USER}" 2>/dev/null || true; \
        useradd -u "${DOCKER_UID}" -g "${DOCKER_GID}" -m -s /bin/bash "${DOCKER_USER}"; \
    fi; \
    usermod -aG wheel "${DOCKER_USER}"; \
    echo "${DOCKER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/"${DOCKER_USER}"; \
    chmod 0440 /etc/sudoers.d/"${DOCKER_USER}"

ARG WORK=/home/${DOCKER_USER}

USER ${DOCKER_USER}

RUN printf '[user]\n\temail = %s\n\tname = %s\n' "${GIT_EMAIL}" "${GIT_NAME}" \
    > /home/$DOCKER_USER/.gitconfig

RUN printf '\n\tPROGRAM HELLO\n\tPRINT *, '"'"'HELLO, WORLD!'"'"'\n\tEND PROGRAM\n' \
    >> ${WORK}/sample.f

RUN cd ${WORK} && echo "cd /home/$DOCKER_USER" >> .bashrc

### Git clone strategy: HTTPS (default) or SSH (with --build-arg USE_SSH=true) ###

# Prepare SSH environment if using SSH mode
RUN if [ "$USE_SSH" = "true" ]; then \
        mkdir -p /home/$DOCKER_USER/.ssh && \
        chmod 0700 /home/$DOCKER_USER/.ssh && \
        ssh-keyscan github.com > /home/$DOCKER_USER/.ssh/known_hosts; \
    fi

# Clone repositories - HTTPS mode (default, public access)
RUN if [ "$USE_SSH" != "true" ]; then \
        echo "=== Cloning via HTTPS (public read-only mode) ===" && \
        echo "Repository: ${MPLAPACK_REPO}" && \
        cd ${WORK} && git clone ${MPLAPACK_REPO} && \
        cd ${WORK}/mplapack && git log -1; \
    fi

# Clone repositories - SSH mode (maintainer access, requires --secret)
RUN --mount=type=secret,id=ssh_key,uid=${DOCKER_UID} \
    if [ "$USE_SSH" = "true" ]; then \
        echo "=== Cloning via SSH (maintainer mode) ===" && \
        SSH_REPO=$(echo "${MPLAPACK_REPO}" | sed 's|https://github.com/|git@github.com:|') && \
        echo "Repository: ${SSH_REPO}" && \
        mkdir -p /home/$DOCKER_USER/.ssh && \
        cp /run/secrets/ssh_key /home/$DOCKER_USER/.ssh/${SSH_KEY_NAME} && \
        chmod 600 /home/$DOCKER_USER/.ssh/${SSH_KEY_NAME} && \
        eval "$(ssh-agent -s)" && \
        ssh-add /home/$DOCKER_USER/.ssh/${SSH_KEY_NAME} && \
        cd ${WORK} && git clone ${SSH_REPO} && \
        cd ${WORK}/mplapack && git log -1 && \
        rm -f /home/$DOCKER_USER/.ssh/${SSH_KEY_NAME}; \
    fi

RUN cd ${WORK}/mplapack && bash -x misc/reconfig.rocky10.sh
RUN cd ${WORK}/mplapack && make clean
RUN cd ${WORK}/mplapack && make -j"$(nproc)"
RUN cd ${WORK}/mplapack && make install
