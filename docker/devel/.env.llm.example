# .env.llm.example
# Copy to .env.llm and adjust. chmod 600 .env.llm
# Usage: docker compose -f docker-compose-llm.yml --env-file .env.llm up -d

# ── Model ────────────────────────────────────────────────────────────────────
# Absolute path to the directory containing the GGUF model file
MODEL_DIR=/path/to/models

# GGUF filename inside MODEL_DIR
# Recommended choices for A100 80GB:
#   Qwen3.5-35B-A3B-Q8_0.gguf      (~37GB, near-lossless, fast)      <- default
#   Qwen3.5-35B-A3B-Q4_K_M.gguf    (~20GB, good quality, fastest)
#   Qwen3.5-122B-A10B-Q3_K_M.gguf  (~53GB, best quality, slower)
MODEL_FILE=Qwen3.5-35B-A3B-Q8_0.gguf

# ── Inference settings ───────────────────────────────────────────────────────
# Context window (tokens). A100 80GB supports up to ~500K for 35B-Q8.
LLAMA_CTX_SIZE=131072

# Temperature: lower = more deterministic. 0.4 recommended for coding tasks.
LLM_TEMPERATURE=0.4
