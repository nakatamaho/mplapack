# Dockerfile.debian
# GCC build environment for Debian/Ubuntu (branch: requires autoreconf)
# Build happens at runtime with ccache mounted from host
ARG BASE=debian:12
FROM ${BASE}
RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    ccache \
    python3 \
    git \
    xz-utils \
    bzip2 \
    patch \
    util-linux \
    && rm -rf /var/lib/apt/lists/*
# Personality wrapper: when running linux/386 on an x86_64 host, the shared
# kernel makes uname -m return "x86_64" despite 32-bit userland.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
# Configure ccache (directory will be mounted at runtime)

ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"

ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
ENV MPLAPACK_REF="master"

WORKDIR /work

CMD ["/bin/bash", "-lc", "\
    set -euxo pipefail; \
    echo '=== ccache stats (before) ==='; ccache -s; \
    \
    # Fresh checkout every run \
    rm -rf /work/mplapack; \
    git clone --depth 1 --branch \"$MPLAPACK_REF\" \"$MPLAPACK_REPO\" /work/mplapack || { \
        git clone \"$MPLAPACK_REPO\" /work/mplapack; \
        cd /work/mplapack; \
        git checkout \"$MPLAPACK_REF\"; \
    }; \
    cd /work/mplapack; \
    git log -1; \
    \
    cd mplapack/test/compare; bash gen.Makefile.am.sh; cd /work/mplapack; \
    autoreconf --force --install; \
    \
    ARCH=$(dpkg --print-architecture); \
    echo \"Detected architecture: $ARCH\"; \
    COMMON_OPTS=\"--enable-gmp=yes --enable-mpfr=yes --enable-binary128=yes --enable-qd=yes --enable-dd=yes --enable-double=yes --enable-test=yes\"; \
    if [ \"$ARCH\" = \"amd64\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        CONFIGURE_OPTS=\"$COMMON_OPTS --enable-benchmark=yes --enable-binary80=yes\"; \
    else \
        CONFIGURE_OPTS=\"$COMMON_OPTS\"; \
    fi; \
    echo \"Configure options: $CONFIGURE_OPTS\"; \
    \
    ./configure $CONFIGURE_OPTS; \
    make -j\"$(nproc)\"; \
    make install; \
    if [ \"$ARCH\" = \"amd64\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        echo '=== Running make check ==='; \
        make check -j\"$(nproc)\"; \
    fi; \
    echo '=== ccache stats (after) ==='; ccache -s || true; \
"]
