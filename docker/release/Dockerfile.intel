# Dockerfile.intel
# Intel oneAPI build environment for Ubuntu (branch: requires autoreconf)
# Build happens at runtime with ccache mounted from host
ARG BASE=ubuntu:24.04
FROM ${BASE}
RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    ccache \
    python3 \
    git \
    xz-utils \
    bzip2 \
    patch \
    wget \
    gnupg \
    ca-certificates \
    && wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB | \
       gpg --dearmor -o /usr/share/keyrings/intel-oneapi.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/intel-oneapi.gpg] https://apt.repos.intel.com/oneapi all main" \
       > /etc/apt/sources.list.d/intel-oneapi.list

# Install compilers and dependencies
RUN apt-get update && apt-get install -y \
    intel-oneapi-compiler-dpcpp-cpp \
    intel-oneapi-compiler-fortran \
    intel-oneapi-mkl-devel

# Configure ccache (directory will be mounted at runtime)
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"

ENV CC="ccache icx"
ENV CXX="ccache icpx"
ENV FC="ccache ifx"
ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
# Branch name or commit SHA. Example: release/2.1 or a full SHA.
# ENV MPLAPACK_REF="release/2.1"
ENV MPLAPACK_REF="master"

WORKDIR /work
# TEST_CMD is passed via docker run -e; if set, tests run after the build.
ENV TEST_CMD=""
CMD ["/bin/bash", "-lc", "\
    set -euxo pipefail; \
    echo '=== ccache stats (before) ==='; ccache -s; \
    \
    # Fresh checkout every run \
    rm -rf /work/mplapack; \
    git clone --depth 1 --branch \"$MPLAPACK_REF\" \"$MPLAPACK_REPO\" /work/mplapack || { \
        # If MPLAPACK_REF is a commit SHA, clone then checkout \
        git clone \"$MPLAPACK_REPO\" /work/mplapack; \
        cd /work/mplapack; \
        git checkout \"$MPLAPACK_REF\"; \
    }; \
    cd /work/mplapack; \
    git log -1; \
    \
    # Autotools prep \
    set +u; source /opt/intel/oneapi/setvars.sh; set -u; \
    cd mplapack/test/compare; bash gen.Makefile.am.sh; cd /work/mplapack; \
    autoreconf --force --install; \
    \
    ARCH=$(dpkg --print-architecture); \
    echo \"Detected architecture: $ARCH\"; \
    COMMON_OPTS=\"--enable-gmp=yes --enable-mpfr=yes --enable-binary128=yes --enable-qd=yes --enable-dd=yes --enable-double=yes --enable-test=yes\"; \
    if [ \"$ARCH\" = \"amd64\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        CONFIGURE_OPTS=\"$COMMON_OPTS --enable-benchmark=yes --enable-binary80=yes\"; \
    else \
        CONFIGURE_OPTS=\"$COMMON_OPTS\"; \
    fi; \
    echo \"Configure options: $CONFIGURE_OPTS\"; \
    \
    ./configure $CONFIGURE_OPTS; \
    make -j\"$(nproc)\"; \
    make install; \
    if [ \"$ARCH\" = \"amd64\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        echo '=== Running make check ==='; \
        make check -j32; \
    fi; \
    echo '=== ccache stats (after) ==='; ccache -s; \
"]
