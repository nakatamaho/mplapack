# Dockerfile.redhat
# GCC build environment for Fedora/RHEL-like (branch: requires autoreconf)
# Build happens at runtime with ccache mounted from host

ARG BASE=fedora:39
FROM ${BASE}

RUN set -eux; \
    . /etc/os-release; \
    dnf -y install dnf-plugins-core; \
    if [ "${ID}" = "fedora" ]; then \
        # Fedora: CRB/EPEL are not applicable \
        dnf -y makecache; \
    else \
        # RHEL/Rocky/Alma: enable CRB (if present) and EPEL (best-effort) \
        if dnf -q repolist all | grep -qiE '(^|[[:space:]])crb([[:space:]]|$)'; then \
            if command -v dnf5 >/dev/null 2>&1; then \
                # DNF5 style \
                dnf5 -y install dnf5-plugins || true; \
                dnf5 config-manager setopt crb.enabled=1 2>/dev/null || true; \
            else \
                # DNF4 style (matches your log output) \
                dnf config-manager --set-enabled crb 2>/dev/null || \
                dnf config-manager --enable crb 2>/dev/null || true; \
            fi; \
        fi; \
        dnf -y install epel-release || true; \
        dnf -y makecache; \
    fi; \
    dnf -y install \
      bash git python3 \
      ccache libarchive \
      gcc gcc-c++ gcc-gfortran make \
      autoconf automake libtool cmake \
      which findutils diffutils tar xz bzip2 patch \
    && dnf -y install bsdtar || true \
    && dnf clean all

# Configure ccache (directory will be mounted at runtime)
ENV CCACHE_DIR=/ccache

# Workaround: avoid GNU tar on aarch64 emulation (QEMU/binfmt) where
# archive extraction may fail with EINVAL.
# Use bsdtar from libarchive instead by shadowing tar in PATH.
RUN test -x /usr/bin/bsdtar && \
    ln -sf /usr/bin/bsdtar /usr/local/bin/tar

# Fedora typically uses /usr/lib64/ccache; keep /usr/lib/ccache too for portability
ENV PATH="/usr/lib64/ccache:/usr/lib/ccache:${PATH}"
ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"

ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
# Branch name or commit SHA. Example: release/2.1 or a full SHA.
ENV MPLAPACK_REF="master"

WORKDIR /work

CMD ["/bin/bash", "-lc", "\
    set -euxo pipefail; \
    echo '=== ccache stats (before) ==='; ccache -s; \
    \
    # Fresh checkout every run \
    rm -rf /work/mplapack; \
    git clone --depth 1 --branch \"$MPLAPACK_REF\" \"$MPLAPACK_REPO\" /work/mplapack || { \
        # If MPLAPACK_REF is a commit SHA, clone then checkout \
        git clone \"$MPLAPACK_REPO\" /work/mplapack; \
        cd /work/mplapack; \
        git checkout \"$MPLAPACK_REF\"; \
    }; \
    cd /work/mplapack; \
    git log -1; \
    \
    # Autotools prep \
    cd mplapack/test/compare; bash gen.Makefile.am.sh; cd /work/mplapack; \
    autoreconf --force --install; \
    \
    ARCH=$(uname -m); \
    echo \"Detected architecture: $ARCH\"; \
    COMMON_OPTS=\"--enable-gmp=yes --enable-mpfr=yes --enable-binary128=yes --enable-qd=yes --enable-dd=yes --enable-double=yes --enable-test=yes\"; \
    if [ \"$ARCH\" = \"x86_64\" ] || [ \"$ARCH\" = \"i686\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        CONFIGURE_OPTS=\"$COMMON_OPTS --enable-benchmark=yes --enable-binary80=yes\"; \
    else \
        CONFIGURE_OPTS=\"$COMMON_OPTS\"; \
    fi; \
    echo \"Configure options: $CONFIGURE_OPTS\"; \
    \
    ./configure $CONFIGURE_OPTS; \
    make -j\"$(nproc)\"; \
    make install; \
    if [ \"$ARCH\" = \"x86_64\" ] || [ \"$ARCH\" = \"i686\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        echo '=== Running make check ==='; \
        make check -j32; \
    fi; \
    echo '=== ccache stats (after) ==='; ccache -s; \
"]
