# Dockerfile.debian-tarball
# GCC build for Debian/Ubuntu (tarball: no autoreconf needed)

ARG BASE=ubuntu:22.04
FROM ${BASE}

RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Extract and build from tarball
COPY mplapack-*.tar.gz /tmp/
WORKDIR /tmp
RUN tar xzf mplapack-*.tar.gz && rm mplapack-*.tar.gz

WORKDIR /tmp/mplapack-*
RUN ./configure && make -j$(nproc)

CMD ["make", "check"]
