# Dockerfile.ubuntu-tarball
# GCC build for Debian/Ubuntu tarballs (no top-level autoreconf; bundled deps may use autotools)

ARG BASE=ubuntu:22.04
FROM ${BASE}

RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    m4 \
    cmake \
    python3 \
    xz-utils \
    ccache \
    && rm -rf /var/lib/apt/lists/*

ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"

COPY common/tarball-smoke.sh /tarball-smoke.sh
RUN chmod +x /tarball-smoke.sh

WORKDIR /work

CMD ["/tarball-smoke.sh"]
