# tarball/Dockerfile.cuda
# CUDA-enabled build (tarball: no autoreconf needed)

ARG BASE=nvidia/cuda:12.4.0-devel-ubuntu22.04
FROM ${BASE}

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    xz-utils \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libblas-dev \
    liblapack-dev \
    pkg-config \
    ocl-icd-opencl-dev \
    opencl-headers \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/OpenCL/vendors && printf '%s\n' libnvidia-opencl.so.1 > /etc/OpenCL/vendors/nvidia.icd

# Verify CUDA installation
RUN nvcc --version

# Extract and build from tarball
COPY mplapack-*.tar.* /tmp/
WORKDIR /tmp
RUN tar xf mplapack-*.tar.* && rm mplapack-*.tar.*

WORKDIR /tmp/mplapack-*
RUN ./configure --enable-cuda && make -j$(nproc)

CMD ["make", "check"]
