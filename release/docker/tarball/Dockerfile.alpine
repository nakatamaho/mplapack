# tarball/Dockerfile.alpine
# GCC build for Alpine (musl libc, tarball: no autoreconf needed)

ARG BASE=alpine:3.19
FROM ${BASE}

RUN apk add --no-cache \
    build-base \
    gfortran \
    gmp-dev \
    mpfr-dev \
    mpc1-dev \
    openblas-dev

# Extract and build from tarball
COPY mplapack-*.tar.gz /tmp/
WORKDIR /tmp
RUN tar xzf mplapack-*.tar.gz && rm mplapack-*.tar.gz

WORKDIR /tmp/mplapack-*
RUN ./configure && make -j$(nproc)

CMD ["make", "check"]
