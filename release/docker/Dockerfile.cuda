# Dockerfile.cuda
# CUDA-enabled build (branch: requires autoreconf)

ARG BASE=nvidia/cuda:12.4.0-devel-ubuntu22.04
FROM ${BASE}

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Verify CUDA installation
RUN nvcc --version

COPY . /work
WORKDIR /work

# Build with CUDA support
RUN autoreconf -fi && \
    ./configure --enable-cuda && \
    make -j$(nproc)

CMD ["make", "check"]
