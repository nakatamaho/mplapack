# Dockerfile.suse
# GCC build for openSUSE (ref: requires autoreconf)
# Build happens at runtime with ccache mounted from host
ARG BASE=opensuse/leap:16
FROM ${BASE}

RUN set -eux; \
    zypper --gpg-auto-import-keys --non-interactive refresh; \
    zypper --non-interactive install \
        gcc-c++ \
        gcc-fortran \
        make \
        autoconf \
        automake \
        libtool \
        cmake \
        pkgconf \
        libopenblas_pthreads-devel \
        ccache \
        python3 \
        git-core \
        gzip \
        gawk \
        xz \
        bsdtar \
        bzip2 \
        patch \
        diffutils; \
    if ! command -v pkg-config >/dev/null 2>&1 || [ ! -f /usr/share/aclocal/pkg.m4 ]; then \
        zypper --non-interactive install pkg-config || true; \
    fi; \
    if ! command -v pkg-config >/dev/null 2>&1 || [ ! -f /usr/share/aclocal/pkg.m4 ]; then \
        zypper --non-interactive install pkgconf-pkg-config pkgconf-m4; \
    fi; \
    command -v pkg-config; \
    test -f /usr/share/aclocal/pkg.m4; \
    zypper clean --all

# Configure ccache (directory will be mounted at runtime)
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:/usr/lib64/ccache:${PATH}"
# Work around tar extraction failures seen on aarch64 under QEMU/binfmt
# by preferring bsdtar from libarchive over GNU tar.
# /usr/local/bin typically precedes /usr/bin, so this shadows tar without
# modifying existing build scripts.
RUN test -x /usr/bin/bsdtar && \
    ln -sf /usr/bin/bsdtar /usr/local/bin/tar || true
ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"

ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
# Git ref selected by MPLAPACK_REF.
ENV MPLAPACK_REF="master"

WORKDIR /work
COPY common/checkout-source.sh /usr/local/bin/checkout-source.sh
RUN chmod +x /usr/local/bin/checkout-source.sh

CMD ["/bin/bash", "-lc", "\
set -euxo pipefail; \
echo '=== ccache stats (before) ==='; ccache -s; \
\
# Fresh checkout every run \
rm -rf /work/mplapack; \
/usr/local/bin/checkout-source.sh \"$MPLAPACK_REPO\" \"$MPLAPACK_REF\" /work/mplapack; \
cd /work/mplapack; \
git log -1; \
\
# Autotools prep \
autoreconf --force --install; \
\
ARCH=$(uname -m); \
echo \"Detected architecture: $ARCH\"; \
COMMON_OPTS=\"--enable-gmp=yes --enable-mpfr=yes --enable-binary128=yes --enable-qd=yes --enable-dd=yes --enable-double=yes --enable-test=yes \"; \
if [ \"$ARCH\" = \"x86_64\" ] || [ \"$ARCH\" = \"i686\" ]; then \
  CONFIGURE_OPTS=\"$COMMON_OPTS --enable-binary80=yes --enable-benchmark=yes --with-openblas=system\"; \
else \
  CONFIGURE_OPTS=\"$COMMON_OPTS --enable-benchmark=yes --with-openblas=system\"; \
fi; \
echo \"Configure options: $CONFIGURE_OPTS\"; \
\
./configure $CONFIGURE_OPTS; \
make -j\"$(nproc)\"; \
make install; \
make dist; \
echo '=== ccache stats (after) ==='; ccache -s; \
"]
