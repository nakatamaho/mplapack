# Dockerfile.intel
# Intel oneAPI build environment for Ubuntu ref matrix.
ARG BASE=ubuntu:24.04
FROM ${BASE}
RUN apt-get update && apt-get install -y     build-essential     gfortran     autoconf     automake     libtool     cmake     pkg-config     ccache     python3     git     xz-utils     bzip2     patch     wget     gnupg     ca-certificates     && wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB |        gpg --dearmor -o /usr/share/keyrings/intel-oneapi.gpg     && echo "deb [signed-by=/usr/share/keyrings/intel-oneapi.gpg] https://apt.repos.intel.com/oneapi all main"        > /etc/apt/sources.list.d/intel-oneapi.list

RUN apt-get update && apt-get install -y     intel-oneapi-compiler-dpcpp-cpp     intel-oneapi-compiler-fortran     intel-oneapi-mkl-devel

ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"
ENV CC="ccache icx"
ENV CXX="ccache icpx"
ENV FC="ccache ifx"
ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
ENV MPLAPACK_REF="master"

WORKDIR /work
COPY matrix/run-ubuntu-intel-build.sh /run-ubuntu-intel-build.sh
RUN chmod +x /run-ubuntu-intel-build.sh
CMD ["/run-ubuntu-intel-build.sh"]
