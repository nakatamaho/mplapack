# Dockerfile.redhat
# GCC build environment for Fedora/RHEL-like (ref: requires autoreconf)
# Build happens at runtime with ccache mounted from host

ARG BASE=fedora:39
FROM ${BASE}

ARG CCACHE_VERSION=4.13.2
ENV CCACHE_URL=https://github.com/ccache/ccache/releases/download/v${CCACHE_VERSION}/ccache-${CCACHE_VERSION}.tar.gz

RUN set -eux; \
    . /etc/os-release; \
    dnf -y install dnf-plugins-core; \
    if [ "${ID}" = "fedora" ]; then \
        dnf -y makecache; \
    else \
        if dnf -q repolist all | grep -qiE '(^|[[:space:]])crb([[:space:]]|$)'; then \
            dnf config-manager --set-enabled crb 2>/dev/null || \
            dnf config-manager --enable crb 2>/dev/null || true; \
        fi; \
        if dnf -q list available epel-release >/dev/null 2>&1; then \
            dnf -y install epel-release; \
        else \
            echo "Warning: epel-release is not available on this image/architecture; continuing without EPEL." >&2; \
        fi; \
        dnf -y makecache; \
    fi
RUN set -eux; \
    dnf -y install \
        bash git python3 \
        libarchive \
        gcc gcc-c++ gfortran make \
        autoconf automake libtool cmake \
        pkgconf-pkg-config pkgconf-m4 \
        openblas-devel \
        which findutils diffutils tar xz bzip2 patch; \
    if dnf -q list available ccache >/dev/null 2>&1; then \
        dnf -y install ccache; \
    fi; \
    if ! command -v ccache >/dev/null 2>&1; then \
        build_root=/tmp/ccache-build; \
        tarball="${build_root}/ccache-${CCACHE_VERSION}.tar.gz"; \
        src_root="${build_root}/src"; \
        build_dir="${build_root}/build"; \
        rm -rf "${build_root}"; \
        mkdir -p "${src_root}" "${build_dir}"; \
        python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
            "${CCACHE_URL}" "${tarball}"; \
        tar -xzf "${tarball}" -C "${src_root}"; \
        cd "${build_dir}"; \
        cmake -D CMAKE_BUILD_TYPE=Release \
              -D CMAKE_INSTALL_PREFIX=/usr \
              -D CMAKE_INSTALL_BINDIR=bin \
              "${src_root}/ccache-${CCACHE_VERSION}"; \
        make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"; \
        make install; \
        cd /; \
        rm -rf "${build_root}"; \
    fi; \
    command -v ccache >/dev/null 2>&1; \
    if dnf -q list available bsdtar >/dev/null 2>&1; then \
        dnf -y install bsdtar; \
    fi; \
    dnf clean all

# Configure ccache (directory will be mounted at runtime)
ENV CCACHE_DIR=/ccache

# Workaround: avoid GNU tar on aarch64 emulation (QEMU/binfmt) where
# archive extraction may fail with EINVAL.
# Use bsdtar from libarchive instead by shadowing tar in PATH.
RUN if [ -x /usr/bin/bsdtar ]; then \
        ln -sf /usr/bin/bsdtar /usr/local/bin/tar; \
    fi


ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
# Git ref selected by MPLAPACK_REF.
ENV MPLAPACK_REF="master"

WORKDIR /work

CMD ["/bin/bash", "-lc", "\
    set -euxo pipefail; \
    rm -rf /work/mplapack; \
    git clone --depth 1 --branch \"$MPLAPACK_REF\" \"$MPLAPACK_REPO\" /work/mplapack || { \
        git clone \"$MPLAPACK_REPO\" /work/mplapack; \
        cd /work/mplapack; \
        git checkout \"$MPLAPACK_REF\"; \
    }; \
    cd /work/mplapack/; \
    git log -1; \
    ARCH=$(uname -m); \
    if [ \"$ARCH\" = \"x86_64\" ] || [ \"$ARCH\" = \"i686\" ] || [ \"$ARCH\" = \"i386\" ]; then \
        ENABLE_BENCHMARK=yes bash -x misc/reconfig.rocky10.sh; \
    else \
        ENABLE_BENCHMARK=no bash -x misc/reconfig.rocky10.sh; \
    fi; \
    cd /work/mplapack/; \
    make -j\"$(nproc)\"; \
    make install; \
"]
