# Dockerfile.redhat-el8-tarball
# GCC build for RHEL 8 / Rocky 8 (tarball: no autoreconf needed)

ARG BASE=rockylinux:8
FROM ${BASE}

# Enable PowerTools repo (Rocky 8) for development packages
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y \
    gcc-c++ \
    gcc-gfortran \
    make \
    gmp-devel \
    mpfr-devel \
    libmpc-devel \
    blas-devel \
    lapack-devel \
    && dnf clean all

# Extract and build from tarball
COPY mplapack-*.tar.gz /tmp/
WORKDIR /tmp
RUN tar xzf mplapack-*.tar.gz && rm mplapack-*.tar.gz

WORKDIR /tmp/mplapack-*
RUN ./configure && make -j$(nproc)

CMD ["make", "check"]
