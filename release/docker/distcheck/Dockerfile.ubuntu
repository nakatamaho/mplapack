# Dockerfile.ubuntu
# GCC release distcheck environment for Debian/Ubuntu
# Distcheck runs at runtime with ccache mounted from host
ARG BASE=ubuntu:22.04
FROM ${BASE}
RUN apt-get update && apt-get install -y \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    cmake \
    pkg-config \
    libopenblas-dev \
    ccache \
    python3 \
    git \
    xz-utils \
    bzip2 \
    patch \
    && rm -rf /var/lib/apt/lists/*
# Configure ccache (directory will be mounted at runtime)
ENV CCACHE_DIR=/ccache
ENV PATH="/usr/lib/ccache:${PATH}"
ENV CC="ccache gcc"
ENV CXX="ccache g++"
ENV FC="ccache gfortran"
ENV MPLAPACK_REPO=https://github.com/nakatamaho/mplapack.git
# Git ref selected by MPLAPACK_REF.
ENV MPLAPACK_REF="master"
WORKDIR /work
COPY distcheck/run-ubuntu-distcheck.sh /run-ubuntu-distcheck.sh
RUN chmod +x /run-ubuntu-distcheck.sh
CMD ["/run-ubuntu-distcheck.sh"]
