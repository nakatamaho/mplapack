# Dockerfile.redhat-el8
# GCC build for RHEL 8 / Rocky 8 (branch: requires autoreconf)
# Uses dnf with powertools/crb repo for development packages

ARG BASE=rockylinux:8
FROM ${BASE}

# Enable PowerTools repo (Rocky 8) for development packages
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y \
    gcc-c++ \
    gcc-gfortran \
    make \
    autoconf \
    automake \
    libtool \
    gmp-devel \
    mpfr-devel \
    libmpc-devel \
    blas-devel \
    lapack-devel \
    && dnf clean all

COPY . /work
WORKDIR /work

RUN autoreconf -fi && \
    ./configure && \
    make -j$(nproc)

CMD ["make", "check"]
