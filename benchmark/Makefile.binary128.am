# LAPACK benchmarks
Rpotrf_binary128_SOURCES=      Rpotrf.cpp
Rpotrf_binary128_CXXFLAGS=     $(binary128cxxflags)
Rpotrf_binary128_LDFLAGS=      $(binary128_libdepends)

Rpotrf_binary128_opt_SOURCES=  Rpotrf.cpp
