set xlabel font "Helvetica,20"
set ylabel font "Helvetica,20"
set key font   "Helvetica,16"
set title font "Helvetica,20"
set title "Rpotrf OpenCL on %%MODELNAME%%"
set xlabel "Dimension"
set ylabel "MFLOPS"
set key above
set terminal pdf

plot "log.Rpotrf.binary128_opencl_total" using 1:2 title 'binary128 OpenCL total' with lines linewidth 1
