# -----------------------------------------------------------------------------
# Static data: gnuplot templates (.plt.in) installed alongside binaries.
# go.*.sh are generated at build time from .sh.in; not listed here.
# -----------------------------------------------------------------------------
bench_DATA = \
    Raxpy1.plt.in  Raxpy2.plt.in  Raxpy3.plt.in  \
    Rcopy1.plt.in  Rcopy2.plt.in  Rcopy3.plt.in  \
    Rdot1.plt.in   Rdot2.plt.in   Rdot3.plt.in   \
    Rgemm1.plt.in  Rgemm2.plt.in  Rgemm3.plt.in  \
    Rgemm_cuda.plt.in              \
    Rgemv1.plt.in  Rgemv2.plt.in  Rgemv3.plt.in  \
    Rsyrk1.plt.in  Rsyrk2.plt.in  Rsyrk3.plt.in  \
    Rsyrk_cuda.plt.in              \
    Rgetrf1.plt.in Rgetrf2.plt.in Rgetrf3.plt.in \
    Rgetrf_cuda.plt.in             \
    Rpotrf1.plt.in Rpotrf2.plt.in Rpotrf3.plt.in \
    Rpotrf_cuda.plt.in


# -----------------------------------------------------------------------------
# Source templates for go.*.sh (included in "make dist").
# -----------------------------------------------------------------------------
EXTRA_DIST = \
    go.Raxpy.sh.in       \
    go.Rcopy.sh.in       \
    go.Rdot.sh.in        \
    go.Rgemm.sh.in       \
    go.Rgemm_cuda.sh.in  \
    go.Rgemv.sh.in       \
    go.Rsyrk.sh.in       \
    go.Rsyrk_cuda.sh.in  \
    go.Rgetrf.sh.in      \
    go.Rgetrf_cuda.sh.in \
    go.Rpotrf.sh.in      \
    go.Rpotrf_cuda.sh.in


# -----------------------------------------------------------------------------
# Generated scripts (built in builddir, cleaned on "make clean").
# %%CPU_OS_DETECTION_SH%% -> builddir path here; overwritten at install time.
# %%CC_TAG%%              -> baked in at build time (never changes per install).
# %%PREFIX%%              -> builddir abs path here; overwritten at install time.
# -----------------------------------------------------------------------------
BUILT_SOURCES = \
    go.Raxpy.sh       \
    go.Rcopy.sh       \
    go.Rdot.sh        \
    go.Rgemm.sh       \
    go.Rgemm_cuda.sh  \
    go.Rgemv.sh       \
    go.Rsyrk.sh       \
    go.Rsyrk_cuda.sh  \
    go.Rgetrf.sh      \
    go.Rgetrf_cuda.sh \
    go.Rpotrf.sh      \
    go.Rpotrf_cuda.sh

CLEANFILES = $(BUILT_SOURCES)

# -----------------------------------------------------------------------------
# Install destination
# -----------------------------------------------------------------------------
benchdir = $(prefix)/lib/$(target)/mplapack/benchmark
@ENABLE_MPFR_TRUE@mpfrcxxflags = $(OPENMP_CXXFLAGS) \
@ENABLE_MPFR_TRUE@	-I$(top_srcdir)/include \
@ENABLE_MPFR_TRUE@	-I$(top_srcdir)/mpfrc++ -I$(GMP_INCLUDEDIR) \
@ENABLE_MPFR_TRUE@	-I$(MPFR_INCLUDEDIR) -I$(MPC_INCLUDEDIR) \
@ENABLE_MPFR_TRUE@	-D___MPLAPACK_BUILD_WITH_MPFR___ \
@ENABLE_MPFR_TRUE@	$(am__append_2)
@ENABLE_MPFR_TRUE@mpfrlapack_libdepends = -L$(top_builddir)/mplapack/reference -lmplapack_mpfr
@ENABLE_MPFR_TRUE@mpfr_libdepends = $(mpfrlapack_libdepends) \
@ENABLE_MPFR_TRUE@	-L$(top_builddir)/mpblas/reference \
@ENABLE_MPFR_TRUE@	-lmpblas_mpfr -L$(MPC_LIBDIR) \
@ENABLE_MPFR_TRUE@	-L$(MPFR_LIBDIR) -L$(GMP_LIBDIR) -lmpfr \
@ENABLE_MPFR_TRUE@	-lmpc -lgmp $(DYLD) $(am__append_3)
@ENABLE_MPFR_TRUE@mpfropt_libdepends = $(mpfrlapack_libdepends) \
@ENABLE_MPFR_TRUE@	-L$(top_builddir)/mpblas/optimized/mpfr \
@ENABLE_MPFR_TRUE@	-lmpblas_mpfr_opt -L$(MPC_LIBDIR) \
@ENABLE_MPFR_TRUE@	-L$(MPFR_LIBDIR) -L$(GMP_LIBDIR) -lmpfr \
@ENABLE_MPFR_TRUE@	-lmpc -lgmp $(DYLD) $(am__append_4)

