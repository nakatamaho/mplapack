bench_PROGRAMS += \
Rpotrf.binary128 Rpotrf.binary128_opt \
Rpotf2.binary128 Rpotf2.binary128_opt \
Rgetrf.binary128 Rgetrf.binary128_opt

binary128cxxflags = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -D___MPLAPACK_BUILD_WITH_BINARY128___
binary128lapack_libdepends = -L$(top_builddir)/mplapack/reference -lmplapack_binary128

if BINARY128_USE_QUADMATH
binary128_libdepends = $(binary128lapack_libdepends) -L$(top_builddir)/mpblas/reference -lmpblas_binary128 -lquadmath $(DYLD)
binary128opt_libdepends = $(binary128lapack_libdepends) -L$(top_builddir)/mpblas/optimized/binary128 -lmpblas_binary128_opt -lquadmath $(DYLD)
else
binary128_libdepends = $(binary128lapack_libdepends) -L$(top_builddir)/mpblas/reference -lmpblas_binary128 $(DYLD)
binary128opt_libdepends = $(binary128lapack_libdepends) -L$(top_builddir)/mpblas/optimized/binary128 -lmpblas_binary128_opt $(DYLD)
endif

if IS_MINGW
binary128cxxflags += -I$(DLFCN_WIN32_INCLUDEDIR)
binary128_libdepends += -L$(DLFCN_WIN32_LIBDIR) -ldl
binary128opt_libdepends += -L$(DLFCN_WIN32_LIBDIR) -ldl
endif

Rpotrf_binary128_opt_SOURCES= Rpotrf.cpp
Rpotrf_binary128_opt_CXXFLAGS= $(binary128cxxflags)
Rpotrf_binary128_opt_LDFLAGS= $(binary128opt_libdepends)

Rpotrf_binary128_SOURCES= Rpotrf.cpp
Rpotrf_binary128_CXXFLAGS= $(binary128cxxflags)
Rpotrf_binary128_LDFLAGS= $(binary128_libdepends)

Rpotf2_binary128_opt_SOURCES= Rpotf2.cpp
Rpotf2_binary128_opt_CXXFLAGS= $(binary128cxxflags)
Rpotf2_binary128_opt_LDFLAGS= $(binary128opt_libdepends)

Rpotf2_binary128_SOURCES= Rpotf2.cpp
Rpotf2_binary128_CXXFLAGS= $(binary128cxxflags)
Rpotf2_binary128_LDFLAGS= $(binary128_libdepends)

Rgetrf_binary128_opt_SOURCES= Rgetrf.cpp
Rgetrf_binary128_opt_CXXFLAGS= $(binary128cxxflags)
Rgetrf_binary128_opt_LDFLAGS= $(binary128opt_libdepends)

Rgetrf_binary128_SOURCES= Rgetrf.cpp
Rgetrf_binary128_CXXFLAGS= $(binary128cxxflags)
Rgetrf_binary128_LDFLAGS= $(binary128_libdepends)


