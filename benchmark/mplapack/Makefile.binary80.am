bench_PROGRAMS += \
Rpotrf.binary80 Rpotrf.binary80_opt \
Rpotf2.binary80 Rpotf2.binary80_opt \
Rgetrf.binary80 Rgetrf.binary80_opt

binary80cxxflags = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -D___MPLAPACK_BUILD_WITH_BINARY80___
binary80lapack_libdepends = -L$(top_builddir)/mplapack/reference -lmplapack_binary80

if BINARY128_USE_QUADMATH
binary80_libdepends = $(binary80lapack_libdepends) -L$(top_builddir)/mpblas/reference -lmpblas_binary80 -lquadmath $(DYLD)
binary80opt_libdepends = $(binary80lapack_libdepends) -L$(top_builddir)/mpblas/optimized/binary80 -lmpblas_binary80_opt -lquadmath $(DYLD)
else
binary80_libdepends = $(binary80lapack_libdepends) -L$(top_builddir)/mpblas/reference -lmpblas_binary80 $(DYLD)
binary80opt_libdepends = $(binary80lapack_libdepends) -L$(top_builddir)/mpblas/optimized/binary80 -lmpblas_binary80_opt $(DYLD)
endif

if IS_MINGW
binary80cxxflags += -I$(DLFCN_WIN32_INCLUDEDIR)
binary80_libdepends += -L$(DLFCN_WIN32_LIBDIR) -ldl
binary80opt_libdepends += -L$(DLFCN_WIN32_LIBDIR) -ldl
endif

Rpotrf_binary80_opt_SOURCES= Rpotrf.cpp
Rpotrf_binary80_opt_CXXFLAGS= $(binary80cxxflags)
Rpotrf_binary80_opt_LDFLAGS= $(binary80opt_libdepends)

Rpotrf_binary80_SOURCES= Rpotrf.cpp
Rpotrf_binary80_CXXFLAGS= $(binary80cxxflags)
Rpotrf_binary80_LDFLAGS= $(binary80_libdepends)

Rpotf2_binary80_opt_SOURCES= Rpotf2.cpp
Rpotf2_binary80_opt_CXXFLAGS= $(binary80cxxflags)
Rpotf2_binary80_opt_LDFLAGS= $(binary80opt_libdepends)

Rpotf2_binary80_SOURCES= Rpotf2.cpp
Rpotf2_binary80_CXXFLAGS= $(binary80cxxflags)
Rpotf2_binary80_LDFLAGS= $(binary80_libdepends)

Rgetrf_binary80_opt_SOURCES= Rgetrf.cpp
Rgetrf_binary80_opt_CXXFLAGS= $(binary80cxxflags)
Rgetrf_binary80_opt_LDFLAGS= $(binary80opt_libdepends)

Rgetrf_binary80_SOURCES= Rgetrf.cpp
Rgetrf_binary80_CXXFLAGS= $(binary80cxxflags)
Rgetrf_binary80_LDFLAGS= $(binary80_libdepends)


