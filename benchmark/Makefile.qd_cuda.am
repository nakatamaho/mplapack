bench_PROGRAMS += \
Rgemm.qd_cuda_total  \
Rpotrf.qd_cuda_total \
Rgetrf.qd_cuda_total \
Rfactor.qd_cuda_total

# libmplapack_qd_opt_cuda: Rgemm on the GPU (naive / tiled / Winograd /
# Ozaki, see mpblas/optimized/common/README.md), everything else on the CPU.
qd_cuda_cxxflags   = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) $(CUDA_CFLAGS) -DMPLAPACK_BUILD_WITH_QD $(DD_CXXFLAGS)
qd_cuda_libdepends = -L$(top_builddir)/mpblas/optimized/qd/cuda -lmplapack_qd_opt_cuda \
                     $(CUDA_LDFLAGS) -lcublas -lcudart \
                     -L$(QD_LIBDIR) -lqd $(DYLD)
qd_cuda_link       = $(LIBTOOL) --mode=link $(CXX) -o $@ $(CUDA_LDFLAGS) $(CUDA_LIBS) $(qd_cuda_libdepends) $(OPENMP_CXXFLAGS)

Rfactor_qd_cuda_total_SOURCES = Rfactor.cpp
Rfactor_qd_cuda_total_LINK = $(qd_cuda_link)
Rfactor_qd_cuda_total_CXXFLAGS = $(qd_cuda_cxxflags) -DMPLAPACK_FACTOR_CUDA

Rgemm_qd_cuda_total_SOURCES=   Rgemm.cpp
Rgemm_qd_cuda_total_LINK=      $(qd_cuda_link)
Rgemm_qd_cuda_total_CXXFLAGS=  $(qd_cuda_cxxflags)

Rpotrf_qd_cuda_total_SOURCES=  Rpotrf.cpp
Rpotrf_qd_cuda_total_LINK=     $(qd_cuda_link)
Rpotrf_qd_cuda_total_CXXFLAGS= $(qd_cuda_cxxflags)

Rgetrf_qd_cuda_total_SOURCES=  Rgetrf.cpp
Rgetrf_qd_cuda_total_LINK=     $(qd_cuda_link)
Rgetrf_qd_cuda_total_CXXFLAGS= $(qd_cuda_cxxflags)

# Rkernel_bench.qd_cuda_kernel: the qd GPU kernels of the factorizations,
# solvers and inverses alone, on device-resident matrices (CUDA events), built
# from the library's internal headers (Rkernel_bench_qd_cuda.cu);
# Rkernel_bench.qd_opt: the same routines of libmplapack_qd_opt on the
# CPU.  Driven by kernel_bench.py, see README.kernel_bench.md.
bench_PROGRAMS += Rkernel_bench.qd_cuda_kernel Rkernel_bench.qd_opt
Rkernel_bench_qd_cuda_kernel_SOURCES = Rkernel_bench_qd_cuda.cu
nodist_EXTRA_Rkernel_bench_qd_cuda_kernel_SOURCES = kernel_bench_cxx_link.cpp
Rkernel_bench_qd_cuda_kernel_LINK = $(LIBTOOL) --mode=link $(CXX) -o $@
Rkernel_bench_qd_cuda_kernel_LDADD = -L$(top_builddir)/mpblas/optimized/qd -lmplapack_qd_opt \
                     $(CUDA_LDFLAGS) -lcublas -lcudart -L$(QD_LIBDIR) -lqd $(DYLD) $(OPENMP_CXXFLAGS)
Rkernel_bench_qd_opt_SOURCES = Rkernel_bench.cpp
Rkernel_bench_qd_opt_CXXFLAGS = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) -DMPLAPACK_BUILD_WITH_QD $(DD_CXXFLAGS)
Rkernel_bench_qd_opt_LDFLAGS = -L$(top_builddir)/mpblas/optimized/qd -lmplapack_qd_opt -L$(QD_LIBDIR) -lqd $(DYLD)
