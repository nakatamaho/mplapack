bench_PROGRAMS += \
Rgemm.td_cuda_total  \
Rpotrf.td_cuda_total \
Rgetrf.td_cuda_total \
Rfactor.td_cuda_total

# libmplapack_td_opt_cuda: Rgemm on the GPU (naive / tiled / Winograd /
# Ozaki, see mpblas/optimized/common/README.md), everything else on the CPU.
td_cuda_cxxflags   = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) $(CUDA_CFLAGS) -DMPLAPACK_BUILD_WITH_TD $(DD_CXXFLAGS)
td_cuda_libdepends = -L$(top_builddir)/mpblas/optimized/td/cuda -lmplapack_td_opt_cuda \
                     $(CUDA_LDFLAGS) -lcublas -lcudart \
                     -L$(QD_LIBDIR) -lqd $(DYLD)
td_cuda_link       = $(LIBTOOL) --mode=link $(CXX) -o $@ $(CUDA_LDFLAGS) $(CUDA_LIBS) $(td_cuda_libdepends) $(OPENMP_CXXFLAGS)

Rfactor_td_cuda_total_SOURCES = Rfactor.cpp
Rfactor_td_cuda_total_LINK = $(td_cuda_link)
Rfactor_td_cuda_total_CXXFLAGS = $(td_cuda_cxxflags) -DMPLAPACK_FACTOR_CUDA

Rgemm_td_cuda_total_SOURCES=   Rgemm.cpp
Rgemm_td_cuda_total_LINK=      $(td_cuda_link)
Rgemm_td_cuda_total_CXXFLAGS=  $(td_cuda_cxxflags)

Rpotrf_td_cuda_total_SOURCES=  Rpotrf.cpp
Rpotrf_td_cuda_total_LINK=     $(td_cuda_link)
Rpotrf_td_cuda_total_CXXFLAGS= $(td_cuda_cxxflags)

Rgetrf_td_cuda_total_SOURCES=  Rgetrf.cpp
Rgetrf_td_cuda_total_LINK=     $(td_cuda_link)
Rgetrf_td_cuda_total_CXXFLAGS= $(td_cuda_cxxflags)

# Rkernel_bench.td_cuda_kernel: the td GPU kernels of the factorizations,
# solvers and inverses alone, on device-resident matrices (CUDA events), built
# from the library's internal headers (Rkernel_bench_td_cuda.cu);
# Rkernel_bench.td_opt: the same routines of libmplapack_td_opt on the
# CPU.  Driven by kernel_bench.py, see README.kernel_bench.md.
bench_PROGRAMS += Rkernel_bench.td_cuda_kernel Rkernel_bench.td_opt
Rkernel_bench_td_cuda_kernel_SOURCES = Rkernel_bench_td_cuda.cu
nodist_EXTRA_Rkernel_bench_td_cuda_kernel_SOURCES = kernel_bench_cxx_link.cpp
Rkernel_bench_td_cuda_kernel_LINK = $(LIBTOOL) --mode=link $(CXX) -o $@
Rkernel_bench_td_cuda_kernel_LDADD = -L$(top_builddir)/mpblas/optimized/td -lmplapack_td_opt \
                     $(CUDA_LDFLAGS) -lcublas -lcudart -L$(QD_LIBDIR) -lqd $(DYLD) $(OPENMP_CXXFLAGS)
Rkernel_bench_td_opt_SOURCES = Rkernel_bench.cpp
Rkernel_bench_td_opt_CXXFLAGS = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) -DMPLAPACK_BUILD_WITH_TD $(DD_CXXFLAGS)
Rkernel_bench_td_opt_LDFLAGS = -L$(top_builddir)/mpblas/optimized/td -lmplapack_td_opt -L$(QD_LIBDIR) -lqd $(DYLD)
