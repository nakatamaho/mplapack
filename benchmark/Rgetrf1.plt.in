set xlabel font "Helvetica,20"
set ylabel font "Helvetica,20"
set key font   "Helvetica,16"
set title font "Helvetica,20"
set title "Rgetrf on %%MODELNAME%%"
set xlabel "Dimension"
set ylabel "MFLOPS"
set key above
set terminal pdf

plot \
"log.Rgetrf.binary128"     using 1:3 title 'binary128'              with lines linewidth 1, \
"log.Rgetrf.binary128_opt" using 1:3 title 'binary128 (OpenMP)'     with lines linewidth 1, \
"log.Rgetrf.binary80"      using 1:3 title 'binary80'               with lines linewidth 1, \
"log.Rgetrf.binary80_opt"  using 1:3 title 'binary80 (OpenMP)'      with lines linewidth 1, \
"log.Rgetrf.dd"            using 1:3 title 'double-double'           with lines linewidth 1, \
"log.Rgetrf.dd_opt"        using 1:3 title 'double-double (OpenMP)'  with lines linewidth 1
