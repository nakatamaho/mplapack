#!/bin/sh
# go.Rgemm_opencl.sh — OpenCL benchmark runner for Rgemm
# %%CPU_OS_DETECTION_SH%% and %%CC_TAG%% are replaced:
#   - at "make" time   : builddir paths
#   - at "make install": installed paths
# Never edit the installed copy; edit go.Rgemm_opencl.sh.in instead.

TIMEOUT=7200

# ---------------------------------------------------------------------------
# Self-location: works both in builddir and after install
# ---------------------------------------------------------------------------
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# ---------------------------------------------------------------------------
# Platform detection (one call for OUTDIR and MODELNAME)
# Field 1: directory-safe CPU tag   (e.g. Ryzen_Threadripper_3970X)
# Field 2: OS identifier            (e.g. ubuntu2204)
# Field 3: human-readable CPU name  (e.g. AMD Ryzen Threadripper 3970X)
# ---------------------------------------------------------------------------
_DETECTION=$(sh "%%CPU_OS_DETECTION_SH%%")
_CPU_NORM=$(printf '%s' "${_DETECTION}" | cut -d'|' -f1)
_OS_ID=$(   printf '%s' "${_DETECTION}" | cut -d'|' -f2)
MODELNAME=$( printf '%s' "${_DETECTION}" | cut -d'|' -f3)
MODELNAME="${MODELNAME:-unknown}"

CC_TAG="%%CC_TAG%%"
OUTDIR="${_CPU_NORM}-${_OS_ID}-${CC_TAG}"
OUTPATH="${SCRIPT_DIR}/results/${OUTDIR}"
mkdir -p "${OUTPATH}"

# ---------------------------------------------------------------------------
# Library path prefix (macOS vs Linux)
# ---------------------------------------------------------------------------
if [ "$(uname)" = "Darwin" ]; then
    LDPATHPREFIX="DYLD_LIBRARY_PATH=%%PREFIX%%/lib"
    SED=gsed
else
    LDPATHPREFIX="LD_LIBRARY_PATH=%%PREFIX%%/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    SED=sed
fi

# NVIDIA CUDA containers can expose libnvidia-opencl.so.1 without installing
# /etc/OpenCL/vendors/nvidia.icd. In that case ocl-icd has no platform to load.
if [ -z "${OCL_ICD_VENDORS:-}" ] && [ ! -e /etc/OpenCL/vendors/nvidia.icd ]; then
    for _lib in /usr/lib/x86_64-linux-gnu/libnvidia-opencl.so.1 /usr/lib64/libnvidia-opencl.so.1; do
        if [ -e "${_lib}" ]; then
            ICD_DIR="${OUTPATH}/opencl-vendors"
            mkdir -p "${ICD_DIR}"
            printf "%s\n" "libnvidia-opencl.so.1" > "${ICD_DIR}/nvidia.icd"
            OCL_ICD_VENDORS="${ICD_DIR}"
            export OCL_ICD_VENDORS
            break
        fi
    done
fi

# ---------------------------------------------------------------------------
# Helper: run one binary, save log under OUTPATH
# ---------------------------------------------------------------------------
run_bench() {
    _bin="${SCRIPT_DIR}/$1"; shift
    _log="${OUTPATH}/log.$(basename "${_bin}")"
    if [ ! -x "${_bin}" ]; then
        echo "SKIP (not found): ${_bin}" >&2
        return 0
    fi
    echo "RUN: ${_bin} $*"
    env ${LDPATHPREFIX} timeout ${TIMEOUT} "${_bin}" "$@" > "${_log}" 2>&1
}

# ---------------------------------------------------------------------------
# Binary128 OpenCL benchmarks
# ---------------------------------------------------------------------------
run_bench Rgemm.binary128_opencl_total  -NOCHECK -LOOPS 3
run_bench Rgemm.binary128_opencl_kernel -NOCHECK -LOOPS 3

OPENCL_LOG="${OUTPATH}/log.Rgemm.binary128_opencl_total"
if [ ! -s "${OPENCL_LOG}" ]; then
    echo "SKIP plot (no OpenCL benchmark log): ${OPENCL_LOG}" >&2
    echo "Done. Results: ${OUTPATH}"
    exit 0
fi

# ---------------------------------------------------------------------------
# Generate gnuplot script, render PDF
# ---------------------------------------------------------------------------
$SED -e "s/%%MODELNAME%%/${MODELNAME}/g" \
    "${SCRIPT_DIR}/Rgemm_opencl.plt.in" > "${OUTPATH}/Rgemm_opencl.plt"
(cd "${OUTPATH}" && gnuplot "Rgemm_opencl.plt" > "Rgemm_opencl.pdf")

echo "Done. Results: ${OUTPATH}"
