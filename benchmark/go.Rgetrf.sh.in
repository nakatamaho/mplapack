#!/bin/bash

TIMEOUT=7200

if [ "$(uname)" = "Darwin" ]; then
    LDPATHPREFIX="DYLD_LIBRARY_PATH=%%PREFIX%%/lib"
else
    LDPATHPREFIX="LD_LIBRARY_PATH=%%PREFIX%%/lib:${LD_LIBRARY_PATH}"
fi

# double-precision reference / OpenBLAS
env $LDPATHPREFIX timeout $TIMEOUT ./dgetrf_ref      -TOTALSTEPS 500 -STEPM 7 -STEPN 7 >& log.dgetrf.ref
env $LDPATHPREFIX timeout $TIMEOUT ./dgetrf_openblas -TOTALSTEPS 500 -STEPM 7 -STEPN 7 >& log.dgetrf.openblas

# fixed-size multiple-precision backends
for _mplib in binary80 dd double binary128; do
    env $LDPATHPREFIX timeout $TIMEOUT ./Rgetrf.${_mplib}_opt -NOCHECK -TOTALSTEPS 200 -STEPM 5 -STEPN 5 >& log.Rgetrf.${_mplib}_opt
    env $LDPATHPREFIX timeout $TIMEOUT ./Rgetrf.${_mplib}     -NOCHECK -TOTALSTEPS 200 -STEPM 5 -STEPN 5 >& log.Rgetrf.${_mplib}
done

# arbitrary-precision backends
for _mplib in mpfr gmp qd; do
    env $LDPATHPREFIX timeout $TIMEOUT ./Rgetrf.${_mplib}_opt -NOCHECK -TOTALSTEPS 200 -STEPM 5 -STEPN 5 >& log.Rgetrf.${_mplib}_opt
    env $LDPATHPREFIX timeout $TIMEOUT ./Rgetrf.${_mplib}     -NOCHECK -TOTALSTEPS 200 -STEPM 5 -STEPN 5 >& log.Rgetrf.${_mplib}
done

# detect CPU model name and sed command
if [ "$(uname)" = "Linux" ]; then
    MODELNAME=$(lscpu | grep 'Model name' | uniq | awk '{for(i=3;i<=NF;i++) printf $i FS}')
    SED=sed
elif [ "$(uname)" = "Darwin" ]; then
    MODELNAME=$(sysctl machdep.cpu.brand_string | awk '{for(i=2;i<=NF;i++) printf $i FS}')
    SED=gsed
else
    MODELNAME="unknown"
    SED=sed
fi

for i in 1 2 3; do
    $SED -e "s/%%MODELNAME%%/$MODELNAME/g" Rgetrf${i}.plt.in > Rgetrf${i}.plt
    gnuplot Rgetrf${i}.plt > Rgetrf${i}.pdf
done
