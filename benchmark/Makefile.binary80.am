Rsyrk_binary80_opt_LDFLAGS=  $(binary80opt_libdepends)

# LAPACK benchmarks
Rpotrf_binary80_SOURCES=      Rpotrf.cpp
Rpotrf_binary80_CXXFLAGS=     $(binary80cxxflags)
Rpotrf_binary80_LDFLAGS=      $(binary80_libdepends)

Rpotrf_binary80_opt_SOURCES=  Rpotrf.cpp
