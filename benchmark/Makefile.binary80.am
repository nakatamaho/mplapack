Rcopy_binary80_CXXFLAGS=     $(binary80cxxflags)
Rcopy_binary80_LDFLAGS=      $(binary80_libdepends)

Rcopy_binary80_opt_SOURCES=  Rcopy.cpp
Rcopy_binary80_opt_CXXFLAGS= $(binary80cxxflags)
Rcopy_binary80_opt_LDFLAGS=  $(binary80opt_libdepends)

Rdot_binary80_SOURCES=       Rdot.cpp
Rdot_binary80_CXXFLAGS=      $(binary80cxxflags)
Rdot_binary80_LDFLAGS=       $(binary80_libdepends)

Rdot_binary80_opt_SOURCES=   Rdot.cpp
Rdot_binary80_opt_CXXFLAGS=  $(binary80cxxflags)
Rdot_binary80_opt_LDFLAGS=   $(binary80opt_libdepends)

Rgemm_binary80_SOURCES=      Rgemm.cpp
