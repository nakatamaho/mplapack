binary128opt_opencl_cxxflags = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -D___MPLAPACK_BUILD_WITH_BINARY128___ $(OPENCL_CFLAGS)
binary128opt_opencl_libdepends = $(binary128lapack_libdepends) -L$(top_builddir)/mpblas/optimized/binary128/opencl -lmpblas_binary128_opt_opencl -L$(top_builddir)/mpblas/optimized/binary128 -lmpblas_binary128_opt $(OPENCL_LDFLAGS) $(OPENCL_LIBS) $(DYLD)
binary128opt_opencl_link = $(LIBTOOL) --mode=link $(CXX) -o $@ $(OPENCL_LDFLAGS) $(OPENCL_LIBS) $(binary128opt_opencl_libdepends) $(OPENMP_CXXFLAGS)


Rgemm_binary128_opencl_total_SOURCES = Rgemm.cpp
Rgemm_binary128_opencl_total_LINK = $(binary128opt_opencl_link)
Rgemm_binary128_opencl_total_CXXFLAGS = $(binary128opt_opencl_cxxflags)
