# Rgemm.dd_cuda_total runs Rgemm of libmplapack_dd_opt_cuda (the GPU kernels
# of mpblas/optimized/common, or the former ones with
# MPLAPACK_DD_CUDA_LEGACY=1); Rgemm.dd_cuda_kernel times the former kernels
# alone on device-resident matrices.
bench_PROGRAMS += \
Rgemm.dd_cuda_total  \
Rgemm.dd_cuda_kernel \
Rsyrk.dd_cuda_total  \
Rsyrk.dd_cuda_kernel \
Rpotrf.dd_cuda_total \
Rgetrf.dd_cuda_total

dd_cuda_cxxflags   = -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) $(CUDA_CFLAGS) -DMPLAPACK_BUILD_WITH_DD $(DD_CXXFLAGS)
dd_cuda_libdepends = -L$(top_builddir)/mpblas/optimized/dd/cuda -lmplapack_dd_opt_cuda \
                     $(CUDA_LDFLAGS) -lcublas -lcudart \
                     -L$(QD_LIBDIR) -lqd $(DYLD)
dd_cuda_link       = $(LIBTOOL) --mode=link $(CXX) -o $@ $(CUDA_LDFLAGS) $(CUDA_LIBS) $(dd_cuda_libdepends) $(OPENMP_CXXFLAGS)

# BLAS benchmarks
Rgemm_dd_cuda_total_SOURCES=   Rgemm.cpp
Rgemm_dd_cuda_total_LINK=      $(dd_cuda_link)
Rgemm_dd_cuda_total_CXXFLAGS=  $(dd_cuda_cxxflags)

Rgemm_dd_cuda_kernel_SOURCES=  Rgemm_dd_cuda_kernel.cpp
Rgemm_dd_cuda_kernel_LINK=     $(dd_cuda_link)
Rgemm_dd_cuda_kernel_CXXFLAGS= $(dd_cuda_cxxflags)

Rsyrk_dd_cuda_total_SOURCES=   Rsyrk.cpp
Rsyrk_dd_cuda_total_LINK=      $(dd_cuda_link)
Rsyrk_dd_cuda_total_CXXFLAGS=  $(dd_cuda_cxxflags)

Rsyrk_dd_cuda_kernel_SOURCES=  Rsyrk_dd_cuda_kernel.cpp
Rsyrk_dd_cuda_kernel_LINK=     $(dd_cuda_link)
Rsyrk_dd_cuda_kernel_CXXFLAGS= $(dd_cuda_cxxflags)

# LAPACK benchmarks
bench_PROGRAMS += Rfactor.dd_cuda_total
Rfactor_dd_cuda_total_SOURCES = Rfactor.cpp
Rfactor_dd_cuda_total_LINK = $(dd_cuda_link)
Rfactor_dd_cuda_total_CXXFLAGS = $(dd_cuda_cxxflags) -DMPLAPACK_FACTOR_CUDA

Rpotrf_dd_cuda_total_SOURCES=  Rpotrf.cpp
Rpotrf_dd_cuda_total_LINK=     $(dd_cuda_link)
Rpotrf_dd_cuda_total_CXXFLAGS= $(dd_cuda_cxxflags)

Rgetrf_dd_cuda_total_SOURCES=  Rgetrf.cpp
Rgetrf_dd_cuda_total_LINK=     $(dd_cuda_link)
Rgetrf_dd_cuda_total_CXXFLAGS= $(dd_cuda_cxxflags)

# Rkernel_bench.dd_cuda_kernel: the dd GPU kernels of the factorizations,
# solvers and inverses alone, on device-resident matrices (CUDA events), built
# from the library's internal headers (Rkernel_bench_dd_cuda.cu);
# Rkernel_bench.dd_opt: the same routines of libmplapack_dd_opt on the
# CPU.  Driven by kernel_bench.py, see README.kernel_bench.md.
bench_PROGRAMS += Rkernel_bench.dd_cuda_kernel Rkernel_bench.dd_opt
Rkernel_bench_dd_cuda_kernel_SOURCES = Rkernel_bench_dd_cuda.cu
nodist_EXTRA_Rkernel_bench_dd_cuda_kernel_SOURCES = kernel_bench_cxx_link.cpp
Rkernel_bench_dd_cuda_kernel_LINK = $(LIBTOOL) --mode=link $(CXX) -o $@
Rkernel_bench_dd_cuda_kernel_LDADD = -L$(top_builddir)/mpblas/optimized/dd -lmplapack_dd_opt \
                     $(CUDA_LDFLAGS) -lcublas -lcudart -L$(QD_LIBDIR) -lqd $(DYLD) $(OPENMP_CXXFLAGS)
Rkernel_bench_dd_opt_SOURCES = Rkernel_bench.cpp
Rkernel_bench_dd_opt_CXXFLAGS = $(OPENMP_CXXFLAGS) -I$(top_srcdir)/include -I$(QD_INCLUDEDIR) -DMPLAPACK_BUILD_WITH_DD $(DD_CXXFLAGS)
Rkernel_bench_dd_opt_LDFLAGS = -L$(top_builddir)/mpblas/optimized/dd -lmplapack_dd_opt -L$(QD_LIBDIR) -lqd $(DYLD)
