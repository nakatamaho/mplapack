#!/usr/bin/env bash
set -euo pipefail

# Resolve repo root (works when executed inside a git working tree)
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
  echo "Error: not inside a git repository. cd into mplapack repo (or set FABLE_REPO_ROOT)." >&2
  exit 1
fi

# If fable_org is under repo_root/fable_org, PYTHONPATH must include repo_root
export PYTHONPATH="${repo_root}:${PYTHONPATH:-}"

py="${PYTHON:-python3}"

if [[ $# -lt 1 ]]; then
  echo "Usage: fable-cout <input_fortran_file> [-- extra args to cout]" >&2
  exit 2
fi

input="$1"
shift

exec "${py}" -m fable_org.command_line.cout "${input}" "$@"
