# Generated by misc/gen_backend_makefiles.py from misc/backend_makefiles/%%template%%.
# Do not edit; change the template, misc/backend_makefiles/backends.conf or backends.txt.
#CTBSV, CTPSV might have bugs or intrinsically inaccurate
#Rnrm2 should be checked more
%%block test_check_programs%%
mpblas_%%b%%_smoke_WRAPPERS = $(mpblas_%%b%%_smoke_TESTS:%=run_%.sh)
mpblas_%%b%%_test_WRAPPERS = $(mpblas_%%b%%_test_PROGRAMS:%=run_%.sh)
TESTS = $(mpblas_%%b%%_smoke_WRAPPERS)
TEST_EXTENSIONS = .sh
SH_LOG_COMPILER = $(SHELL)
AM_TESTS_ENVIRONMENT = \
	LOG_COMPILER='$(LOG_COMPILER)'; export LOG_COMPILER; \
	EXEEXT='$(EXEEXT)'; export EXEEXT;
CLEANFILES = $(mpblas_%%b%%_smoke_WRAPPERS) $(mpblas_%%b%%_test_WRAPPERS)
.PHONY: check-all
check-all: $(mpblas_%%b%%_test_PROGRAMS) $(mpblas_%%b%%_test_WRAPPERS)
	$(MAKE) $(AM_MAKEFLAGS) check TESTS="$(mpblas_%%b%%_test_WRAPPERS)"

run_%.sh: Makefile
	$(AM_V_GEN)printf '%s\n' '#!/bin/sh' > $@
	$(AM_V_at)printf '%s\n' '$${LOG_COMPILER} ./$*$${EXEEXT}' >> $@
	$(AM_V_at)chmod +x $@
