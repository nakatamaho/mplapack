mpblas_%%b%%_testdir = $(prefix)/lib/$(target)/mplapack/test/compare/%%b%%
mplibs=%%test_mplibs%%
refblas=-L$(top_builddir)/external/i/LAPACK/lib -lblas $(FCLIBS)
test_cxxflags = %%test_cxxflags%%
test_srcdepends = ../common/xerbla.cpp ../common/mplapack.test.cpp ../common/Mxerbla.override.cpp

if IS_MACOS
mplibs+=-Wl,-flat_namespace,-undefined,dynamic_lookup
endif

if IS_MINGW
$(check_PROGRAMS): libmxerbla_override.la
lib_LTLIBRARIES = libmxerbla_override.la
libmxerbla_override_la_CPPFLAGS = $(GMPFRXX_MKII_CPPFLAGS) -I$(top_srcdir)/include -DMPLAPACK_BUILD_WITH_%%B%%
libmxerbla_override_la_SOURCES = ../common/Mxerbla.override.cpp
libmxerbla_override_la_LDFLAGS = -no-undefined
libdepends = -Wl,--allow-multiple-definition -Wl,--whole-archive,.libs/libmxerbla_override.a,$(top_builddir)/mplapack/reference/.libs/libmplapack_%%b%%.a%%oracle_archive%%,--no-whole-archive
opt_libdepends = -Wl,--allow-multiple-definition -Wl,--whole-archive,.libs/libmxerbla_override.a,$(top_builddir)/mpblas/optimized/%%b%%/.libs/libmplapack_%%b%%_opt.a%%oracle_archive%%,--no-whole-archive
else
libdepends = -L$(top_builddir)/mplapack/reference -lmplapack_%%b%%%%oracle_lib%%
opt_libdepends = -L$(top_builddir)/mpblas/optimized/%%b%% -lmplapack_%%b%%_opt%%oracle_opt_lib%%
endif

