# Generated by misc/gen_backend_makefiles.py from misc/backend_makefiles/%%template%%.
# Do not edit; change the template, misc/backend_makefiles/backends.conf or backends.txt.
bench_PROGRAMS += \
Raxpy.%%b%%  Raxpy.%%b%%_opt  \
Rcopy.%%b%%  Rcopy.%%b%%_opt  \
Rdot.%%b%%   Rdot.%%b%%_opt   \
Rgemm.%%b%%  Rgemm.%%b%%_opt  \
Rgemv.%%b%%  Rgemv.%%b%%_opt  \
Rsyrk.%%b%%  Rsyrk.%%b%%_opt  \
Rpotrf.%%b%% Rpotrf.%%b%%_opt \
Rpotf2.%%b%% Rpotf2.%%b%%_opt \
Rgetrf.%%b%% Rgetrf.%%b%%_opt

%%block bench_note%%
%%b%%cxxflags = %%bench_cxxflags%%
%%b%%lapack_libdepends = -L$(top_builddir)/mplapack/reference -lmplapack_%%b%%
%%block bench_libdepends%%

if IS_MINGW
%%b%%cxxflags       += -I$(DLFCN_WIN32_INCLUDEDIR)
%%b%%_libdepends    += -L$(DLFCN_WIN32_LIBDIR) -ldl
%%b%%opt_libdepends += -L$(DLFCN_WIN32_LIBDIR) -ldl
endif

# BLAS benchmarks
Raxpy_%%b%%_SOURCES=      Raxpy.cpp
Raxpy_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Raxpy_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Raxpy_%%b%%_opt_SOURCES=  Raxpy.cpp
Raxpy_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Raxpy_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rcopy_%%b%%_SOURCES=      Rcopy.cpp
Rcopy_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rcopy_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rcopy_%%b%%_opt_SOURCES=  Rcopy.cpp
Rcopy_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rcopy_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rdot_%%b%%_SOURCES=       Rdot.cpp
Rdot_%%b%%_CXXFLAGS=      $(%%b%%cxxflags)
Rdot_%%b%%_LDFLAGS=       $(%%b%%_libdepends)

Rdot_%%b%%_opt_SOURCES=   Rdot.cpp
Rdot_%%b%%_opt_CXXFLAGS=  $(%%b%%cxxflags)
Rdot_%%b%%_opt_LDFLAGS=   $(%%b%%opt_libdepends)

Rgemm_%%b%%_SOURCES=      Rgemm.cpp
Rgemm_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rgemm_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rgemm_%%b%%_opt_SOURCES=  Rgemm.cpp
Rgemm_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rgemm_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rgemv_%%b%%_SOURCES=      Rgemv.cpp
Rgemv_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rgemv_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rgemv_%%b%%_opt_SOURCES=  Rgemv.cpp
Rgemv_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rgemv_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rsyrk_%%b%%_SOURCES=      Rsyrk.cpp
Rsyrk_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rsyrk_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rsyrk_%%b%%_opt_SOURCES=  Rsyrk.cpp
Rsyrk_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rsyrk_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

# LAPACK benchmarks
Rpotrf_%%b%%_SOURCES=      Rpotrf.cpp
Rpotrf_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rpotrf_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rpotrf_%%b%%_opt_SOURCES=  Rpotrf.cpp
Rpotrf_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rpotrf_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rpotf2_%%b%%_SOURCES=      Rpotf2.cpp
Rpotf2_%%b%%_CXXFLAGS=     $(%%b%%cxxflags)
Rpotf2_%%b%%_LDFLAGS=      $(%%b%%_libdepends)

Rpotf2_%%b%%_opt_SOURCES=  Rpotf2.cpp
Rpotf2_%%b%%_opt_CXXFLAGS= $(%%b%%cxxflags)
Rpotf2_%%b%%_opt_LDFLAGS=  $(%%b%%opt_libdepends)

Rgetrf_%%b%%_SOURCES=      Rgetrf.cpp
