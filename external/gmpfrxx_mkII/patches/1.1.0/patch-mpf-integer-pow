+inline mpf_class pow(const mpf_class& base, std::uint64_t exponent)
+{
+    const mp_bitcnt_t precision = base.precision();
+    mpf_class result = mpf_math_detail::make_ui(1, precision);
+    mpf_class factor = mpf_math_detail::set_prec_copy(base, precision);
+
+    while (exponent != 0) {
+        if ((exponent & 1U) != 0) {
+            result = mpf_math_detail::mul(result, factor, precision);
+        }
+        exponent >>= 1U;
+        if (exponent != 0) {
+            factor = mpf_math_detail::mul(factor, factor, precision);
+        }
+    }
+
+    return result;
+}
+
+inline mpf_class pow(const mpf_class& base, std::int64_t exponent)
+{
+    if (exponent >= 0) {
+        return pow(base, static_cast<std::uint64_t>(exponent));
+    }
+    const std::uint64_t magnitude = static_cast<std::uint64_t>(-(exponent + 1)) + 1U;
+    const mp_bitcnt_t precision = base.precision();
+    return mpf_math_detail::div(
+        mpf_math_detail::make_ui(1, precision),
+        pow(base, magnitude),
+        precision);
+}
