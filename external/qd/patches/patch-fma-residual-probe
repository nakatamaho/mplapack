+function(qd3_fma_residual_source candidate out_var)
+  set(extra_include "")
+  if(candidate STREQUAL "ibm")
+    set(extra_include "#include <builtins.h>")
+    set(fms_expr "__fmsub(a, b, p)")
+  elseif(candidate STREQUAL "gnu")
+    set(fms_expr "__builtin_fma(a, b, -p)")
+  elseif(candidate STREQUAL "ia64")
+    set(fms_expr "_Asm_fms(2, a, b, p)")
+  elseif(candidate STREQUAL "c99")
+    set(fms_expr "fma(a, b, -p)")
+  elseif(candidate STREQUAL "compiler")
+    set(fms_expr "((a) * (b) - (p))")
+  else()
+    message(FATAL_ERROR "Unknown FMA candidate '${candidate}'")
+  endif()
+
+  set(src [[
+#include <cmath>
+@extra_include@
 
+static const double qd_splitter = 134217729.0;
+static const double qd_split_thresh = 6.69692879491417e+299;
+
+static void qd_split(double a, double &hi, double &lo) {
+  double temp;
+  if (a > qd_split_thresh || a < -qd_split_thresh) {
+    a *= 3.7252902984619140625e-09;
+    temp = qd_splitter * a;
+    hi = temp - (temp - a);
+    lo = a - hi;
+    hi *= 268435456.0;
+    lo *= 268435456.0;
+  } else {
+    temp = qd_splitter * a;
+    hi = temp - (temp - a);
+    lo = a - hi;
+  }
+}
+
+static double qd_split_prod_error(double a, double b, double p) {
+  double a_hi, a_lo, b_hi, b_lo;
+  qd_split(a, a_hi, a_lo);
+  qd_split(b, b_hi, b_lo);
+  volatile double hi_hi = a_hi * b_hi;
+  volatile double hi_lo = a_hi * b_lo;
+  volatile double lo_hi = a_lo * b_hi;
+  volatile double lo_lo = a_lo * b_lo;
+  return ((hi_hi - p) + hi_lo + lo_hi) + lo_lo;
+}
+
+static double qd_candidate_fms(double a, double b, double p) {
+  return @fms_expr@;
+}
+
+int main() {
+  const double cases[][2] = {
+    {0x1.ffffffffffffep-1, 0x1.fffffffffffffp-1},
+    {0x1.ffffffffffffep-1, 0x1.6a09e667f3bcdp+0},
+    {0x1.6a09e667f3bcdp+0, 0x1.6a09e667f3bcdp+0},
+    {0x1.5bf0a8b145769p+1, 0x1.ffffffffffffep-1}
+  };
+
+  for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+    const double a = cases[i][0];
+    const double b = cases[i][1];
+    const double p = a * b;
+    const double candidate = qd_candidate_fms(a, b, p);
+    const double reference = qd_split_prod_error(a, b, p);
+    if (!std::isfinite(candidate) || candidate != reference) {
+      return 1;
+    }
+  }
+  return 0;
+}
+]])
