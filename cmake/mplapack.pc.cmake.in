prefix=@PC_PREFIX@
exec_prefix=${prefix}
libdir=@PC_LIBDIR@
includedir=@PC_INCLUDEDIR@

Name: @PC_NAME@
Description: @PC_DESCRIPTION@ (@PC_FLAVOR@ flavor)
Version: @PC_VERSION@
Requires: @PC_REQUIRES@
Requires.private: @PC_REQUIRES_PRIVATE@
Libs.private: @PC_LIBS_PRIVATE@
Libs: -L${libdir} -l@PC_NAME@ @PC_LIBS_EXTRA@
Cflags: -I${includedir} @PC_CFLAGS_EXTRA@
