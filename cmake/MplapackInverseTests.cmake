# Direct inverse entry tests (CPU reference library + production entry text).
if(MPLAPACK_BUILD_TESTS)
  foreach(_b dd td qd)
    if(NOT TARGET mplapack_${_b}_opt)
      continue()
    endif()
    foreach(_variant host device)
      if(_variant STREQUAL "device" AND NOT TARGET mplapack_${_b}_opt_cuda)
        continue()
      endif()
      set(_name ${_b}_cuda_inverse_${_variant})
      set(_exe ${_name}_test)
      set(_common "${PROJECT_SOURCE_DIR}/mplapack/optimized/common/test")
      if(_variant STREQUAL "host")
        add_executable(${_exe} "${_common}/Rinverse_gpu_test.cpp")
        target_compile_definitions(${_exe} PRIVATE MPLAPACK_GEMM_CUDA_HOST_EMULATION)
      else()
        add_executable(${_exe} "${_common}/Rinverse_gpu_device_test.cu")
        target_link_libraries(${_exe} PRIVATE CUDA::cudart)
        set_target_properties(${_exe} PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES "${MPLAPACK_CUDA_ARCHITECTURES}")
      endif()
      target_link_libraries(${_exe} PRIVATE mplapack_${_b}_opt)
      mplapack_configure_dd_arithmetic(${_exe})
      target_compile_options(${_exe} PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:-fmad=false;-Xcompiler=-ffp-contract=off>")
      if(UNIX AND NOT APPLE)
        target_link_options(${_exe} PRIVATE "-Wl,--disable-new-dtags")
      endif()
      add_test(NAME ${_name} COMMAND ${_exe})
      add_test(NAME ${_name}_quick COMMAND ${_exe} --quick)
      add_test(NAME ${_name}_fast_quick COMMAND ${_exe} --quick)
      set_tests_properties(${_name} ${_name}_quick PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=1")
      set_tests_properties(${_name}_fast_quick PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=1;MPLAPACK_LAPACK_FAST=1")
    endforeach()
  endforeach()
endif()
