# CPU-only oracles, direct resident engines and public CPU-fallback regressions.
if(MPLAPACK_BUILD_TESTS)
  foreach(_b dd td qd mpfr)
    if(NOT TARGET mplapack_${_b}_opt)
      continue()
    endif()
    # BF host emulation needs neither nvcc nor a CUDA toolkit. MPFR needs
    # the bundled arithmetic headers supplied by its CUDA configuration.
    if(_b STREQUAL "mpfr" AND NOT TARGET mplapack_mpfr_opt_cuda)
      continue()
    endif()
    if(TARGET mplapack_${_b}_opt_cuda)
      set(_fallback ${_b}_cuda_solver_fallback_test)
      add_executable(${_fallback} "${PROJECT_SOURCE_DIR}/mplapack/optimized/common/test/Rsolver_fallback_test.cpp")
      target_link_libraries(${_fallback} PRIVATE mplapack_${_b}_opt_cuda CUDA::cudart)
      mplapack_configure_dd_arithmetic(${_fallback})
      if(_b STREQUAL "mpfr")
        foreach(_precision 256 512 768 1024 2048 200)
          add_test(NAME ${_b}_cuda_solver_fallback_${_precision} COMMAND ${_fallback} ${_precision})
          set_tests_properties(${_b}_cuda_solver_fallback_${_precision} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=4")
        endforeach()
      else()
        add_test(NAME ${_b}_cuda_solver_fallback COMMAND ${_fallback})
        set_tests_properties(${_b}_cuda_solver_fallback PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=4")
      endif()
    endif()
    foreach(_variant host device)
      if(_variant STREQUAL "device" AND NOT TARGET mplapack_${_b}_opt_cuda)
        continue()
      endif()
      set(_test ${_b}_cuda_solver_${_variant}_test)
      set(_common "${PROJECT_SOURCE_DIR}/mplapack/optimized/common/test")
      if(_b STREQUAL "mpfr")
        set(_dir "${PROJECT_SOURCE_DIR}/mpblas/optimized/mpfr/cuda")
        if(_variant STREQUAL "host")
          set(_engines "${_dir}/test/Rfactor_fixed_host.cpp" "${_dir}/test/Rfactor_runtime_host.cpp"
            "${_dir}/test/Cfactor_fixed_host.cpp" "${_dir}/test/Cfactor_runtime_host.cpp")
        else()
          set(_engines "${_dir}/Rfactor_device_cuda.cu" "${_dir}/Rfactor_rt_cuda.cu"
            "${_dir}/Cfactor_device_cuda.cu" "${_dir}/Cfactor_rt_cuda.cu" "${_dir}/test/Cfactor_device_globals.cu")
        endif()
        add_executable(${_test} "${_common}/Rsolver_gpu_test.cpp" "${_dir}/Rfactor_bridge_cuda.cpp" "${_dir}/Cfactor_bridge_cuda.cpp" ${_engines})
        target_include_directories(${_test} PRIVATE "${MPLAPACK_MPC_CUDA_INCLUDE_DIR}")
        if(_variant STREQUAL "host")
          target_compile_definitions(${_test} PRIVATE MPLAPACK_MPFR_CUDA_HOST_EMULATION)
        else()
          target_compile_definitions(${_test} PRIVATE MPLAPACK_SOLVER_DEVICE_TEST)
          target_link_libraries(${_test} PRIVATE "${MPLAPACK_MPC_CUDA_LIBRARY}")
          set_target_properties(${_test} PROPERTIES CUDA_SEPARABLE_COMPILATION ON CUDA_RESOLVE_DEVICE_SYMBOLS ON)
        endif()
        if(_mplapack_mpc_cuda_bundled)
          add_dependencies(${_test} mpc_cuda_bundled)
        endif()
      elseif(_variant STREQUAL "host")
        add_executable(${_test} "${_common}/Rsolver_gpu_test.cpp")
        target_compile_definitions(${_test} PRIVATE MPLAPACK_GEMM_CUDA_HOST_EMULATION)
      else()
        add_executable(${_test} "${_common}/Rsolver_gpu_device_test.cu")
      endif()
      target_link_libraries(${_test} PRIVATE mplapack_${_b}_opt)
      if(_variant STREQUAL "device")
        target_link_libraries(${_test} PRIVATE CUDA::cudart)
      endif()
      mplapack_configure_dd_arithmetic(${_test})
      target_compile_options(${_test} PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:-fmad=false;-Xcompiler=-ffp-contract=off>")
      if(_variant STREQUAL "device")
        set_target_properties(${_test} PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON CUDA_ARCHITECTURES "${MPLAPACK_CUDA_ARCHITECTURES}")
      endif()
      if(UNIX AND NOT APPLE)
        target_link_options(${_test} PRIVATE "-Wl,--disable-new-dtags")
      endif()
      if(_b STREQUAL "mpfr")
        # Separate processes preserve the complete six-precision matrix while
        # letting CI use its CPU cores for the expensive CPU-only oracles.
        foreach(_precision 256 512 768 1024 2048 200)
          add_test(NAME ${_b}_cuda_solver_${_variant}_${_precision} COMMAND ${_test} ${_precision})
          add_test(NAME ${_b}_cuda_solver_${_variant}_runtime_${_precision} COMMAND ${_test} ${_precision})
          set_tests_properties(${_b}_cuda_solver_${_variant}_${_precision} PROPERTIES
            SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=1;MPLAPACK_MPFR_CUDA_FORCE_RUNTIME=0")
          set_tests_properties(${_b}_cuda_solver_${_variant}_runtime_${_precision} PROPERTIES
            SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=1;MPLAPACK_MPFR_CUDA_FORCE_RUNTIME=1")
        endforeach()
      else()
        add_test(NAME ${_b}_cuda_solver_${_variant} COMMAND ${_test})
        set_tests_properties(${_b}_cuda_solver_${_variant} PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "OMP_NUM_THREADS=1")
      endif()
    endforeach()
  endforeach()
  set(_copy_tests OFF)
  foreach(_b dd td qd mpfr)
    if(TARGET mplapack_${_b}_opt_cuda)
      set(_copy_tests ON)
    endif()
  endforeach()
  if(_copy_tests AND UNIX AND NOT APPLE)
    set(_copy_dir "${PROJECT_SOURCE_DIR}/mplapack/optimized/common/test")
    add_library(cuda_solver_copy_delay SHARED "${_copy_dir}/Rsolver_copy_delay.cpp")
    target_compile_features(cuda_solver_copy_delay PRIVATE cxx_std_17)
    target_link_libraries(cuda_solver_copy_delay PRIVATE CUDA::cudart ${CMAKE_DL_LIBS})
    foreach(_b dd td qd)
      if(NOT TARGET mplapack_${_b}_opt_cuda)
        continue()
      endif()
      set(_exe ${_b}_cuda_solver_constant_publication_test)
      add_executable(${_exe} "${_copy_dir}/Rsolver_constant_publication_test.cpp")
      target_link_libraries(${_exe} PRIVATE mplapack_${_b}_opt_cuda ${CMAKE_DL_LIBS})
      mplapack_configure_dd_arithmetic(${_exe})
      target_link_options(${_exe} PRIVATE "-Wl,--disable-new-dtags")
      foreach(_control 0 1)
        set(_name ${_b}_cuda_solver_constants_${_control})
        add_test(NAME ${_name} COMMAND ${_exe} ${_control})
        set_tests_properties(${_name} PROPERTIES SKIP_RETURN_CODE 77 WILL_FAIL ${_control} RUN_SERIAL TRUE
          ENVIRONMENT "OMP_NUM_THREADS=1;LD_PRELOAD=$<TARGET_FILE:cuda_solver_copy_delay>;MPLAPACK_TEST_SKIP_COPY_FENCE=${_control}")
      endforeach()
    endforeach()
    if(TARGET mplapack_mpfr_opt_cuda)
      set(_pivot_dir "${PROJECT_SOURCE_DIR}/mpblas/optimized/mpfr/cuda/test")
      add_executable(mpfr_cuda_solver_pivot_publication_test "${_pivot_dir}/solver_pivot_publication.cpp")
      target_link_libraries(mpfr_cuda_solver_pivot_publication_test PRIVATE mplapack_mpfr_opt_cuda ${CMAKE_DL_LIBS})
      target_link_options(mpfr_cuda_solver_pivot_publication_test PRIVATE "-Wl,--disable-new-dtags")
      foreach(_precision 512 200)
        foreach(_control 0 1)
          set(_name mpfr_cuda_solver_pivot_${_precision}_${_control})
          add_test(NAME ${_name} COMMAND mpfr_cuda_solver_pivot_publication_test ${_precision} ${_control})
          set_tests_properties(${_name} PROPERTIES SKIP_RETURN_CODE 77 WILL_FAIL ${_control} RUN_SERIAL TRUE
            ENVIRONMENT "OMP_NUM_THREADS=1;LD_PRELOAD=$<TARGET_FILE:cuda_solver_copy_delay>;MPLAPACK_TEST_SKIP_COPY_FENCE=${_control};MPLAPACK_TEST_DELAY_BF_CONSTANTS=0")
        endforeach()
      endforeach()
    endif()
  endif()
endif()
