dnl QD library start
dnl Extra CXXFLAGS for building the bundled QD library only.
dnl We keep them conservative to avoid miscompilations (e.g., dd_real::exp()).
dnl cf. https://bugzilla.redhat.com/show_bug.cgi?id=1076070 and https://src.fedoraproject.org/rpms/qd/c/354e1d9b9999dc6fc9a13398f355c10a93ba1a44
AC_CANONICAL_HOST

qd_extra_cxxflags=""
qd_candidate_flags="-ffp-contract=off"

case "$host_cpu" in
  x86_64|amd64|aarch64|arm64|ppc64le|s390|s390x)
    qd_candidate_flags="$qd_candidate_flags"
    ;;
  *)
    : dnl keep defaults
    ;;
esac
save_CXXFLAGS="$CXXFLAGS"
AC_LANG_PUSH([C++])
for qd_flag in $qd_candidate_flags; do
  CXXFLAGS="$save_CXXFLAGS $qd_flag"
  AC_MSG_CHECKING([whether $CXX accepts $qd_flag])
  AC_COMPILE_IFELSE([AC_LANG_PROGRAM([], [])],
    [AC_MSG_RESULT([yes]); qd_extra_cxxflags="$qd_extra_cxxflags $qd_flag"],
    [AC_MSG_RESULT([no])])
done
AC_SUBST([qd_extra_cxxflags])
AC_LANG_POP([C++])
CXXFLAGS="$save_CXXFLAGS"

AC_SUBST([QD_EXTRA_CXXFLAGS], [$qd_extra_cxxflags])

dnl DD backend requires the same FP-contraction suppression as the QD library.
dnl For GCC/Clang: -ffp-contract=off (already probed in qd_extra_cxxflags).
dnl For Intel icpx: -fp-model strict is already injected into global CXXFLAGS,
dnl but we add it here explicitly for DD_CXXFLAGS consumers to be self-contained.
DD_CXXFLAGS="$qd_extra_cxxflags"
if test x"$is_intelcxx" = x"1"; then
    DD_CXXFLAGS="$DD_CXXFLAGS -fp-model strict"
fi
AC_SUBST([DD_CXXFLAGS])

