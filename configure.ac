case " $CXX $CC $OPENMP_CXXFLAGS " in
  *" icpx "*|*" icx "*|*" -qopenmp "*)
    OPENMP_RUNTIME="Intel OpenMP (inferred)"
    ;;
  *" clang "*|*" clang++ "*)
    OPENMP_RUNTIME="LLVM OpenMP (inferred)"
    ;;
  *" gcc "*|*" g++ "*|*" -fopenmp "*)
    OPENMP_RUNTIME="GNU OpenMP / libgomp (inferred)"
    ;;
  *)
    if test "x$OPENMP_STATUS" = "xenabled"; then
