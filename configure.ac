dnl ===================================================================
dnl OpenCL API-version probing helpers
dnl
dnl _MPLAPACK_OPENCL_TRY_VER(HEADER, MACRO_SUFFIX, NUMERIC)
dnl   If CL_VERSION_<MACRO_SUFFIX> is defined by <HEADER>, raise
dnl   opencl_header_max to NUMERIC.  Called in ascending order, so the
dnl   highest version the headers declare wins.
dnl
dnl MPLAPACK_OPENCL_MAXVER(HEADER)
dnl   Set shell var opencl_header_max to the highest OpenCL level the
dnl   headers expose (100,110,120,200,210,220,300); 0 if none found.
dnl   HEADER must be an m4 literal (CL/cl.h or OpenCL/cl.h).  CPPFLAGS
dnl   must already carry the include path for HEADER before calling.
dnl ===================================================================
AC_DEFUN([_MPLAPACK_OPENCL_TRY_VER],
[AC_COMPILE_IFELSE(
   [AC_LANG_PROGRAM([[
#include <$1>
#if !defined(CL_VERSION_$2)
#error CL_VERSION_$2 not defined
#endif
]], [[]])],
   [opencl_header_max=$3])])

AC_DEFUN([MPLAPACK_OPENCL_MAXVER],
[opencl_header_max=0
 _MPLAPACK_OPENCL_TRY_VER([$1], [1_0], [100])
 _MPLAPACK_OPENCL_TRY_VER([$1], [1_1], [110])
 _MPLAPACK_OPENCL_TRY_VER([$1], [1_2], [120])
 _MPLAPACK_OPENCL_TRY_VER([$1], [2_0], [200])
 _MPLAPACK_OPENCL_TRY_VER([$1], [2_1], [210])
 _MPLAPACK_OPENCL_TRY_VER([$1], [2_2], [220])
 _MPLAPACK_OPENCL_TRY_VER([$1], [3_0], [300])])

# ---- OpenCL detection ----
#
# CL_TARGET_OPENCL_VERSION selects which API symbols the Khronos headers
# expose and which deprecation guards fire.  Pin the default to OpenCL 1.2:
# the current binary128 OpenCL backend uses 1.x host APIs, and Apple OpenCL is
# frozen at 1.2.  Users can request another level explicitly, or use "max" to
# target the highest level the installed headers expose.
m4_define([MPLAPACK_OPENCL_TARGET_DEFAULT], [120])

AC_ARG_WITH([opencl],
  [AS_HELP_STRING([--with-opencl@<:@=DIR@:>@],
     [enable OpenCL; optionally a vendor SDK prefix, e.g. /usr/local/cuda])],
  [opencl_required=yes], [with_opencl=check; opencl_required=no])
AC_ARG_WITH([opencl-include],
  [AS_HELP_STRING([--with-opencl-include=DIR], [OpenCL headers dir])],
  [OPENCL_CPPFLAGS="-I$withval"; opencl_required=yes], [])
AC_ARG_WITH([opencl-lib],
  [AS_HELP_STRING([--with-opencl-lib=DIR], [OpenCL library dir])],
  [OPENCL_LDFLAGS="-L$withval"; opencl_required=yes], [])
AC_ARG_WITH([opencl-version],
  [AS_HELP_STRING([--with-opencl-version=VER],
     [OpenCL API level to target: 100, 110, 120, 200, 210, 220, 300, or
      'max' for the highest the headers expose (default: ]MPLAPACK_OPENCL_TARGET_DEFAULT[)])],
  [opencl_target_req="$withval"],
  [opencl_target_req="MPLAPACK_OPENCL_TARGET_DEFAULT"])

have_opencl=no
opencl_header=
OPENCL_CFLAGS=
OPENCL_LIBS=
OPENCL_TARGET_VERSION=

AS_IF([test "x$with_opencl" != xno], [
  AS_IF([test -d "$with_opencl"], [
    OPENCL_CPPFLAGS="$OPENCL_CPPFLAGS -I$with_opencl/include"
    OPENCL_LDFLAGS="$OPENCL_LDFLAGS -L$with_opencl/lib64 -L$with_opencl/lib"
  ])

  PKG_PROG_PKG_CONFIG
  PKG_CHECK_MODULES([OPENCL], [OpenCL],
    [OPENCL_CFLAGS="$OPENCL_CPPFLAGS $OPENCL_CFLAGS"
     OPENCL_LIBS="$OPENCL_LDFLAGS $OPENCL_LIBS"],
    [OPENCL_CFLAGS="$OPENCL_CPPFLAGS"
     case "$host_os" in
       darwin*) OPENCL_LIBS="$OPENCL_LDFLAGS -framework OpenCL" ;;
       *)       OPENCL_LIBS="$OPENCL_LDFLAGS -lOpenCL" ;;
     esac])

  save_CPPFLAGS="$CPPFLAGS"; save_LDFLAGS="$LDFLAGS"; save_LIBS="$LIBS"
  CPPFLAGS="$CPPFLAGS $OPENCL_CFLAGS"
  case "$host_os" in
    darwin*) opencl_header=OpenCL/cl.h ;;
    *)       opencl_header=CL/cl.h ;;
  esac

  AC_MSG_CHECKING([whether OpenCL headers compile])
  AC_COMPILE_IFELSE(
    [AC_LANG_PROGRAM([[
#include <$opencl_header>
]], [[]])],
    [opencl_header_works=yes],
    [opencl_header_works=no])
  AC_MSG_RESULT([$opencl_header_works])

  AS_IF([test "x$opencl_header_works" = xyes], [
    LDFLAGS="$LDFLAGS $OPENCL_LDFLAGS"
    LIBS="$OPENCL_LIBS $LIBS"
    AC_MSG_CHECKING([whether OpenCL links])
    AC_LINK_IFELSE(
      [AC_LANG_PROGRAM([[
#include <$opencl_header>
]], [[
cl_uint nplatforms = 0;
clGetPlatformIDs(0, 0, &nplatforms);
]])],
      [have_opencl=yes],
      [have_opencl=no])
    AC_MSG_RESULT([$have_opencl])
  ])

  CPPFLAGS="$save_CPPFLAGS"; LDFLAGS="$save_LDFLAGS"; LIBS="$save_LIBS"

  AS_IF([test "x$have_opencl" = xyes], [
    case "$opencl_header" in
      OpenCL/cl.h) AC_DEFINE([HAVE_OPENCL_CL_H], [1], [Define if <OpenCL/cl.h> exists]) ;;
      CL/cl.h)     AC_DEFINE([HAVE_CL_CL_H], [1], [Define if <CL/cl.h> exists]) ;;
    esac
  ], [
    AS_IF([test "x$opencl_required" = xyes],
      [AC_MSG_ERROR([OpenCL requested but headers or library are not usable; use --with-opencl=DIR or --with-opencl-include=DIR --with-opencl-lib=DIR])],
      [AC_MSG_WARN([OpenCL not usable; disabling OpenCL support])])
    OPENCL_CFLAGS=
    OPENCL_LIBS=
  ])
])

AS_IF([test "x$have_opencl" = xyes], [
  save_CPPFLAGS="$CPPFLAGS"
  CPPFLAGS="$CPPFLAGS $OPENCL_CFLAGS"
  AC_MSG_CHECKING([highest OpenCL version exposed by the headers])
  AS_CASE([$opencl_header],
    [OpenCL/cl.h], [MPLAPACK_OPENCL_MAXVER([OpenCL/cl.h])],
    [CL/cl.h],     [MPLAPACK_OPENCL_MAXVER([CL/cl.h])])
  CPPFLAGS="$save_CPPFLAGS"
  AS_IF([test "$opencl_header_max" = 0],
    [AC_MSG_RESULT([unknown])
     AC_MSG_WARN([no CL_VERSION_x_y macro found in headers; assuming 120])
     opencl_header_max=120],
    [AC_MSG_RESULT([$opencl_header_max])])

  AS_CASE([$opencl_target_req],
    [max|auto], [OPENCL_TARGET_VERSION=$opencl_header_max],
    [OPENCL_TARGET_VERSION=$opencl_target_req])

  AS_CASE([$OPENCL_TARGET_VERSION],
    [100|110|120|200|210|220|300], [],
    [AC_MSG_ERROR([--with-opencl-version: invalid value '$opencl_target_req'; use 100, 110, 120, 200, 210, 220, 300, or max])])

  AS_IF([test "$opencl_header_max" -lt "$OPENCL_TARGET_VERSION"],
    [AC_MSG_ERROR([requested OpenCL target $OPENCL_TARGET_VERSION but the headers expose at most $opencl_header_max; install newer OpenCL headers or lower --with-opencl-version])])

  OPENCL_CFLAGS="$OPENCL_CFLAGS -DCL_TARGET_OPENCL_VERSION=$OPENCL_TARGET_VERSION"

  case "$host_os" in
    darwin*) OPENCL_CFLAGS="$OPENCL_CFLAGS -DCL_SILENCE_DEPRECATION" ;;
  esac

  AC_MSG_NOTICE([OpenCL API target: CL_TARGET_OPENCL_VERSION=$OPENCL_TARGET_VERSION])
])

AS_IF([test "x$have_opencl" = xyes],
  [AC_DEFINE([HAVE_OPENCL], [1], [Define if OpenCL support is available])])

AM_CONDITIONAL([ENABLE_OPENCL], [test "x$have_opencl" = xyes])
AC_SUBST([OPENCL_CPPFLAGS])
AC_SUBST([OPENCL_CFLAGS])
AC_SUBST([OPENCL_LDFLAGS])
AC_SUBST([OPENCL_LIBS])
AC_SUBST([OPENCL_TARGET_VERSION])

dnl enable benchmark; compare with reference LAPACK and BLAS, and OpenBLAS
AC_ARG_ENABLE(benchmark,
AS_HELP_STRING([--enable-benchmark], [Enable benchmark]))
AM_CONDITIONAL(ENABLE_BENCHMARK, test x$enable_benchmark = xyes)

AC_ARG_WITH([openblas],
AS_HELP_STRING([--with-openblas=internal|system|LIBS],
               [OpenBLAS for benchmarks: build bundled OpenBLAS, use -lopenblas, or use explicit linker flags (default: internal)]),
    [with_openblas=$withval],
    [with_openblas=internal])

dnl disable examples
AC_ARG_ENABLE(examples,
AS_HELP_STRING([--disable-examples], [Disable examples]))
AM_CONDITIONAL(DISABLE_EXAMPLES, test x$enable_examples = xno)

dnl disable reference
AC_ARG_ENABLE(reference,
AS_HELP_STRING([--disable-reference], [Build without reference libraries]))
AM_CONDITIONAL(DISABLE_REFERENCE, test x$enable_reference = xno)

dnl enable GMP version of MPLAPACK.
AC_ARG_ENABLE(gmp,
AS_HELP_STRING([--enable-gmp], [Enable GMP version]))
AM_CONDITIONAL(ENABLE_GMP, test x$enable_gmp = xyes)

dnl enable MPFR version of MPLAPACK.
AC_ARG_ENABLE(mpfr,
AS_HELP_STRING([--enable-mpfr], [Enable MPFR version]))

dnl We use MPFR version as reference
dnl so if test is turned on,
if test x$enable_test = x"yes"; then
    enable_mpfr=yes
fi
AM_CONDITIONAL(ENABLE_MPFR, test x$enable_mpfr = xyes)

dnl enable QD version of MPLAPACK.
AC_ARG_ENABLE(qd,
AS_HELP_STRING([--enable-qd], [Enable QD version]))
AM_CONDITIONAL(ENABLE_QD, test x$enable_qd = xyes)

AC_ARG_WITH(qdlib-flags,
AS_HELP_STRING([--with-qdlib-flags], [passing flag to internal qd library])
,,with_qdlib_flags="")
QDLIB_FLAGS=$with_qdlib_flags;
AC_SUBST(QDLIB_FLAGS)

dnl enable DD version of MPLAPACK.
AC_ARG_ENABLE(dd,
AS_HELP_STRING([--enable-dd], [Enable DD version]),
[case "${enableval}" in
    yes) enable_dd=yes ;;
    no)  enable_dd=no  ;;
    *) AC_MSG_ERROR(bad value ${enableval} for --enable-dd) ;;
        esac],[enable_dd=yes])
AM_CONDITIONAL(ENABLE_DD, test x$enable_dd = xyes)

dnl enable double
AC_ARG_ENABLE(double,
AS_HELP_STRING([--enable-double], [Enable double version]),
[case "${enableval}" in
    yes) enable_double=yes ;;
    no)  enable_double=no  ;;
    *) AC_MSG_ERROR(bad value ${enableval} for --enable-double) ;;
        esac],[enable_double=no])
AM_CONDITIONAL(ENABLE_DOUBLE, test x$enable_double = xyes)

dnl =========================================================================
dnl MPLAPACK 2.1.0 - Binary128 Support Detection
dnl =========================================================================
dnl
dnl Detection is organized into 4 independent phases:
dnl   Phase 1: Type availability (_Float128, __float128, long double)
dnl   Phase 2: I/O functions (strfromf128, quadmath_snprintf, snprintf %Lg)
dnl   Phase 3: Math functions (f128 suffix, q suffix, l suffix)
dnl   Phase 4: Literal suffix (F128, Q, L)
dnl
dnl Then we determine the best combination to use.
dnl =========================================================================

AC_ARG_ENABLE(binary128,
AS_HELP_STRING([--enable-binary128], [Enable binary128 (128-bit IEEE float) version]),
[case "${enableval}" in
    yes) enable_binary128=yes ;;
    no)  enable_binary128=no  ;;
    *) AC_MSG_ERROR(bad value ${enableval} for --enable-binary128) ;;
esac],[enable_binary128=no])

dnl Initialize all detection flags
mplapack_binary128_mode=0
mplapack_binary128_io=0
mplapack_binary128_math=0

if test x$enable_binary128 = x"yes"; then

    dnl ===================================================================
    dnl Phase 1: Type Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary128 type support])

    have__Float128=no
    have___float128=no
    longdouble_is_binary128=no
    _Float128_is_longdouble=no
    float128_types_same=no
    float128_implicit_gnu_to_std=no
    float128_implicit_std_to_gnu=no

    dnl Check _Float128
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main() {
                _Float128 a, b, c;
                b = 1.0;
                c = 3.0;
                a = b / c;
                return 0;
            }
        ]])
    ], [have__Float128=yes], [])

    dnl Check __float128
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main() {
                __float128 a, b, c;
                b = 1.0;
                c = 3.0;
                a = b / c;
                return 0;
            }
        ]])
    ], [have___float128=yes], [])

    dnl Check if long double is binary128-like: mantissa=113 and exponent range like binary128
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main(void) {
            #if (__LDBL_MANT_DIG__ >= 113) && (__LDBL_MAX_EXP__ >= 16384)
                return 0;
            #else
            # error "long double is not binary128 (mantissa/exponent mismatch)"
            #endif
            }
        ]])
    ], [longdouble_is_binary128=yes], [longdouble_is_binary128=no])
    dnl Check if _Float128 == long double
    if test "$have__Float128" = "yes"; then
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                int main() {
                    long double *x;
                    _Float128 *y = x;
                    return 0;
                }
            ]])
        ], [_Float128_is_longdouble=yes], [])
    fi

    dnl Check convertibility between __float128 (GNU) and _Float128 (standard) (C++)
    if test "x$have__Float128" = "xyes" && test "x$have___float128" = "xyes"; then
        AC_LANG_PUSH([C++])

        dnl Same type?
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_same<_Float128, __float128>::value, "not same");
                    return 0;
                }
            ]])
        ], [float128_types_same=yes], [float128_types_same=no])

        dnl Implicitly convertible? (__float128 -> _Float128)
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_convertible<__float128, _Float128>::value,
                                  "not convertible gnu_f128 -> std_f128");
                    return 0;
                }
            ]])
        ], [float128_implicit_gnu_to_std=yes], [float128_implicit_gnu_to_std=no])

        dnl Implicitly convertible? (_Float128 -> __float128)
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_convertible<_Float128, __float128>::value,
                                  "not convertible std_f128 -> gnu_f128");
                    return 0;
                }
            ]])
        ], [float128_implicit_std_to_gnu=yes], [float128_implicit_std_to_gnu=no])

        AC_LANG_POP([C++])
    fi

    AC_MSG_RESULT([_Float128=$have__Float128, __float128=$have___float128, ldbl_binary128=$longdouble_is_binary128, same_types=$float128_types_same, implicit_gnu_to_std=$float128_implicit_gnu_to_std, implicit_std_to_gnu=$float128_implicit_std_to_gnu])

    dnl ===================================================================
    dnl Phase 2: I/O Function Detection
    dnl ===================================================================

    dnl Auto-detect quadmath paths for Intel compiler
    if test "$have___float128" = "yes" && test "x$is_intelcxx" = "x1"; then
        AX_FIND_QUADMATH
        if test -n "$QUADMATH_CPPFLAGS"; then
            CPPFLAGS="$CPPFLAGS $QUADMATH_CPPFLAGS"
        fi
        if test -n "$QUADMATH_LDFLAGS"; then
            LDFLAGS="$LDFLAGS $QUADMATH_LDFLAGS"
        fi
    fi
    AC_MSG_CHECKING([for binary128 I/O functions])

    have_strfromf128=no
    have_quadmath_snprintf=no
    have_snprintf_Lg=no

    dnl Check strfromf128 (glibc >= 2.26)
    if test "$have__Float128" = "yes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <stdlib.h>
                int main() {
                    _Float128 a = 1.0;
                    char buf[128];
                    strfromf128(buf, sizeof(buf), "%.40g", a);
                    return 0;
                }
            ]])
        ], [have_strfromf128=yes], [])
    fi

    dnl Check quadmath_snprintf
    if test "$have___float128" = "yes"; then
        save_LIBS="$LIBS"
        LIBS="-lquadmath $LIBS"
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <quadmath.h>
                int main() {
                    __float128 a = 1.0q;
                    char buf[128];
                    quadmath_snprintf(buf, sizeof(buf), "%.40Qf", a);
                    return 0;
                }
            ]])
        ], [have_quadmath_snprintf=yes], [])
        LIBS="$save_LIBS"
    fi

    dnl Check snprintf %Lg (for long double binary128)
    if test "$longdouble_is_binary128" = "yes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <stdio.h>
                int main() {
                    long double a = 1.0L;
                    char buf[128];
                    snprintf(buf, sizeof(buf), "%.40Lg", a);
                    return 0;
                }
            ]])
        ], [have_snprintf_Lg=yes], [])
    fi

    AC_MSG_RESULT([strfromf128=$have_strfromf128, quadmath_snprintf=$have_quadmath_snprintf, snprintf_Lg=$have_snprintf_Lg])

    dnl ===================================================================
    dnl Phase 3: Math Function Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary128 math functions])

    have_f128_math=no
    have_quadmath_math=no
    have_ldbl_math=no

    dnl Check f128 math (sqrtf128, expf128, logf128, ...)
    if test "$have__Float128" = "yes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <math.h>
                int main() {
                    _Float128 x = 2.0;
                    _Float128 a = sqrtf128(x);
                    _Float128 b = expf128(x);
                    _Float128 c = logf128(x);
                    _Float128 d = sinf128(x);
                    _Float128 e = cosf128(x);
                    return 0;
                }
            ]])
        ], [have_f128_math=yes], [])
    fi

    dnl Check quadmath math (sqrtq, expq, logq, ...)
    if test "$have___float128" = "yes"; then
        save_LIBS="$LIBS"
        LIBS="-lquadmath $LIBS"
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <quadmath.h>
                int main() {
                    __float128 x = 2.0q;
                    __float128 a = sqrtq(x);
                    __float128 b = expq(x);
                    __float128 c = logq(x);
                    __float128 d = sinq(x);
                    __float128 e = cosq(x);
                    return 0;
                }
            ]])
        ], [have_quadmath_math=yes], [])
        LIBS="$save_LIBS"
    fi

    dnl Check long double math (sqrtl, expl, logl, ...)
    if test "$longdouble_is_binary128" = "yes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <math.h>
                int main() {
                    long double x = 2.0L;
                    long double a = sqrtl(x);
                    long double b = expl(x);
                    long double c = logl(x);
                    long double d = sinl(x);
                    long double e = cosl(x);
                    return 0;
                }
            ]])
        ], [have_ldbl_math=yes], [])
    fi

    AC_MSG_RESULT([f128_math=$have_f128_math, quadmath_math=$have_quadmath_math, ldbl_math=$have_ldbl_math])

    dnl ===================================================================
    dnl Phase 4: Literal Suffix Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary128 literal suffix])

    have_suffix_F128=no
    have_suffix_Q=no
    have_suffix_L_binary128=no

    dnl Check F128 suffix
    if test "$have__Float128" = "yes"; then
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                int main() {
                    _Float128 a = 3.14159265358979323846264338327950288F128;
                    return 0;
                }
            ]])
        ], [have_suffix_F128=yes], [])
    fi

    dnl Check Q suffix (for __float128)
    if test "$have___float128" = "yes"; then
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                int main() {
                    __float128 a = 3.14159265358979323846264338327950288Q;
                    return 0;
                }
            ]])
        ], [have_suffix_Q=yes], [])
    fi

    dnl Check L suffix produces binary128 (when long double is binary128)
    if test "$longdouble_is_binary128" = "yes"; then
        have_suffix_L_binary128=yes
    fi

    AC_MSG_RESULT([F128=$have_suffix_F128, Q=$have_suffix_Q, L_binary128=$have_suffix_L_binary128])

    dnl ===================================================================
    dnl Phase 5: Determine Best Configuration
    dnl ===================================================================
    AC_MSG_CHECKING([binary128 configuration])

    dnl Priority: _Float128 > __float128 + quadmath > long double
    dnl
    dnl For each selected type, we need:
    dnl   - A working I/O method
    dnl   - Working math functions
    dnl   - A literal suffix

    binary128_configured=no

    dnl Try _Float128 first
    if test "$have__Float128" = "yes" && \
       test "$have_strfromf128" = "yes" && \
       test "$have_suffix_F128" = "yes"; then

        mplapack_binary128_mode=2            # FLOAT128

        if test "$have_f128_math" = "yes"; then
            mplapack_binary128_math=2        # F128
        elif test "$_Float128_is_longdouble" = "yes" && test "$have_ldbl_math" = "yes"; then
            mplapack_binary128_math=1        # LDBL (fallback when _Float128 == long double)
        else
            AC_MSG_ERROR([_Float128 available but no math functions])
        fi

        mplapack_binary128_io=2     # STRFROMF128
        binary128_configured=yes
        AC_MSG_RESULT([_Float128 + strfromf128])
    fi

    dnl Try __float128 + libquadmath
    if test "$binary128_configured" = "no" && \
       test "$have___float128" = "yes" && \
       test "$have_quadmath_snprintf" = "yes" && \
       test "$have_quadmath_math" = "yes" && \
       test "$have_suffix_Q" = "yes"; then

        mplapack_binary128_mode=3   # QUADMATH
        mplapack_binary128_io=3     # QUADMATH_SNPRINTF
        mplapack_binary128_math=3   # QUADMATH
        binary128_configured=yes
        AC_MSG_RESULT([__float128 + libquadmath])
    fi

    dnl Try long double as binary128
    if test "$binary128_configured" = "no" && \
       test "$longdouble_is_binary128" = "yes" && \
       test "$have_snprintf_Lg" = "yes" && \
       test "$have_ldbl_math" = "yes"; then

        mplapack_binary128_mode=1   # LDBL
        mplapack_binary128_io=1     # SNPRINTF_LDBL
        mplapack_binary128_math=1   # LDBL
        binary128_configured=yes
        AC_MSG_RESULT([long double (binary128)])
    fi

    if test "$binary128_configured" = "no"; then
        AC_MSG_ERROR([binary128 is not supported on this system])
    fi
fi

dnl Check whether std::abs() exists for the selected binary128 scalar type.
dnl Do not rely on __SIZEOF_FLOAT128__ here: on some Power targets it is not a
dnl reliable proxy for whether C++ __float128 is actually usable, and the
dnl compile test itself already answers the question.  In strict C++ modes,
dnl libstdc++ may expose std::abs(_Float128) but not std::abs(__float128), so
dnl the probe must match the binary128 mode selected above.
AC_LANG_PUSH([C++])
mplapack_have_std_abs_float128=no
AS_CASE([$mplapack_binary128_mode],
  [2], [
    AC_MSG_CHECKING([for std::abs(_Float128)])
    if test "x$have__Float128" = "xyes"; then
      AC_COMPILE_IFELSE(
        [AC_LANG_SOURCE([[
#include <cmath>
int main() {
  auto p = static_cast<_Float128 (*)(_Float128)>(&std::abs);
  (void)p;
  return 0;
}
]])],
        [mplapack_have_std_abs_float128=yes],
        [mplapack_have_std_abs_float128=no])
    fi
  ],
  [3], [
    AC_MSG_CHECKING([for std::abs(__float128)])
    if test "x$have___float128" = "xyes"; then
      AC_COMPILE_IFELSE(
        [AC_LANG_SOURCE([[
#include <cmath>
int main() {
  auto p = static_cast<__float128 (*)(__float128)>(&std::abs);
  (void)p;
  return 0;
}
]])],
        [mplapack_have_std_abs_float128=yes],
        [mplapack_have_std_abs_float128=no])
    fi
  ],
  [AC_MSG_CHECKING([for std::abs(selected binary128 type)])])
AC_MSG_RESULT([$mplapack_have_std_abs_float128])
AS_IF([test "x$mplapack_have_std_abs_float128" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_STD_ABS_FLOAT128],[1],
    [Define to 1 if std::abs() is available for the selected binary128 scalar type])],
  [AC_DEFINE([MPLAPACK_HAVE_STD_ABS_FLOAT128],[0],
    [Define to 0 if std::abs() is not available for the selected binary128 scalar type])]
)
AC_LANG_POP([C++])

dnl Check whether std::* math overloads exist for _Float128.  This is separate
dnl from std::abs(): libstdc++ exposes these overloads on a different schedule,
dnl and defining global wrappers with the same signatures conflicts with C++23
dnl <math.h> using-declarations.
AC_LANG_PUSH([C++])
mplapack_have_std_math_float128=no
AS_IF([test "x$mplapack_binary128_mode" = "x2"], [
  AC_MSG_CHECKING([for std::_Float128 math functions])
  AC_COMPILE_IFELSE(
    [AC_LANG_SOURCE([[
#include <cmath>
#include <type_traits>
int main() {
  _Float128 x = (_Float128)1.0;
  _Float128 y = (_Float128)2.0;
  static_assert(std::is_same<decltype(std::sin(x)), _Float128>::value, "std::sin(_Float128)");
  static_assert(std::is_same<decltype(std::sinh(x)), _Float128>::value, "std::sinh(_Float128)");
  static_assert(std::is_same<decltype(std::cos(x)), _Float128>::value, "std::cos(_Float128)");
  static_assert(std::is_same<decltype(std::cosh(x)), _Float128>::value, "std::cosh(_Float128)");
  static_assert(std::is_same<decltype(std::atan2(x, y)), _Float128>::value, "std::atan2(_Float128)");
  static_assert(std::is_same<decltype(std::exp(x)), _Float128>::value, "std::exp(_Float128)");
  static_assert(std::is_same<decltype(std::log(x)), _Float128>::value, "std::log(_Float128)");
  static_assert(std::is_same<decltype(std::log10(x)), _Float128>::value, "std::log10(_Float128)");
  static_assert(std::is_same<decltype(std::log2(x)), _Float128>::value, "std::log2(_Float128)");
  static_assert(std::is_same<decltype(std::pow(x, y)), _Float128>::value, "std::pow(_Float128)");
  static_assert(std::is_same<decltype(std::sqrt(x)), _Float128>::value, "std::sqrt(_Float128)");
  static_assert(std::is_same<decltype(std::ceil(x)), _Float128>::value, "std::ceil(_Float128)");
  static_assert(std::is_same<decltype(std::nextafter(x, y)), _Float128>::value, "std::nextafter(_Float128)");
  static_assert(std::is_same<decltype(std::ldexp(x, 1)), _Float128>::value, "std::ldexp(_Float128)");
  return 0;
}
]])],
    [mplapack_have_std_math_float128=yes],
    [mplapack_have_std_math_float128=no])
  AC_MSG_RESULT([$mplapack_have_std_math_float128])
], [
  AC_MSG_CHECKING([for std::_Float128 math functions])
  AC_MSG_RESULT([no])
])
AS_IF([test "x$mplapack_have_std_math_float128" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_STD_MATH_FLOAT128],[1],
    [Define to 1 if std::_Float128 scalar math functions are available])],
  [AC_DEFINE([MPLAPACK_HAVE_STD_MATH_FLOAT128],[0],
    [Define to 0 if std::_Float128 scalar math functions are not available])]
)
AC_LANG_POP([C++])

dnl Check which complex _Float128 implementation can be used by headers built
dnl with this configured C++ mode.  std::complex<_Float128> math is available
dnl in modern libstdc++ C++23 modes, while glibc C _Float128 _Complex
dnl functions are typically only declared in GNU C++ modes.  The header trusts
dnl these probe results; re-run configure when changing the C++ mode.
AC_LANG_PUSH([C++])
mplapack_have_std_complex_float128=no
mplapack_have_c_complex_float128=no
AS_IF([test "x$mplapack_binary128_mode" = "x2"], [
  AC_MSG_CHECKING([for std::complex<_Float128> math functions])
  AC_COMPILE_IFELSE(
    [AC_LANG_SOURCE([[
#include <complex>
int main() {
  std::complex<_Float128> z((_Float128)1.0, (_Float128)2.0);
  volatile _Float128 a = std::abs(z);
  (void)a;
  (void)std::sqrt(z);
  (void)std::sin(z);
  (void)std::cos(z);
  (void)std::exp(z);
  (void)std::log(z);
  return 0;
}
]])],
    [mplapack_have_std_complex_float128=yes],
    [mplapack_have_std_complex_float128=no])
  AC_MSG_RESULT([$mplapack_have_std_complex_float128])

  AC_MSG_CHECKING([for C _Float128 complex math functions])
  AC_COMPILE_IFELSE(
    [AC_LANG_SOURCE([[
#ifndef __STDC_WANT_IEC_60559_TYPES_EXT__
#define __STDC_WANT_IEC_60559_TYPES_EXT__ 1
#endif
#ifndef __STDC_WANT_IEC_60559_FUNCS_EXT__
#define __STDC_WANT_IEC_60559_FUNCS_EXT__ 1
#endif
#include <complex.h>
int main() {
  _Float128 _Complex z;
  __real__(z) = (_Float128)1.0;
  __imag__(z) = (_Float128)2.0;
  volatile _Float128 a = cabsf128(z);
  (void)a;
  (void)csqrtf128(z);
  (void)csinf128(z);
  (void)ccosf128(z);
  (void)cexpf128(z);
  (void)clogf128(z);
  return 0;
}
]])],
    [mplapack_have_c_complex_float128=yes],
    [mplapack_have_c_complex_float128=no])
  AC_MSG_RESULT([$mplapack_have_c_complex_float128])
])
AS_IF([test "x$mplapack_binary128_mode" != "x2"], [
  AC_MSG_CHECKING([for std::complex<_Float128> math functions])
  AC_MSG_RESULT([no])
  AC_MSG_CHECKING([for C _Float128 complex math functions])
  AC_MSG_RESULT([no])
])
AS_IF([test "x$mplapack_have_std_complex_float128" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_STD_COMPLEX_FLOAT128],[1],
    [Define to 1 if std::complex<_Float128> math functions are available])],
  [AC_DEFINE([MPLAPACK_HAVE_STD_COMPLEX_FLOAT128],[0],
    [Define to 0 if std::complex<_Float128> math functions are not available])]
)
AS_IF([test "x$mplapack_have_c_complex_float128" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_C_COMPLEX_FLOAT128],[1],
    [Define to 1 if C _Float128 complex math functions are available in C++])],
  [AC_DEFINE([MPLAPACK_HAVE_C_COMPLEX_FLOAT128],[0],
    [Define to 0 if C _Float128 complex math functions are not available in C++])]
)
AC_LANG_POP([C++])

dnl ===================================================================
dnl Define macros for config.h
dnl ===================================================================
mplapack_has__Float128_type=0
mplapack_has___float128_type=0
mplapack_ldbl_is_binary128=0
mplapack__Float128_is_long_double=0
mplapack_float128_types_same=0
mplapack_implicit_gnu_to_std_f128=0
mplapack_implicit_std_to_gnu_f128=0

AS_IF([test "x$have__Float128" = "xyes"], [mplapack_has__Float128_type=1])
AS_IF([test "x$have___float128" = "xyes"], [mplapack_has___float128_type=1])
AS_IF([test "x$longdouble_is_binary128" = "xyes"], [mplapack_ldbl_is_binary128=1])
AS_IF([test "x$_Float128_is_longdouble" = "xyes"], [mplapack__Float128_is_long_double=1])
AS_IF([test "x$float128_types_same" = "xyes"], [mplapack_float128_types_same=1])
AS_IF([test "x$float128_implicit_gnu_to_std" = "xyes"], [mplapack_implicit_gnu_to_std_f128=1])
AS_IF([test "x$float128_implicit_std_to_gnu" = "xyes"], [mplapack_implicit_std_to_gnu_f128=1])

AC_DEFINE_UNQUOTED([MPLAPACK_HAVE_STD_FLOAT128], [$mplapack_has__Float128_type],
    [1 if _Float128 is supported by the compiler, else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_HAVE_GNU_FLOAT128], [$mplapack_has___float128_type],
    [1 if __float128 is supported by the compiler, else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_LDBL_IS_BINARY128], [$mplapack_ldbl_is_binary128],
    [1 if long double is binary128-like (mantissa/exponent), else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_STD_FLOAT128_IS_LDBL], [$mplapack__Float128_is_long_double],
    [1 if _Float128 is the same type as long double, else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_FLOAT128_SAME_TYPES], [$mplapack_float128_types_same],
    [1 if _Float128 and __float128 are the same type, else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_FLOAT128_CONVERT_GNU_TO_STD], [$mplapack_implicit_gnu_to_std_f128],
    [1 If __float128 is implicitly convertible to _Float128, else 0])
AC_DEFINE_UNQUOTED([MPLAPACK_FLOAT128_CONVERT_STD_TO_GNU], [$mplapack_implicit_std_to_gnu_f128],
    [1 if _Float128 is implicitly convertible to __float128, else 0])

dnl ===================================================================
dnl Selected Binary128 configuration (mode / I/O / math)
dnl ===================================================================
AC_DEFINE_UNQUOTED([MPLAPACK_BINARY128_MODE], [$mplapack_binary128_mode],
    [Binary128 type mode: 0=DISABLED, 1=LDBL, 2=FLOAT128, 3=QUADMATH])
AC_DEFINE_UNQUOTED([MPLAPACK_BINARY128_IO], [$mplapack_binary128_io],
    [Binary128 I/O mode: 0=NONE, 1=SNPRINTF_LDBL, 2=STRFROMF128, 3=QUADMATH_SNPRINTF])
AC_DEFINE_UNQUOTED([MPLAPACK_BINARY128_MATH], [$mplapack_binary128_math],
    [Binary128 math mode: 0=NONE, 1=LDBL, 2=F128, 3=QUADMATH])

dnl ===================================================================
dnl Constants for config.h
dnl ===================================================================
AH_VERBATIM([BINARY128_MODE_CONSTANTS],
[/* Binary128 type mode constants */
#define MPLAPACK_BINARY128_MODE_DISABLED  0
#define MPLAPACK_BINARY128_MODE_LDBL      1
#define MPLAPACK_BINARY128_MODE_FLOAT128  2
#define MPLAPACK_BINARY128_MODE_QUADMATH  3

/* Binary128 I/O mode constants */
#define MPLAPACK_BINARY128_IO_NONE              0
#define MPLAPACK_BINARY128_IO_SNPRINTF_LDBL     1
#define MPLAPACK_BINARY128_IO_STRFROMF128       2
#define MPLAPACK_BINARY128_IO_QUADMATH_SNPRINTF 3

/* Binary128 math function mode constants */
#define MPLAPACK_BINARY128_MATH_NONE     0
#define MPLAPACK_BINARY128_MATH_LDBL     1
#define MPLAPACK_BINARY128_MATH_F128     2
#define MPLAPACK_BINARY128_MATH_QUADMATH 3
])

dnl ===================================================================
dnl Public header substitutions
dnl ===================================================================
AC_SUBST([MPLAPACK_BINARY128_MODE_VALUE], [$mplapack_binary128_mode])
AC_SUBST([MPLAPACK_BINARY128_IO_VALUE], [$mplapack_binary128_io])
AC_SUBST([MPLAPACK_BINARY128_MATH_VALUE], [$mplapack_binary128_math])

dnl ===================================================================
dnl Automake conditionals
dnl ===================================================================
AM_CONDITIONAL(ENABLE_BINARY128, test x$enable_binary128 = xyes)
AM_CONDITIONAL([ENABLE_OPENCL_BINARY128], [test "x$have_opencl" = xyes && test x$enable_binary128 = xyes])
AM_CONDITIONAL(BINARY128_USE_QUADMATH, test "$mplapack_binary128_mode" = "3")
AM_CONDITIONAL(BINARY128_USE_FLOAT128, test "$mplapack_binary128_mode" = "2")
AM_CONDITIONAL(BINARY128_USE_LDBL,     test "$mplapack_binary128_mode" = "1")

dnl Aliases with MPLAPACK_BINARY128_MODE_ prefix (used in Makefile.am)
AM_CONDITIONAL(MPLAPACK_BINARY128_MODE_QUADMATH, test "$mplapack_binary128_mode" = "3")
AM_CONDITIONAL(MPLAPACK_BINARY128_MODE_FLOAT128, test "$mplapack_binary128_mode" = "2")
AM_CONDITIONAL(MPLAPACK_BINARY128_MODE_LDBL,     test "$mplapack_binary128_mode" = "1")

dnl =========================================================================
dnl MPLAPACK 2.1.0 - Binary80 Support Detection
dnl =========================================================================
dnl
dnl Detection is organized into 4 independent phases:
dnl   Phase 1: Type availability (long double, _Float64x, __float80)
dnl   Phase 2: I/O functions (strfromf64x, snprintf %Lg)
dnl   Phase 3: Math functions (sqrtl, sqrtf64x, ...)
dnl   Phase 4: Literal suffix (L, f64x) [optional]
dnl
dnl Then we determine the best combination to use.
dnl =========================================================================

AC_ARG_ENABLE(binary80,
AS_HELP_STRING([--enable-binary80], [Enable binary80 (80-bit IEEE extended) version]),
[case "${enableval}" in
    yes) enable_binary80=yes ;;
    no)  enable_binary80=no  ;;
    *) AC_MSG_ERROR(bad value ${enableval} for --enable-binary80) ;;
esac],[enable_binary80=no])

dnl Initialize all detection flags
mplapack_binary80_mode=0
mplapack_binary80_io=0
mplapack_binary80_math=0

have__Float64x=no
have___float80=no
longdouble_is_binary80=no
_Float64x_is_binary80=no
_Float64x_is_longdouble=no
float80_types_same=no
float80_implicit_gnu_to_std=no
float80_implicit_std_to_gnu=no

if test x$enable_binary80 = x"yes"; then

    dnl ===================================================================
    dnl Phase 1: Type Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary80 type support])

    dnl Check _Float64x
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main(void) {
                _Float64x a, b, c;
                b = 1.0;
                c = 3.0;
                a = b / c;
                (void)a;
                return 0;
            }
        ]])
    ], [have__Float64x=yes], [])

    dnl Check __float80 (GCC extension on some x86 targets)
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main(void) {
                __float80 a, b, c;
                b = 1.0;
                c = 3.0;
                a = b / c;
                (void)a;
                return 0;
            }
        ]])
    ], [have___float80=yes], [])

    dnl Check if long double is binary80 (mantissa=64, max exp=16384)
    AC_COMPILE_IFELSE([
        AC_LANG_SOURCE([[
            int main(void) {
            #if (__LDBL_MANT_DIG__ == 64) && (__LDBL_MAX_EXP__ == 16384)
                return 0;
            #else
            # error "long double is not binary80"
            #endif
            }
        ]])
    ], [longdouble_is_binary80=yes], [])

    dnl Check if _Float64x is binary80 (mantissa=64, max exp=16384)
    if test "x$have__Float64x" = "xyes"; then
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                int main(void) {
                #if defined(__FLT64X_MANT_DIG__) && defined(__FLT64X_MAX_EXP__)
                #if (__FLT64X_MANT_DIG__ == 64) && (__FLT64X_MAX_EXP__ == 16384)
                    return 0;
                #else
                # error "_Float64x is not binary80"
                #endif
                #else
                # error "Missing __FLT64X_* macros"
                #endif
                }
            ]])
        ], [_Float64x_is_binary80=yes], [])
    fi

    dnl Check if _Float64x == long double (C++)
    if test "x$have__Float64x" = "xyes"; then
        AC_LANG_PUSH([C++])
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_same<_Float64x, long double>::value, "not same");
                    return 0;
                }
            ]])
        ], [_Float64x_is_longdouble=yes], [_Float64x_is_longdouble=no])
        AC_LANG_POP([C++])
    fi

    dnl Check convertibility between __float80 (GNU) and _Float64x (C++)
    if test "x$have__Float64x" = "xyes" && test "x$have___float80" = "xyes"; then
        AC_LANG_PUSH([C++])

        dnl Same type?
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_same<_Float64x, __float80>::value, "not same");
                    return 0;
                }
            ]])
        ], [float80_types_same=yes], [float80_types_same=no])

        dnl Implicitly convertible? (__float80 -> _Float64x)
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_convertible<__float80, _Float64x>::value,
                                  "not convertible gnu_f80 -> std_f64x");
                    return 0;
                }
            ]])
        ], [float80_implicit_gnu_to_std=yes], [float80_implicit_gnu_to_std=no])

        dnl Implicitly convertible? (_Float64x -> __float80)
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                #include <type_traits>
                int main() {
                    static_assert(std::is_convertible<_Float64x, __float80>::value,
                                  "not convertible std_f64x -> gnu_f80");
                    return 0;
                }
            ]])
        ], [float80_implicit_std_to_gnu=yes], [float80_implicit_std_to_gnu=no])

        AC_LANG_POP([C++])
    fi

    AC_MSG_RESULT([_Float64x=$have__Float64x (_binary80=$_Float64x_is_binary80, is_ldbl=$_Float64x_is_longdouble), __float80=$have___float80 (same_types=$float80_types_same, implicit_gnu_to_std=$float80_implicit_gnu_to_std, implicit_std_to_gnu=$float80_implicit_std_to_gnu), ldbl_binary80=$longdouble_is_binary80])

    dnl ===================================================================
    dnl Phase 2: I/O Function Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary80 I/O functions])

    have_strfromf64x=no
    have_snprintf_Lg=no

    dnl Check strfromf64x (TS 18661-3, typically glibc)
    if test "x$have__Float64x" = "xyes" && test "x$_Float64x_is_binary80" = "xyes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #define __STDC_WANT_IEC_60559_TYPES_EXT__ 1
                #define __STDC_WANT_IEC_60559_FUNCS_EXT__ 1
                #include <stdlib.h>
                int main(void) {
                    _Float64x a = 1.0;
                    char buf[128];
                    strfromf64x(buf, sizeof(buf), "%.40g", a);
                    return 0;
                }
            ]])
        ], [have_strfromf64x=yes], [])
    fi

    dnl Check snprintf %Lg (for long double binary80)
    if test "x$longdouble_is_binary80" = "xyes"; then
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <stdio.h>
                int main(void) {
                    long double a = 1.0L;
                    char buf[128];
                    snprintf(buf, sizeof(buf), "%.40Lg", a);
                    return 0;
                }
            ]])
        ], [have_snprintf_Lg=yes], [])
    fi

    AC_MSG_RESULT([strfromf64x=$have_strfromf64x, snprintf_Lg=$have_snprintf_Lg])

    dnl ===================================================================
    dnl Phase 3: Math Function Detection
    dnl ===================================================================
    AC_MSG_CHECKING([for binary80 math functions])

    have_f64x_math=no
    have_ldbl_math=no

    dnl Check _Float64x math (sqrtf64x, expf64x, logf64x, ...)
    if test "x$have__Float64x" = "xyes" && test "x$_Float64x_is_binary80" = "xyes"; then
        save_LIBS="$LIBS"
        LIBS="$LIBS -lm"
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #define __STDC_WANT_IEC_60559_TYPES_EXT__ 1
                #define __STDC_WANT_IEC_60559_FUNCS_EXT__ 1
                #include <math.h>
                int main(void) {
                    _Float64x x = 2.0;
                    _Float64x a = sqrtf64x(x);
                    _Float64x b = expf64x(x);
                    _Float64x c = logf64x(x);
                    _Float64x d = sinf64x(x);
                    _Float64x e = cosf64x(x);
                    (void)a; (void)b; (void)c; (void)d; (void)e;
                    return 0;
                }
            ]])
        ], [have_f64x_math=yes], [])
        LIBS="$save_LIBS"
    fi

    dnl Check long double math (sqrtl, expl, logl, ...)
    if test "x$longdouble_is_binary80" = "xyes"; then
        save_LIBS="$LIBS"
        LIBS="$LIBS -lm"
        AC_LINK_IFELSE([
            AC_LANG_SOURCE([[
                #include <math.h>
                int main(void) {
                    long double x = 2.0L;
                    long double a = sqrtl(x);
                    long double b = expl(x);
                    long double c = logl(x);
                    long double d = sinl(x);
                    long double e = cosl(x);
                    (void)a; (void)b; (void)c; (void)d; (void)e;
                    return 0;
                }
            ]])
        ], [have_ldbl_math=yes], [])
        LIBS="$save_LIBS"
    fi

    AC_MSG_RESULT([f64x_math=$have_f64x_math, ldbl_math=$have_ldbl_math])

    dnl ===================================================================
    dnl Phase 4: Literal Suffix Detection (optional)
    dnl ===================================================================
    AC_MSG_CHECKING([for binary80 literal suffix])

    have_suffix_L_binary80=no
    have_suffix_f64x=no

    dnl L suffix produces binary80 (when long double is binary80)
    if test "x$longdouble_is_binary80" = "xyes"; then
        have_suffix_L_binary80=yes
    fi

    dnl Check f64x suffix (GCC/Clang with TS literal suffix support)
    if test "x$have__Float64x" = "xyes"; then
        AC_COMPILE_IFELSE([
            AC_LANG_SOURCE([[
                int main(void) {
                    _Float64x a = 3.14159265358979323846264338327950288f64x;
                    (void)a;
                    return 0;
                }
            ]])
        ], [have_suffix_f64x=yes], [])
    fi

    AC_MSG_RESULT([L_binary80=$have_suffix_L_binary80, f64x=$have_suffix_f64x])

    dnl ===================================================================
    dnl Phase 5: Determine Best Configuration
    dnl ===================================================================
    AC_MSG_CHECKING([binary80 configuration])

    dnl For each selected type, we need:
    dnl   - A working I/O method
    dnl   - Working math functions

    binary80_configured=no

    dnl Priority: _Float64x (binary80) > long double (binary80)
    if test "x$have__Float64x" = "xyes" && \
       test "x$_Float64x_is_binary80" = "xyes" && \
       test "x$have_strfromf64x" = "xyes" && \
       test "x$have_f64x_math" = "xyes"; then

        mplapack_binary80_mode=2   # FLOAT64X
        mplapack_binary80_io=2     # STRFROMF64X
        mplapack_binary80_math=2   # F64X
        binary80_configured=yes
        AC_MSG_RESULT([_Float64x (binary80)])
    fi

    if test "x$binary80_configured" = "xno" && \
       test "x$longdouble_is_binary80" = "xyes" && \
       test "x$have_snprintf_Lg" = "xyes" && \
       test "x$have_ldbl_math" = "xyes"; then

        mplapack_binary80_mode=1   # LDBL80
        mplapack_binary80_io=1     # SNPRINTF_LDBL
        mplapack_binary80_math=1   # LDBL
        binary80_configured=yes
        AC_MSG_RESULT([long double (binary80)])
    fi

    if test "x$binary80_configured" = "xno"; then
        AC_MSG_ERROR([binary80 is not supported on this system])
    fi
fi

dnl Check whether std::abs() exists for _Float64x in the selected C++ mode.
dnl Keep this separate from the other std::_Float64x math functions, mirroring
dnl the binary128 split: abs has its own overload set and library exposure
dnl history.
AC_LANG_PUSH([C++])
mplapack_have_std_abs_float64x=no
AS_IF([test "x$mplapack_binary80_mode" = "x2"], [
  AC_MSG_CHECKING([for std::abs(_Float64x)])
  AC_COMPILE_IFELSE(
    [AC_LANG_SOURCE([[
#include <cmath>
int main() {
  auto p = static_cast<_Float64x (*)(_Float64x)>(&std::abs);
  (void)p;
  return 0;
}
]])],
    [mplapack_have_std_abs_float64x=yes],
    [mplapack_have_std_abs_float64x=no])
  AC_MSG_RESULT([$mplapack_have_std_abs_float64x])
], [
  AC_MSG_CHECKING([for std::abs(_Float64x)])
  AC_MSG_RESULT([no])
])
AS_IF([test "x$mplapack_have_std_abs_float64x" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_STD_ABS_FLOAT64X],[1],
    [Define to 1 if std::abs() is available for _Float64x])],
  [AC_DEFINE([MPLAPACK_HAVE_STD_ABS_FLOAT64X],[0],
    [Define to 0 if std::abs() is not available for _Float64x])]
)
AC_LANG_POP([C++])

dnl Check whether std::* math overloads exist for _Float64x.  If they do, the
dnl header should expose those overloads rather than defining global wrappers
dnl with the same signatures.
AC_LANG_PUSH([C++])
mplapack_have_std_math_float64x=no
AS_IF([test "x$mplapack_binary80_mode" = "x2"], [
  AC_MSG_CHECKING([for std::_Float64x math functions])
  AC_COMPILE_IFELSE(
    [AC_LANG_SOURCE([[
#include <cmath>
#include <type_traits>
int main() {
  _Float64x x = (_Float64x)1.0;
  _Float64x y = (_Float64x)2.0;
  static_assert(std::is_same<decltype(std::sin(x)), _Float64x>::value, "std::sin(_Float64x)");
  static_assert(std::is_same<decltype(std::sinh(x)), _Float64x>::value, "std::sinh(_Float64x)");
  static_assert(std::is_same<decltype(std::cos(x)), _Float64x>::value, "std::cos(_Float64x)");
  static_assert(std::is_same<decltype(std::cosh(x)), _Float64x>::value, "std::cosh(_Float64x)");
  static_assert(std::is_same<decltype(std::atan2(x, y)), _Float64x>::value, "std::atan2(_Float64x)");
  static_assert(std::is_same<decltype(std::exp(x)), _Float64x>::value, "std::exp(_Float64x)");
  static_assert(std::is_same<decltype(std::floor(x)), _Float64x>::value, "std::floor(_Float64x)");
  static_assert(std::is_same<decltype(std::log(x)), _Float64x>::value, "std::log(_Float64x)");
  static_assert(std::is_same<decltype(std::log10(x)), _Float64x>::value, "std::log10(_Float64x)");
  static_assert(std::is_same<decltype(std::log2(x)), _Float64x>::value, "std::log2(_Float64x)");
  static_assert(std::is_same<decltype(std::pow(x, y)), _Float64x>::value, "std::pow(_Float64x)");
  static_assert(std::is_same<decltype(std::sqrt(x)), _Float64x>::value, "std::sqrt(_Float64x)");
  static_assert(std::is_same<decltype(std::nextafter(x, y)), _Float64x>::value, "std::nextafter(_Float64x)");
  static_assert(std::is_same<decltype(std::ldexp(x, 1)), _Float64x>::value, "std::ldexp(_Float64x)");
  return 0;
}
]])],
    [mplapack_have_std_math_float64x=yes],
    [mplapack_have_std_math_float64x=no])
  AC_MSG_RESULT([$mplapack_have_std_math_float64x])
], [
  AC_MSG_CHECKING([for std::_Float64x math functions])
  AC_MSG_RESULT([no])
])
AS_IF([test "x$mplapack_have_std_math_float64x" = "xyes"],
  [AC_DEFINE([MPLAPACK_HAVE_STD_MATH_FLOAT64X],[1],
    [Define to 1 if std::_Float64x scalar math functions are available])],
  [AC_DEFINE([MPLAPACK_HAVE_STD_MATH_FLOAT64X],[0],
    [Define to 0 if std::_Float64x scalar math functions are not available])]
)
AC_LANG_POP([C++])

dnl ===================================================================
dnl Define macros for config.h (type availability / relationships)
dnl ===================================================================
mplapack_has__Float64x_type=0
mplapack_has___float80_type=0
mplapack_ldbl_is_binary80=0
mplapack_float64x_is_binary80=0
mplapack__Float64x_is_long_double=0
