    elif test "x$float128_implicit_gnu_to_std" = "xyes"; then
        FLOAT128_INTEROP_STD_GNU="implicit conversion (__float128 -> _Float128 only)"
    elif test "x$float128_implicit_std_to_gnu" = "xyes"; then
